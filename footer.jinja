            </div>
	            <div class="flex flex-col items-start gap-0.5">
              <span class="text-[9px]" style="color: {{ text_color }};">{{ _('Tax number') }}</span>
              {% if store.settings.general.tax_settings.tax_number %}
                <span class="text-[11px] font-bold" style="color: {{ heading_color }};">{{ store.settings.general.tax_settings.tax_number }}</span>
              {% endif %}
            </div>
          </a>
        {% endif %}
      </div>

      {# Payment Methods #}
		      <div class="order-2 md:order-1 flex flex-wrap overflow-hidden justify-center md:justify-start items-center gap-2">
		        {% for payment_method in store.settings.checkout.payment_methods %}
		          <a href="/shipping-and-payment" class="footer-payment-item flex items-center justify-center bg-white rounded-[4px] px-1.5 md:px-2">
		            <img src="{{ image_url(payment_method.icon, w=92, h=40, q=100, f='auto') }}" alt="{{ payment_method.name }}" width="46" height="20" loading="lazy" decoding="async" class="max-h-7 max-w-full object-contain" />
		          </a>
		        {% endfor %}
		        {% for shipping_method in store.settings.checkout.shipping_methods %}
		          <a href="/shipping-and-payment" class="footer-payment-item flex items-center justify-center bg-white rounded-[4px] px-1.5 md:px-2">
		            <img src="{{ image_url(shipping_method.icon, w=92, h=40, q=100, f='auto') }}" alt="{{ shipping_method.name }}" width="46" height="20" loading="lazy" decoding="async" class="max-h-7 max-w-full object-contain" />
		          </a>
	        {% endfor %}
	      </div>

    </div>
  {% endif %}

  {# ── Divider ───────────────────────────────────────────────────────────── #}
	  <div class="w-full" style="border-top: 1px solid {{ divider_color }};"></div>

  {# ── Bottom bar ────────────────────────────────────────────────────────── #}
	  <div class="py-4 px-4 flex flex-col md:grid md:grid-cols-3 items-center gap-4 md:gap-0 w-full ">

    {% if settings.bottom_bar_show_language_selector != false %}
      <button
        type="button"
        onclick="return window.openAnanasRegionSettings(event)"
	        class="flex items-center gap-2 text-xs transition-opacity hover:opacity-100 md:justify-self-start"
        style="color: {{ text_color }}; opacity: 0.8;"
      >
       <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7.5 13.125C10.1204 13.125 12.3222 11.3333 12.9473 8.90809M7.5 13.125C4.87964 13.125 2.67776 11.3333 2.05269 8.90809M7.5 13.125C9.0533 13.125 10.3125 10.6066 10.3125 7.5C10.3125 4.3934 9.0533 1.875 7.5 1.875M7.5 13.125C5.9467 13.125 4.6875 10.6066 4.6875 7.5C4.6875 4.3934 5.9467 1.875 7.5 1.875M12.9473 8.90809C13.0633 8.45807 13.125 7.98624 13.125 7.5C13.125 6.49664 12.8623 5.55464 12.4019 4.73903C11.4369 3.02934 9.60324 1.875 7.5 1.875M2.05269 8.90809C1.9367 8.45807 1.875 7.98624 1.875 7.5C1.875 6.49664 2.1377 5.55464 2.59808 4.73903C3.56312 3.02934 5.39676 1.875 7.5 1.875M12.4019 4.73903C11.0873 5.87524 9.37392 6.5625 7.5 6.5625C5.62608 6.5625 3.91267 5.87524 2.59808 4.73903M12.9473 8.90809C11.3334 9.80296 9.47618 10.3125 7.5 10.3125C5.52382 10.3125 3.66664 9.80296 2.05269 8.90809" stroke="white" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>

	        {% set footer_country_code = store.current_country.code if store.current_country and store.current_country.code else (session.country.code if session.country and session.country.code else '') %}
	        {% if footer_country_code %}
	          <span>{{ footer_country_code | title }}</span>
	        {% endif %}
	        {% if store.languages | length > 1 %}
	          {% for lang in store.languages %}
	            {% if lang.iso_code == session.lang %}
	              <span class="h-5 w-px" style="background-color: {{ divider_color }};"></span>
	              <span>{{ lang.name }}</span>
	            {% endif %}
	          {% endfor %}
        {% endif %}
      </button>
    {% else %}
      <span></span>
    {% endif %}

	    <p class="text-xs font-medium leading-[17px] text-center md:col-start-2 md:justify-self-center" style="color: {{ copy_color }};">
      {% if settings.bottom_bar_copyright_text %}
        {{ settings.bottom_bar_copyright_text }}
      {% elif store.settings.branding.copyrights %}
        {{ store.settings.branding.copyrights | safe }}
      {% else %}
        {{ _('Made by Zid') }}
      {% endif %}
    </p>

  </div>

</footer>
