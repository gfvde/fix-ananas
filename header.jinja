{% set s_link_color       = settings.style_link_color       | default('#ffffff') %}
{% set s_icon_color       = settings.style_icon_color       | default('#ffffff') %}
{% set s_icon_color_mobile = settings.style_icon_color_mobile | default(s_icon_color) %}
{% set s_badge_color      = settings.style_cart_badge_color | default('#25A562') %}
{% set s_dd_bg            = settings.style_dropdown_bg      | default('#111111') %}
{% set s_dd_border        = settings.style_dropdown_border  | default('#333333') %}
{% set s_mega_bg          = settings.style_mega_bg          | default('#000000') %}
{% set s_mega_link        = settings.style_mega_link_color  | default('#ffffff') %}
{% set s_mega_head        = settings.style_mega_col_head_color | default('#d4d4d4') %}
{# Search: specific search settings override the style-group fallbacks #}
{% set s_search_bg        = settings.nav_search_bg_color      | default(settings.style_search_bg)        | default('#000000') %}
