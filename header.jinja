(function () {
  'use strict';

  /* ── Helpers ── */
  function qs(sel, ctx) { return (ctx || document).querySelector(sel); }

  var backdrop      = qs('#ananas-backdrop');
  var searchPanel   = qs('#nav-search-panel');
  var searchBtn     = qs('#nav-search-btn');
  var searchBtnMob  = qs('#nav-search-btn-mob');
  var searchClose   = qs('#nav-search-close');
  var searchInput   = qs('#nav-search-input');
  var searchPopular = qs('#search-popular');

  /* Mobile search icon swap helpers */
  var mobSearchIcon = searchBtnMob ? qs('.mob-search-icon', searchBtnMob) : null;
  var mobCloseIcon  = searchBtnMob ? qs('.mob-close-icon',  searchBtnMob) : null;
  function setMobSearchState(open) {
    if (!searchBtnMob) return;
    searchBtnMob.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (mobSearchIcon) mobSearchIcon.hidden =  open;
    if (mobCloseIcon)  mobCloseIcon.hidden  = !open;
  }

  /* ── Collect all triggers / panels ── */
  var megaTriggers = document.querySelectorAll('[data-mega-trigger]');
  var subTriggers  = document.querySelectorAll('[data-sub-trigger]');

  /* Remove inline display:none added to prevent flash before JS loads */
  document.querySelectorAll('[data-mega-panel]').forEach(function(p) { p.style.display = ''; });
  if (searchPanel) searchPanel.style.display = '';

  /* ────────────────────────────────────────────────
     Close everything
  ──────────────────────────────────────────────── */
  function closeAll() {
    megaTriggers.forEach(function (btn) {
      btn.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      var panel = qs('#mega-' + btn.dataset.megaTrigger);
      if (panel) { panel.classList.remove('is-open'); panel.setAttribute('aria-hidden', 'true'); }
    });
    subTriggers.forEach(function (btn) {
      btn.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      var panel = qs('#sub-' + btn.dataset.subTrigger);
      if (panel) { panel.classList.remove('is-open'); }
    });
    if (searchPanel) {
      searchPanel.classList.remove('is-open');
      searchPanel.setAttribute('aria-hidden', 'true');
    }
    if (searchBtn) searchBtn.setAttribute('aria-expanded', 'false');
    setMobSearchState(false);
    backdrop.classList.remove('is-active');
  }

  /* ── Mega triggers ── */
  megaTriggers.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var idx   = btn.dataset.megaTrigger;
      var panel = qs('#mega-' + idx);
      var open  = panel && panel.classList.contains('is-open');
      closeAll();
      if (!open && panel) {
        btn.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        panel.classList.add('is-open');
        panel.setAttribute('aria-hidden', 'false');
        backdrop.classList.add('is-active');
      }
    });
  });

  /* ── Simple sub-dropdown triggers: open on hover, navigate on click ── */
  subTriggers.forEach(function (btn) {
    var idx   = btn.dataset.subTrigger;
    var panel = qs('#sub-' + idx);
    var wrap  = btn.closest('.ananas-nav__sub-wrap');
    var leaveTimer = null;

    function openSub() {
      if (leaveTimer) { clearTimeout(leaveTimer); leaveTimer = null; }
      closeAll();
      btn.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      if (panel) panel.classList.add('is-open');
    }

    function scheduleSub() {
      if (leaveTimer) { clearTimeout(leaveTimer); leaveTimer = null; }
      leaveTimer = setTimeout(function () {
        btn.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        if (panel) panel.classList.remove('is-open');
      }, 120);
    }

    if (wrap) {
      wrap.addEventListener('mouseenter', openSub);
      wrap.addEventListener('mouseleave', scheduleSub);
    } else {
      btn.addEventListener('mouseenter', openSub);
      btn.addEventListener('mouseleave', scheduleSub);
      if (panel) {
        panel.addEventListener('mouseenter', function () {
          if (leaveTimer) { clearTimeout(leaveTimer); leaveTimer = null; }
        });
        panel.addEventListener('mouseleave', scheduleSub);
      }
    }
  });

  /* ── Sub-dropdown scroll arrows ── */
  document.querySelectorAll('[data-sub-prev]').forEach(function(btn) {
    var idx = btn.dataset.subPrev;
    var list = document.querySelector('[data-sub-list="' + idx + '"]');
    var nextBtn = document.querySelector('[data-sub-next="' + idx + '"]');
    var prevBtn = btn;
    if (!list) return;

    function updateArrows() {
      var atTop = list.scrollTop <= 0;
      var atBottom = list.scrollTop + list.clientHeight >= list.scrollHeight - 2;
      prevBtn.style.background = atTop ? 'rgba(248,95,59,0.32)' : '#f85f3b';
      nextBtn.style.background = atBottom ? 'rgba(248,95,59,0.32)' : '#f85f3b';
    }

    btn.addEventListener('click', function(e) {
      e.preventDefault(); e.stopPropagation();
      list.scrollBy({ top: -80, behavior: 'smooth' });
    });

    nextBtn && nextBtn.addEventListener('click', function(e) {
      e.preventDefault(); e.stopPropagation();
      list.scrollBy({ top: 80, behavior: 'smooth' });
    });

    list.addEventListener('scroll', updateArrows, { passive: true });
    setTimeout(updateArrows, 100);
  });

  /* ── Search toggle ── */
  if (searchBtn) {
    searchBtn.addEventListener('click', function () {
      var open = searchPanel && searchPanel.classList.contains('is-open');
      closeAll();
      if (!open) {
        searchPanel.classList.add('is-open');
        searchPanel.setAttribute('aria-hidden', 'false');
        searchBtn.setAttribute('aria-expanded', 'true');
        backdrop.classList.add('is-active');
        setTimeout(function () { if (searchInput) searchInput.focus(); }, 160);
      }
    });
  }
  /* Mobile search button */
  if (searchBtnMob) {
    searchBtnMob.addEventListener('click', function () {
      var open = searchPanel && searchPanel.classList.contains('is-open');
      closeAll();
      if (!open) {
        searchPanel.classList.add('is-open');
        searchPanel.setAttribute('aria-hidden', 'false');
        setMobSearchState(true);
        backdrop.classList.add('is-active');
        setTimeout(function () { if (searchInput) searchInput.focus(); }, 160);
      }
    });
  }

  if (searchClose) searchClose.addEventListener('click', closeAll);
  backdrop.addEventListener('click', closeAll);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });

  /* AUTH STATE: handled by assets/js/features/layout.js (handleLoginAction,
     vitrin:auth:success, zid-customer-fetched, customerAuthState). */

  /* ────────────────────────────────────────────────
     CART BADGE
  ──────────────────────────────────────────────── */
  var cartBadges = document.querySelectorAll('[data-cart-badge]');
  function updateCartBadge(count) {
    cartBadges.forEach(function (badge) {
      if (count > 0) {
        badge.textContent = count > 99 ? '99+' : count;
        badge.removeAttribute('hidden');
      } else {
        badge.setAttribute('hidden', '');
      }
    });
  }

  document.addEventListener('zid:cart:updated', function (e) {
    var count = e.detail && e.detail.items_count != null ? e.detail.items_count : 0;
    updateCartBadge(count);
  });

  /* Fetch cart count on load */
  if (window.zid && window.zid.cart) {
    window.zid.cart.get()
      .then(function (d) {
        var count = d && (d.cart_items_quantity ?? d.products_count ?? d.items_count ?? 0);
        if (count) updateCartBadge(count);
      })
      .catch(function () {});
  }

  /* ────────────────────────────────────────────────
     SEARCH PRODUCTS
  ──────────────────────────────────────────────── */
  var track     = qs('#search-track');
  var initialSearchTrackHTML = track ? track.innerHTML : '';

  /* SAR icon SVG (Arabic Riyal symbol) */
  var sarSvg = '<svg class="ananas-pcard__sar" viewBox="0 0 14 16" fill="none" xmlns="http://www.w3.org/2000/svg">' +
      '<path d="M0 12.1v-1.6l5.2-2V7L0 8.9V7.3l5.2-2V3.5H6.8v1.3L14 2v1.6L6.8 6.5v1.5L14 5.1v1.6l-7.2 2.9v1L14 7.7v1.6l-7.2 2.9v1.9H5.2v-1.4L0 14v-1.9z" fill="white"/>' +
    '</svg>';
  var searchCartIconSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">' +
      '<path d="M16.7505 4.24995L0.751039 4.24972L0.75 4.25M16.7505 4.24995L16.75 15.3467C16.75 16.3978 15.8817 17.25 14.8106 17.25H2.68939C1.6183 17.25 0.75 16.3978 0.75 15.3467V4.25M16.7505 4.24995L13.5429 1.04289C13.3554 0.855357 13.101 0.75 12.8358 0.75H4.66421C4.399 0.75 4.14464 0.855357 3.95711 1.04289L0.75 4.25M11.75 7.25C11.75 8.90686 10.4069 10.25 8.75 10.25C7.09315 10.25 5.75 8.90686 5.75 7.25" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>' +
    '</svg>';

  function escapeHtml(value) {
    return String(value || '').replace(/[&<>"']/g, function (char) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
    });
  }

  function searchProductImage(p) {
    return (
      (p.featured_image && (p.featured_image.url || p.featured_image.src)) ||
      (p.image && (p.image.url || p.image.src || p.image.medium || p.image.full_size)) ||
      (p.images && p.images[0] && (p.images[0].url || p.images[0].src || (p.images[0].image && (p.images[0].image.medium || p.images[0].image.full_size || p.images[0].image.url)))) ||
      ''
    );
  }

  function searchProductPrice(p) {
    if (p.formatted_sale_price) return p.formatted_sale_price;
    if (p.formatted_price) return p.formatted_price;
    if (p.price_string) return p.price_string;
    if (p.price_formatted) return p.price_formatted;
    if (p.price) {
      var amount = Number(p.price);
      if (amount > 9999) amount = amount / 100;
      return sarSvg + amount.toFixed(2);
    }
    return '';
  }

  function createSearchCard(p) {
    var url   = p.url || p.html_url || (p.handle ? '/products/' + p.handle : '#');
    var img   = searchProductImage(p);
    var name  = escapeHtml(p.title || p.name || '');
    var price = searchProductPrice(p);
    var id    = p.id || p.product_id || '';

    var card = document.createElement('div');
    card.className = 'ananas-pcard';
    card.setAttribute('data-search-product-card', '');

    var imageWrap = document.createElement('div');
    imageWrap.className = 'ananas-pcard__img-wrap';
    var imageLink = document.createElement('a');
    imageLink.className = 'ananas-pcard__link';
    imageLink.href = url;
    imageLink.tabIndex = -1;
    imageLink.setAttribute('aria-hidden', 'true');
    if (img) {
      var image = document.createElement('img');
      image.src = img;
      image.alt = name;
      image.className = 'ananas-pcard__img';
      image.loading = 'lazy';
      imageLink.appendChild(image);
    }
    imageWrap.appendChild(imageLink);

    var body = document.createElement('div');
    body.className = 'ananas-pcard__body';
    var info = document.createElement('div');
    info.className = 'ananas-pcard__info';
    var title = document.createElement('a');
    title.className = 'ananas-pcard__name';
    title.href = url;
    title.innerHTML = name;
    info.appendChild(title);
    if (price) {
      var priceNode = document.createElement('div');
      priceNode.className = 'ananas-pcard__price';
      priceNode.innerHTML = price;
      info.appendChild(priceNode);
    }

    var actions = document.createElement('div');
    actions.className = 'ananas-pcard__actions';
    var wishButton = document.createElement('button');
    wishButton.className = 'ananas-pcard__btn ananas-pcard__btn--wishlist';
    wishButton.type = 'button';
    wishButton.setAttribute('data-wishlist-btn', '');
    wishButton.setAttribute('data-product-id', id);
    wishButton.setAttribute('aria-label', 'wishlist');
    wishButton.innerHTML = '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 17.5S2.5 13 2.5 7.5A3.75 3.75 0 0 1 10 5.26 3.75 3.75 0 0 1 17.5 7.5C17.5 13 10 17.5 10 17.5Z" stroke="white" stroke-width="1.3"/></svg>';

    var cartButton = document.createElement('button');
    cartButton.className = 'ananas-pcard__btn ananas-pcard__btn--cart';
    cartButton.type = 'button';
    cartButton.setAttribute('data-add-to-cart', id);
    cartButton.setAttribute('aria-label', 'add to cart');
    cartButton.innerHTML = searchCartIconSvg;

    actions.appendChild(cartButton);
    actions.appendChild(wishButton);
    body.appendChild(info);
    body.appendChild(actions);
    card.appendChild(imageWrap);
    card.appendChild(body);

    return card;
  }

  function renderSearchProducts(items) {
    if (!track) return;
    track.innerHTML = '';
    var fragment = document.createDocumentFragment();
    items.forEach(function (item) {
      fragment.appendChild(createSearchCard(item));
    });
    track.appendChild(fragment);
    currentOffset = 0;
    applySlider();
    if (window.initWishlistButtons) window.initWishlistButtons();
    window.dispatchEvent(new CustomEvent('content:loaded'));
  }
  window.renderSearchProducts = renderSearchProducts;

  /* ────────────────────────────────────────────────
     SLIDER NAVIGATION (1-card-per-click, LTR track)
  ──────────────────────────────────────────────── */
  var currentOffset = 0;
  var CARD_GAP = 14;

  function getPerPage() {
    return window.innerWidth < 768 ? 2 : 4;
  }

  function getCardW() {
    var first = track ? track.querySelector('.ananas-pcard') : null;
    return first ? first.offsetWidth : 163;
  }

  function getMaxOffset() {
    if (!track) return 0;
    var total = track.querySelectorAll('.ananas-pcard').length;
    var pp    = getPerPage();
    return Math.max(0, (total - pp) * (getCardW() + CARD_GAP));
  }

  var isRTLSearch = document.documentElement.dir === 'rtl';

  function applySlider() {
    if (!track) return;
    var total     = track.querySelectorAll('.ananas-pcard').length;
    var pp        = getPerPage();
    var maxOffset = getMaxOffset();

    if (currentOffset < 0)         currentOffset = 0;
    if (currentOffset > maxOffset) currentOffset = maxOffset;

    var tx = isRTLSearch ? currentOffset : -currentOffset;
    track.style.transform = 'translateX(' + tx + 'px)';

    var prevArrow = qs('#search-slider-prev');
    var nextArrow = qs('#search-slider-next');
    var hasMore   = total > pp;

    if (prevArrow) prevArrow.hidden = !hasMore || currentOffset <= 0;
    if (nextArrow) nextArrow.hidden = !hasMore || currentOffset >= maxOffset;
  }

  function updateSearchSliderArrow() { applySlider(); }

  /* Start at offset 0 — first cards visible */
  currentOffset = 0;
  applySlider();

  var sliderPrevArrow = qs('#search-slider-prev');
  if (sliderPrevArrow && track) {
    sliderPrevArrow.addEventListener('click', function () {
      currentOffset = Math.max(0, currentOffset - (getCardW() + CARD_GAP));
      applySlider();
    });
  }

  var sliderNextArrow = qs('#search-slider-next');
  if (sliderNextArrow && track) {
    sliderNextArrow.addEventListener('click', function () {
      currentOffset = Math.min(getMaxOffset(), currentOffset + (getCardW() + CARD_GAP));
      applySlider();
    });
  }

  window.addEventListener('resize', function () {
    currentOffset = 0;
    applySlider();
  });

  /* ────────────────────────────────────────────────
     LIVE SEARCH
  ──────────────────────────────────────────────── */
  var searchTimer;
  if (searchInput) {
    searchInput.addEventListener('input', function () {
      clearTimeout(searchTimer);
      var q = this.value.trim();

      /* Show popular back when input cleared */
      if (!q) {
        if (track) {
          track.innerHTML = window.featuredSearchHTML || initialSearchTrackHTML;
          currentOffset = 0;
          applySlider();
          if (window.initWishlistButtons) window.initWishlistButtons();
        }
        if (searchPopular) searchPopular.style.display = '';
        return;
      }

      if (searchPopular) searchPopular.style.display = 'none';

      searchTimer = setTimeout(function () {
        fetch(
          '/search/suggest.json?q=' + encodeURIComponent(q) +
          '&resources[type]=product&resources[limit]=8'
        )
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var items = (data.resources && data.resources.results && data.resources.results.products) || [];
          if (!track) return;
          if (!items.length) {
            var emptyMessage = document.createElement('p');
            emptyMessage.style.cssText = 'color:#a1a1a1;font-family:inherit;font-size:14px;direction:rtl;padding:8px 0;';
            emptyMessage.textContent = '{{ _("No results") }}';
            track.innerHTML = '';
            track.appendChild(emptyMessage);
            updateSearchSliderArrow();
            return;
          }
          renderSearchProducts(items);
          updateSearchSliderArrow();
          if (window.initWishlistButtons) window.initWishlistButtons();
        })
        .catch(function () {});
      }, 280);
    });
  }

  /* Cart buttons handled by add-to-cart.js via content:loaded event */

})();
</script>
