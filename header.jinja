{% set s_search_input     = settings.nav_search_text_color    | default(settings.style_search_input_color) | default('#a1a1a1') %}
{% set s_search_results   = settings.nav_search_results_text_color | default('#ffffff') %}
{% set s_search_card_border = settings.nav_search_card_border_color | default('#3f3f46') %}

<script>
  (function () {
    var REGION_DIALOG_KEY = 'region_settings_dialog';
    var KIT_URL = 'https://static.zid.store/sdk/v2.10.7/kit/vitrin-kit.es.js';

    function getDialogHost() {
      var host = document.querySelector('[data-ananas-region-dialog-host]');
      if (!host) {
        host = document.createElement('div');
        host.id = 'ananas-region-settings-dialog-host';
        host.setAttribute('data-ananas-region-dialog-host', '');
        document.body.appendChild(host);
      }
      return host;
    }

    function getDialogConfig() {
      var config = Object.assign({}, window.ananasRegionSettingsConfig || {});
      config.custom_styles = window.zidCustomStyles && window.zidCustomStyles.region_settings_dialog
        ? window.zidCustomStyles.region_settings_dialog
        : {};
      return config;
    }

    function getRegionDialogProxy() {
      if (window.region_settings_dialog && typeof window.region_settings_dialog.open === 'function') {
        return window.region_settings_dialog;
      }

      try {
        if (typeof region_settings_dialog !== 'undefined' && region_settings_dialog && typeof region_settings_dialog.open === 'function') {
          return region_settings_dialog;
        }
      } catch (error) {}

      return null;
    }

    function importVitrinKit() {
      window.__ananasVitrinKitPromise = window.__ananasVitrinKitPromise || import(KIT_URL);
      return window.__ananasVitrinKitPromise;
    }

    function waitForInit(initPromise, timeout) {
      return Promise.race([
        initPromise,
        new Promise(function (resolve) {
          window.setTimeout(resolve, timeout || 3000);
        })
      ]);
    }

    function isRegionDialogRegistered(kit) {
      return !!(kit && kit.dialogService && typeof kit.dialogService.getDialog === 'function' && kit.dialogService.getDialog(REGION_DIALOG_KEY));
    }

    function waitForRegionDialog(kit, timeout) {
      if (isRegionDialogRegistered(kit)) {
        return Promise.resolve(true);
      }

      return new Promise(function (resolve) {
        var startedAt = Date.now();
        var timer = window.setInterval(function () {
          if (isRegionDialogRegistered(kit)) {
            window.clearInterval(timer);
            resolve(true);
            return;
          }

          if (Date.now() - startedAt >= (timeout || 3000)) {
            window.clearInterval(timer);
            resolve(false);
          }
        }, 100);
      });
    }

    window.ananasEnsureRegionSettingsDialog = window.ananasEnsureRegionSettingsDialog || function () {
      if (window.__ananasRegionDialogReady && window.__ananasRegionDialogKit) {
        return Promise.resolve(window.__ananasRegionDialogKit);
      }

      if (window.__ananasRegionDialogInitPromise) {
        return window.__ananasRegionDialogInitPromise;
      }

      window.__ananasRegionDialogInitPromise = importVitrinKit().then(function (kit) {
        if (isRegionDialogRegistered(kit)) {
          window.__ananasRegionDialogReady = true;
          window.__ananasRegionDialogKit = kit;
          return kit;
        }

        if (typeof kit.initKit !== 'function') {
          return kit;
        }

        return waitForInit(kit.initKit(REGION_DIALOG_KEY, getDialogHost(), getDialogConfig()), 3000).then(function () {
          return waitForRegionDialog(kit, 3000);
        }).then(function (isReady) {
          if (isReady) {
            window.__ananasRegionDialogReady = true;
            window.__ananasRegionDialogKit = kit;
          } else {
            window.__ananasRegionDialogInitPromise = null;
          }

          return kit;
        });
      }).catch(function (error) {
        window.__ananasRegionDialogInitPromise = null;
        console.warn('Unable to initialize Zid region settings dialog.', error);
        return null;
      });

      return window.__ananasRegionDialogInitPromise;
    };

    window.openAnanasRegionSettings = function (event) {
      if (event && event.preventDefault) event.preventDefault();
      if (event && event.stopPropagation) event.stopPropagation();

      window.ananasEnsureRegionSettingsDialog().then(function (kit) {
        if (isRegionDialogRegistered(kit) && kit.dialogService && typeof kit.dialogService.openDialog === 'function') {
          kit.dialogService.openDialog(REGION_DIALOG_KEY);
          return;
        }

        if (!kit || !kit.dialogService || typeof kit.dialogService.getDialog !== 'function') {
          var dialog = getRegionDialogProxy();
          if (dialog) {
            dialog.open();
            return;
          }
        }

        console.warn('Region settings dialog is not available yet.');
      });

      return false;
    };
  })();
</script>

<div class="sticky top-0 z-50" id="ananas-header" >

  {% include 'components/header-announcement-bar.jinja' %}

  {# Shared: region visibility (used in both desktop + mobile) #}
  {% set show_region = ((store.countries | length > 1) and not settings.header_hide_country) or ((store.languages | length > 1) and not settings.header_hide_language) %}

  {# ── Main Navbar ── #}
  <header class="ananas-nav">

    {# ════════════════════════════════════════════
       DESKTOP NAV INNER  (hidden on mobile)
    ════════════════════════════════════════════ #}
    <div class="ananas-nav__inner ananas-nav__inner--desk">

      {# Logo (rightmost in RTL) #}
      <a href="/" class="ananas-nav__logo" aria-label="{{ store.name }}">
        {% if settings.logo_desktop or settings.logo_mobile %}
          {% if settings.logo_desktop %}
            <img src="{{ image_url(settings.logo_desktop, w=200, q=90, f='auto') }}"
                 style="max-height: {{ s_logo_height }}px;" class="w-auto object-contain" alt="{{ store.name }}" />
          {% elif settings.logo_mobile %}
            <img src="{{ image_url(settings.logo_mobile, w=150, q=90, f='auto') }}"
                 style="max-height: {{ s_logo_height }}px;" class="w-auto object-contain" alt="{{ store.name }}" />
          {% endif %}
        {% elif store.logo %}
          <img src="{{ image_url(store.logo, w=200, q=90, f='auto') }}"
               style="max-height: {{ s_logo_height }}px;" class="w-auto object-contain" alt="{{ store.name }}" />
        {% else %}
          <span class="ananas-nav__logo-text">{{ store.name }}</span>
        {% endif %}
      </a>

      {# Center Nav Links #}
      <nav class="ananas-nav__links" aria-label="{{ _('Main navigation') }}">

        {# ── STATIC MEGA TRIGGER ── #}
        {% if settings.nav_enable_mega_menu != false and settings.nav_mega_mode == 'static' %}
          <button class="ananas-nav__link ananas-nav__link--has-sub"
                  data-mega-trigger="static" aria-expanded="false" aria-controls="mega-static">
            <span>{{ settings.nav_mega_trigger_label if settings.nav_mega_trigger_label else _('Menu') }}</span>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}

        {# ── REGULAR MENU ITEMS ── #}
        {% for item in store.settings.menus.main_menu.items %}
          {% if item.items | length > 0 %}
            {% set is_mega = namespace(value=false) %}
            {% for child in item.items %}
              {% if child.items | length > 0 %}{% set is_mega.value = true %}{% endif %}
            {% endfor %}

            {% if is_mega.value and settings.nav_enable_mega_menu != false %}
              {% if settings.nav_mega_mode != 'static' %}
                <button class="ananas-nav__link ananas-nav__link--has-sub"
                        data-mega-trigger="{{ loop.index }}" aria-expanded="false" aria-controls="mega-{{ loop.index }}">
                  <span>{{ item.label }}</span>
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              {% endif %}
            {% else %}
              <div class="ananas-nav__sub-wrap">
                <a href="{{ item.url | localized_url if item.resource_type != 'url' else item.url }}"
                   class="ananas-nav__link ananas-nav__link--has-sub"
                   data-sub-trigger="{{ loop.index }}" aria-expanded="false" aria-controls="sub-{{ loop.index }}">
                  <span>{{ item.label }}</span>
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
                <div class="ananas-sub" id="sub-{{ loop.index }}" aria-hidden="true">
                  {% for child in item.items %}
                    {% if child.items | length > 0 %}
                      <div class="ananas-sub__group">
                        <a href="{{ child.url | localized_url if child.resource_type != 'url' else child.url }}" class="ananas-sub__link ananas-sub__link--parent">
                          {{ child.label }}
                        </a>
                        <div class="ananas-sub__children">
                          {% for grandchild in child.items %}
                            <a href="{{ grandchild.url | localized_url if grandchild.resource_type != 'url' else grandchild.url }}" class="ananas-sub__link ananas-sub__link--child">
                              {{ grandchild.label }}
                            </a>
                          {% endfor %}
                        </div>
                      </div>
                    {% else %}
                      <a href="{{ child.url | localized_url if child.resource_type != 'url' else child.url }}" class="ananas-sub__link">
                        {{ child.label }}
                      </a>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          {% else %}
            <a href="{{ item.url | localized_url if item.resource_type != 'url' else item.url }}" class="ananas-nav__link">
              {{ item.label }}
            </a>
          {% endif %}
        {% endfor %}
      </nav>

      <div class="ananas-nav__icons">
        {# Cart #}
        <a href="{{ url_for('cart_page') }}" class="ananas-nav__icon-btn" aria-label="{{ _('Cart') }}" {% if settings.header_enable_side_cart %}onclick="event.preventDefault(); if(window.openSideCart) window.openSideCart();"{% endif %}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span data-cart-badge hidden class="ananas-nav__cart-badge">0</span>
        </a>
        {# Wishlist #}
        <a href="/pages/wishlist" class="ananas-nav__icon-btn" aria-label="{{ _('Wishlist') }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
          </svg>
        </a>
        {# Region #}
        {% if show_region %}
          <button type="button" onclick="return window.openAnanasRegionSettings(event)" class="ananas-nav__icon-btn" aria-label="{{ _('Region') }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </button>
        {% endif %}
        {# Account #}
        <button id="header-login-btn" type="button" onclick="handleLoginAction()" class="ananas-nav__icon-btn" aria-label="{{ _('Login') }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
        </button>
        <a id="header-profile-btn" href="{{ url_for('profile') }}" class="ananas-nav__icon-btn" style="display:none" aria-label="{{ _('Profile') }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
        {# Search #}
        {% if settings.nav_enable_search != false %}
          <button class="ananas-nav__icon-btn" id="nav-search-btn" aria-label="{{ _('Search') }}" aria-expanded="false" aria-controls="nav-search-panel">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
        {% endif %}
      </div>
    </div>

    {# ════════════════════════════════════════════
       MOBILE NAV INNER  (hidden on desktop)
       Layout (LTR): [cart+fav+globe] | [logo] | [search+menu]
    ════════════════════════════════════════════ #}
    <div class="ananas-nav__inner ananas-nav__inner--mob">

      {# Left: cart + wishlist + region #}
      <div class="ananas-mob__left">
        <a href="{{ url_for('cart_page') }}" class="ananas-nav__icon-btn" aria-label="{{ _('Cart') }}" {% if settings.header_enable_side_cart %}onclick="event.preventDefault(); if(window.openSideCart) window.openSideCart();"{% endif %}>
	          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
	            <path d="M16.7505 4.24995L0.751039 4.24972L0.75 4.25M16.7505 4.24995L16.75 15.3467C16.75 16.3978 15.8817 17.25 14.8106 17.25H2.68939C1.6183 17.25 0.75 16.3978 0.75 15.3467V4.25M16.7505 4.24995L13.5429 1.04289C13.3554 0.855357 13.101 0.75 12.8358 0.75H4.66421C4.399 0.75 4.14464 0.855357 3.95711 1.04289L0.75 4.25M11.75 7.25C11.75 8.90686 10.4069 10.25 8.75 10.25C7.09315 10.25 5.75 8.90686 5.75 7.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
	          </svg>
          <span data-cart-badge hidden class="ananas-nav__cart-badge">0</span>
        </a>
        <button id="mobile-login-btn" type="button" onclick="handleLoginAction()" class="ananas-nav__icon-btn" aria-label="{{ _('Login') }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
        </button>
        <a id="mobile-profile-btn" href="{{ url_for('profile') }}" class="ananas-nav__icon-btn" style="display:none" aria-label="{{ _('Profile') }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
        {% if show_region %}
	          <button type="button" onclick="return window.openAnanasRegionSettings(event)" class="ananas-nav__icon-btn" aria-label="{{ _('Region') }}">

            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8.5498 16.5498C12.2765 16.5498 15.4081 14.0015 16.2971 10.5524M8.5498 16.5498C4.82307 16.5498 1.69151 14.0015 0.802514 10.5524M8.5498 16.5498C10.7589 16.5498 12.5498 12.9681 12.5498 8.5498C12.5498 4.13153 10.7589 0.549805 8.5498 0.549805M8.5498 16.5498C6.34067 16.5498 4.5498 12.9681 4.5498 8.5498C4.5498 4.13153 6.34067 0.549805 8.5498 0.549805M16.2971 10.5524C16.4621 9.9124 16.5498 9.24135 16.5498 8.5498C16.5498 7.12281 16.1762 5.78308 15.5214 4.62309C14.1489 2.19153 11.5411 0.549805 8.5498 0.549805M0.802514 10.5524C0.63755 9.9124 0.549805 9.24135 0.549805 8.5498C0.549805 7.12281 0.923426 5.78308 1.57818 4.62309C2.95069 2.19153 5.55852 0.549805 8.5498 0.549805M15.5214 4.62309C13.6518 6.23904 11.2149 7.21647 8.5498 7.21647C5.88467 7.21647 3.44782 6.23904 1.57818 4.62309M16.2971 10.5524C14.0017 11.8251 11.3604 12.5498 8.5498 12.5498C5.73923 12.5498 3.09791 11.8251 0.802514 10.5524" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>

          </button>
        {% endif %}
      </div>

      {# Center: logo #}
      <a href="/" class="ananas-nav__logo" aria-label="{{ store.name }}">
        {% if settings.logo_mobile %}
          <img src="{{ image_url(settings.logo_mobile, w=150, q=90, f='auto') }}"
               style="max-height: 32px;" class="w-auto object-contain" alt="{{ store.name }}" />
        {% elif settings.logo_desktop %}
          <img src="{{ image_url(settings.logo_desktop, w=150, q=90, f='auto') }}"
               style="max-height: 32px;" class="w-auto object-contain" alt="{{ store.name }}" />
        {% elif store.logo %}
          <img src="{{ image_url(store.logo, w=150, q=90, f='auto') }}"
               style="max-height: 32px;" class="w-auto object-contain" alt="{{ store.name }}" />
        {% else %}
          <span class="ananas-nav__logo-text">{{ store.name }}</span>
        {% endif %}
      </a>

      {# Right: search + hamburger #}
      <div class="ananas-mob__right">
        {% if settings.nav_enable_search != false %}
          <button class="ananas-nav__icon-btn" id="nav-search-btn-mob"
                  aria-label="{{ _('Search') }}" aria-expanded="false" aria-controls="nav-search-panel">
            <span class="mob-search-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M17.5 17.5L13.875 13.875M15.83 9.17C15.83 12.85 12.85 15.83 9.17 15.83C5.48 15.83 2.5 12.85 2.5 9.17C2.5 5.48 5.48 2.5 9.17 2.5C12.85 2.5 15.83 5.48 15.83 9.17Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
            <span class="mob-close-icon" aria-hidden="true" hidden>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>
        {% endif %}
        {% set mobile_drawer_part = 'button' %}
        {% include 'components/header/mobile-drawer.jinja' %}
      </div>

    </div>

  </header>

  {# ─────────────────────────────────────────────────
     MEGA MENU PANELS
  ───────────────────────────────────────────────── #}
  {% if settings.nav_enable_mega_menu != false %}

    {# ── STATIC MODE: one shared panel ───────────── #}
    {% if settings.nav_mega_mode == 'static' %}
      <div class="ananas-mega ananas-mega--static" id="mega-static" aria-hidden="true" data-mega-panel="static" style="display:none">

        {% if settings.nav_mega_decor %}
          <div class="ananas-mega__decor" aria-hidden="true">
            <img src="{{ image_url(settings.nav_mega_decor, w=480, f='auto') }}" alt="" />
          </div>
        {% endif %}

        <div class="ananas-mega__static-inner">

          {% if settings.nav_mega_image %}
            {% if settings.nav_mega_link %}
              <a href="{{ settings.nav_mega_link }}" class="ananas-mega__static-img">
            {% else %}
              <div class="ananas-mega__static-img">
            {% endif %}
              <img
                src="{{ image_url(settings.nav_mega_image, w=280, h=330, f='auto') }}"
                alt="{{ settings.nav_mega_label | default('') }}"
                class="ananas-mega__img"
              />
              {% if settings.nav_mega_label %}
                <span class="ananas-mega__img-label ananas-mega__img-label--static">{{ settings.nav_mega_label }}</span>
              {% endif %}
            {% if settings.nav_mega_link %}</a>{% else %}</div>{% endif %}
          {% endif %}

          <div class="ananas-mega__static-cols">
            {% if settings.nav_mega_standalone_links %}
              <div class="ananas-mega__col ananas-mega__col--solo">
                {% for link in settings.nav_mega_standalone_links %}
                  <a href="{{ link.url | default('#') }}" class="ananas-mega__link">{{ link.label }}</a>
                {% endfor %}
              </div>
            {% endif %}
            {% for col in settings.nav_mega_columns or [] %}
              <div class="ananas-mega__col">
                {% if col.title %}<p class="ananas-mega__col-head">{{ col.title }}</p>{% endif %}
                {% for link in col.links or [] %}
                  <a href="{{ link.url | default('#') }}" class="ananas-mega__link">{{ link.label }}</a>
                {% endfor %}
              </div>
            {% endfor %}
          </div>

        </div>
      </div>
    {% endif %}

    {# ── DYNAMIC MODE: one panel per 3-level menu item ─ #}
    {% if settings.nav_mega_mode != 'static' %}
    {% for item in store.settings.menus.main_menu.items %}
      {% if item.items | length > 0 %}
        {% set is_mega = namespace(value=false) %}
        {% for child in item.items %}
          {% if child.items | length > 0 %}{% set is_mega.value = true %}{% endif %}
        {% endfor %}

        {% if is_mega.value %}
          <div class="ananas-mega" id="mega-{{ loop.index }}" aria-hidden="true" data-mega-panel="{{ loop.index }}" style="display:none">
            <div class="ananas-mega__inner">

                {# ── DYNAMIC MODE: columns built from menu tree ──────────── #}
                <div class="ananas-mega__cols">

                  {# Standalone level-2 links (no grandchildren) — no header, offset down #}
                  {% set standalone = [] %}
                  {% for child in item.items %}
                    {% if child.items | length == 0 %}{% set _ = standalone.append(child) %}{% endif %}
                  {% endfor %}
                  {% if standalone | length > 0 %}
                    <div class="ananas-mega__col ananas-mega__col--solo">
                      {% for child in standalone %}
                        <a
                          href="{{ child.url | localized_url if child.resource_type != 'url' else child.url }}"
                          class="ananas-mega__link"
                        >{{ child.label }}</a>
                      {% endfor %}
                    </div>
                  {% endif %}

                  {# Level-2 items with level-3 children → columns with header + links #}
                  {% for child in item.items %}
                    {% if child.items | length > 0 %}
                      <div class="ananas-mega__col">
                        <p class="ananas-mega__col-head">{{ child.label }}</p>
                        {% for gc in child.items %}
                          <a
                            href="{{ gc.url | localized_url if gc.resource_type != 'url' else gc.url }}"
                            class="ananas-mega__link"
                          >{{ gc.label }}</a>
                        {% endfor %}
                      </div>
                    {% endif %}
                  {% endfor %}

                </div>{# /.ananas-mega__cols #}

              {# Featured image — LAST in DOM → LEFT side in RTL flex #}
              {% if settings.nav_mega_image %}
                {% if settings.nav_mega_link %}
                  <a href="{{ settings.nav_mega_link }}" class="ananas-mega__img-wrap">
                {% else %}
                  <div class="ananas-mega__img-wrap">
                {% endif %}
                  <img
                    src="{{ image_url(settings.nav_mega_image, w=280, h=330, f='auto') }}"
                    alt="{{ settings.nav_mega_label | default('') }}"
                    class="ananas-mega__img"
                  />
                  {% if settings.nav_mega_label %}
                    <span class="ananas-mega__img-label">{{ settings.nav_mega_label }}</span>
                  {% endif %}
                {% if settings.nav_mega_link %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              {% endif %}

            </div>{# /.ananas-mega__inner #}
          </div>{# /.ananas-mega #}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% endif %}{# /dynamic mode #}

  {% endif %}{# /nav_enable_mega_menu #}

  {# ─────────────────────────────────────────────────
     ADVANCED SEARCH PANEL
     Shown when search button is clicked.
     Featured products slider + popular searches.
  ───────────────────────────────────────────────── #}
  {% if settings.nav_enable_search != false %}
    <div class="ananas-search" id="nav-search-panel" aria-hidden="true" style="display:none">
      <div class="ananas-search__inner">

        {# Input row #}
        <div class="ananas-search__top">
          <div class="ananas-search__field">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="ananas-search__field-icon" aria-hidden="true">
              <path d="M21 21L16.65 16.65M19 11C19 15.42 15.42 19 11 19C6.58 19 3 15.42 3 11C3 6.58 6.58 3 11 3C15.42 3 19 6.58 19 11Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <input
              type="text"
              id="nav-search-input"
              class="ananas-search__input"
              placeholder="{{ settings.nav_search_placeholder if settings.nav_search_placeholder else _('Search') + '…' }}"
              autocomplete="off"
              dir="auto"
            />
          </div>
          <div class="ananas-search__sep" aria-hidden="true"></div>
          <button class="ananas-search__close-btn" id="nav-search-close" aria-label="{{ _('Close') }}">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

        {# Body: products slider + popular searches #}
        <div class="ananas-search__body">

          {# Products slider — shown/hidden from settings #}
          {% if settings.nav_show_products != false %}
            <div class="ananas-search__slider-wrap" data-search-featured-wrap>
              <button class="ananas-search__slider-arrow ananas-search__slider-arrow--prev" id="search-slider-prev" aria-label="{{ _('Previous') }}" hidden>
                <svg width="6" height="10" viewBox="0 0 6 10" fill="none">
                  <path d="M5 1L1 5L5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button class="ananas-search__slider-arrow ananas-search__slider-arrow--next" id="search-slider-next" aria-label="{{ _('Next') }}" hidden>
                <svg width="6" height="10" viewBox="0 0 6 10" fill="none">
                  <path d="M5 1L1 5L5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="ananas-search__track-viewport">
                <div class="ananas-search__track" id="search-track">
                  {% set search_products = settings.nav_search_products.results if settings.nav_search_products and settings.nav_search_products.results else [] %}
                  {% if search_products %}
                    {% for product in search_products %}
                      {% set product_img = product.main_image.image.medium if product.main_image and product.main_image.image else (image_url(product.images[0].image.full_size, w=360, q=85, f='auto') if product.images and product.images|length > 0 else '') %}
                      {% set product_url = url_for('product_details', slug=product.slug) %}
                      {% set has_options = product.has_options or product.has_fields %}
                      <div class="ananas-pcard" data-search-product-card>
                        <div class="ananas-pcard__img-wrap">
                          <a href="{{ product_url }}" class="ananas-pcard__link" tabindex="-1" aria-hidden="true">
                            {% if product_img %}
                              <img src="{{ product_img }}" alt="{{ product.name }}" class="ananas-pcard__img" loading="lazy">
                            {% endif %}
                          </a>
                        </div>
                        <div class="ananas-pcard__body">
                          <div class="ananas-pcard__info">
                            <a href="{{ product_url }}" class="ananas-pcard__name">{{ product.name }}</a>
                            <div class="ananas-pcard__price">
                              {{ product.formatted_sale_price if product.formatted_sale_price is not none else product.formatted_price }}
                            </div>
                          </div>
                          <div class="ananas-pcard__actions">
                            <button class="ananas-pcard__btn ananas-pcard__btn--cart" type="button" {% if has_options %}data-open-quick-view="true"{% else %}data-add-to-cart="{{ product.id }}"{% endif %} data-product-id="{{ product.id }}" aria-label="{{ _('Add to cart') }}">
                              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                                <path d="M16.7505 4.24995L0.751039 4.24972L0.75 4.25M16.7505 4.24995L16.75 15.3467C16.75 16.3978 15.8817 17.25 14.8106 17.25H2.68939C1.6183 17.25 0.75 16.3978 0.75 15.3467V4.25M16.7505 4.24995L13.5429 1.04289C13.3554 0.855357 13.101 0.75 12.8358 0.75H4.66421C4.399 0.75 4.14464 0.855357 3.95711 1.04289L0.75 4.25M11.75 7.25C11.75 8.90686 10.4069 10.25 8.75 10.25C7.09315 10.25 5.75 8.90686 5.75 7.25" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </button>
                            <button class="ananas-pcard__btn ananas-pcard__btn--wishlist" type="button" data-wishlist-btn data-product-id="{{ product.id }}" aria-label="{{ _('Add to wishlist') }}">
                              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 17.5S2.5 13 2.5 7.5A3.75 3.75 0 0 1 10 5.26 3.75 3.75 0 0 1 17.5 7.5C17.5 13 10 17.5 10 17.5Z" stroke="white" stroke-width="1.3"/></svg>
                            </button>
                          </div>
                        </div>
                      </div>
                    {% endfor %}
                  {% endif %}
                </div>{# /.ananas-search__track #}
              </div>{# /.ananas-search__track-viewport #}
            </div>
          {% endif %}

          {# Popular searches — shown/hidden from settings #}
          {% if settings.nav_show_popular != false and settings.nav_popular_searches %}
            <div class="ananas-search__popular" id="search-popular">
              <p class="ananas-search__pop-title">
                {{ settings.nav_popular_title if settings.nav_popular_title else _('Popular searches') }}
              </p>
              <ul class="ananas-search__pop-list">
                {% for entry in settings.nav_popular_searches %}
                  <li>
                    <a href="/products?q={{ entry.term | urlencode }}" class="ananas-search__pop-link">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M14 14L11.07 11.07M12.67 7.33C12.67 10.28 10.28 12.67 7.33 12.67C4.38 12.67 2 7.33 2 7.33C2 4.38 4.38 2 7.33 2C10.28 2 12.67 4.38 12.67 7.33Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                      </svg>
                      {{ entry.term }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

        </div>{# /.ananas-search__body #}

      </div>{# /.ananas-search__inner #}
    </div>{# /.ananas-search #}
  {% endif %}

</div>{# /#ananas-header #}

{% set mobile_drawer_part = 'drawer' %}
{% include 'components/header/mobile-drawer.jinja' %}

{# Backdrop #}
<div class="ananas-backdrop" id="ananas-backdrop" aria-hidden="true"></div>

{% if settings.header_enable_side_cart %}
  {% include 'components/header/side-cart.jinja' %}
{% endif %}

{# ══════════════════════════════════════════════════
   STYLES
══════════════════════════════════════════════════ #}
<style>
  /* ─── CSS Variables (from theme settings) ────── */
  :root {
    --ananas-nav-bg:          {{ s_nav_bg }};
    --ananas-nav-border:      {{ s_nav_border }};
    --ananas-nav-height:      {{ s_nav_height }}px;
    --ananas-logo-h:          {{ s_logo_height }}px;
    --ananas-link-color:      {{ s_link_color }};
    --ananas-icon-color:      {{ s_icon_color }};
    --ananas-icon-color-mobile: {{ s_icon_color_mobile }};
    --ananas-badge-color:     {{ s_badge_color }};
    --ananas-dd-bg:           {{ s_dd_bg }};
    --ananas-dd-border:       {{ s_dd_border }};
    --ananas-mega-bg:         {{ s_mega_bg }};
    --ananas-mega-link:       {{ s_mega_link }};
    --ananas-mega-head:       {{ s_mega_head }};
    --ananas-search-bg:         {{ s_search_bg }};
    --ananas-search-border:     {{ s_search_border }};
    --ananas-search-input:      {{ s_search_input }};
    --ananas-search-results:    {{ s_search_results }};
    --ananas-search-card-border:{{ s_search_card_border }};
    /* Used by mobile drawer for correct top offset */
    --header-h:               {{ s_nav_height }}px;
  }

  /* ─── Reset / base ──────────────────────────── */
  #ananas-header, #ananas-header *, .ananas-backdrop {
    box-sizing: border-box;
  }
  #ananas-header {
    font-family: 'GE SS Two', 'Expo Arabic', sans-serif;
  }

  /* ─── Navbar ─────────────────────────────────── */
  .ananas-nav {
    background: var(--ananas-nav-bg);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    border-bottom: 1px solid var(--ananas-nav-border);
    height: var(--ananas-nav-height);
  }
  /* Desktop inner */
  .ananas-nav__inner--desk {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 80px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    /*direction: rtl;*/
  }
  /* Mobile inner — CSS Grid: [left-icons 1fr] [logo auto] [right-icons 1fr]
     hidden on desktop, shown on mobile via media query */
	  .ananas-nav__inner--mob {
	    display: none;
	    height: 56px;
	    padding: 0 16px;
	    align-items: center;
	    grid-template-columns: 1fr auto 1fr;
	    direction: ltr;
	    width: 100%;
	  }
  .ananas-mob__left  { display: flex; align-items: center; justify-content: flex-start;gap: 5px; }
  .ananas-mob__right { display: flex; align-items: center; justify-content: flex-end; }
  /* Center logo inside its grid cell */
  .ananas-nav__inner--mob .ananas-nav__logo { justify-self: center; }
  .ananas-nav__logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .ananas-nav__logo-text { color: var(--ananas-link-color); font-size: 18px; font-weight: 600; }

  /* Nav links */
  .ananas-nav__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    /*direction: rtl;*/
  }
  .ananas-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 32px;
    padding: 4px 8px;
    color: var(--ananas-link-color);
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    text-decoration: none;
    white-space: nowrap;
    background: none;
    border: none;
    cursor: pointer;
    transition: opacity .15s;
  }
  .ananas-nav__link:hover { opacity: .7; }
  .ananas-nav__link--has-sub svg { transition: transform .2s; }
  .ananas-nav__link--has-sub.is-open svg { transform: rotate(180deg); }

  /* Simple 2-level sub-dropdown */
  .ananas-nav__sub-wrap { position: relative; }
  .ananas-sub {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: var(--ananas-dd-bg);
    border: 1px solid var(--ananas-dd-border);
    min-width: 160px;
    padding: 4px 0;
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity .2s, transform .2s;
    /*direction: rtl;*/
  }
  .ananas-sub.is-open { opacity: 1; pointer-events: auto; transform: translateY(0); }
  .ananas-sub__link {
    display: block;
    color: var(--ananas-link-color);
    font-size: 14px;
    font-family: inherit;
    text-decoration: none;
    padding: 8px 16px;
    text-align: right;
    transition: background .15s;
    white-space: nowrap;
  }
  [dir="ltr"] .ananas-sub__link { text-align: left; }
  .ananas-sub__link:hover { background: color-mix(in srgb, var(--ananas-dd-bg) 60%, white 40%); }

  /* 3rd level nested sub */
  .ananas-sub__group { position: relative; }
  .ananas-sub__link--parent {
    font-weight: 600;
    display: flex;
    align-items: center;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 6px;
  }
  [dir="ltr"] .ananas-sub__link--parent {
    align-items: center;
    flex-direction: row-reverse !important;
    justify-content: space-between;; 
  }
  .ananas-sub__link--parent::before {
    content: '';
    display: inline-block;
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-right: 5px solid currentColor;
    opacity: .5;
    flex-shrink: 0;
  }
  [dir="ltr"] .ananas-sub__link--parent {
    flex-direction: row;
  }
  [dir="ltr"] .ananas-sub__link--parent::before {
    border-right: none;
    border-left: 5px solid currentColor;
  }
  .ananas-sub__children {
    display: none;
    position: absolute;
    top: 0;
    left: 100%;
    background: var(--ananas-dd-bg);
    border: 1px solid var(--ananas-dd-border);
    min-width: 160px;
    padding: 4px 0;
    z-index: 201;
  }
  [dir="rtl"] .ananas-sub__children { left: auto; right: 100%; }
  .ananas-sub__group:hover .ananas-sub__children { display: block; }

  /* Sub-dropdown scroll arrows */
  .ananas-sub--scrollable {
    padding: 0;
  }
  .ananas-sub__list {
    max-height: 240px;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 4px 0;
  }
  .ananas-sub__list::-webkit-scrollbar { display: none; }

  .ananas-sub__arrows {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 16px 4px;
    direction: ltr;
  }
  .ananas-sub__arrow {
    width: 32px;
    height: 32px;
    border-radius: 99px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: opacity .2s;
  }
  .ananas-sub__arrow--prev {
    background: #f85f3b;
  }
  .ananas-sub__arrow--next {
    background: rgba(248, 95, 59, 0.32);
  }
  .ananas-sub__arrow--prev.ananas-sub__arrow--active {
    background: #f85f3b;
  }
  .ananas-sub__arrow--next.ananas-sub__arrow--active {
    background: #f85f3b;
  }
  .ananas-sub__arrow--prev:not(.ananas-sub__arrow--active) {
    background: rgba(248, 95, 59, 0.32);
  }
  .ananas-sub__arrow svg path { stroke: white; }

  /* Icons */
  .ananas-nav__icons {
    display: flex; 
    align-items: center; 
    gap: 0px; 
    flex-direction: row-reverse;
  }
  [dir="ltr"] .ananas-nav__icons { flex-direction: row-reverse; }
  .ananas-nav__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    position: relative;
    flex-shrink: 0;
    color: var(--ananas-icon-color);
    transition: background 0.2s;
    border-radius: 4px;
  }
  .ananas-nav__icon-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .ananas-nav__icon-btn svg {
    width: 20px;
    height: 20px;
  }
  .ananas-mob__left .ananas-nav__icon-btn{
    width: fit-content !important;
    padding-inline: 6px;
  }
  .ananas-nav__cart-badge {
    position: absolute;
    top: 0;
    right: 0;
    background: #25A562;
    color: white;
    font-size: 10px;
    font-weight: 700;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    line-height: 1;
  }

  /* ─── MEGA MENU ──────────────────────────────── */
  /* Hide the dynamic inner when static mode is active */
  .ananas-mega--static .ananas-mega__inner { display: none; }

  .ananas-mega {
    background: var(--ananas-mega-bg);
    border-bottom: 1px solid var(--ananas-nav-border);
    overflow: hidden;
    /*direction: rtl;*/
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out, visibility 0.8s ease-out;
  }
  .ananas-mega.is-open { 
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .ananas-mega__inner {
    max-width: 1440px;
    margin: 0 auto;
    min-height: 352px;
    padding: 32px 56px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 104px;
    /*direction: rtl;*/
    position: relative;
  }

  /* Featured image box */
  .ananas-mega__img-wrap {
    width: 280px;
    height: 280px;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
    display: block;
    text-decoration: none;
  }
  .ananas-mega__img {
    width: 100%;
    height: 117.9%;
    object-fit: cover;
    position: absolute;
    top: -0.02%;
    left: 0;
  }
  .ananas-mega__img-label {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--ananas-mega-link);
    font-size: 18px;
    font-weight: 500;
    font-family: 'Expo Arabic', sans-serif;
    white-space: nowrap;
    /*direction: rtl;*/
    pointer-events: none;
  }

  /* Columns */
  .ananas-mega__cols {
    flex: 1;
    display: flex;
    gap: 64px;
    justify-content: flex-start;
    align-items: flex-start;
    flex-wrap: nowrap;
    overflow: hidden;
    /*direction: rtl;*/
  }
  .ananas-mega__col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-end;
    flex-shrink: 0;
    width: 142px;
  }
  .ananas-mega__col--solo {
    gap: 24px;
    padding-top: 44px;
  }
  .ananas-mega__col-head {
    color: var(--ananas-mega-head);
    font-size: 14px;
    font-weight: 400;
    font-family: 'Expo Arabic', sans-serif;
    margin: 0;
    text-align: right;
    white-space: nowrap;
    line-height: 20px;
    width: 100%;
  }
  [dir="ltr"] .ananas-mega__col-head {
    text-align: left;
  }
  .ananas-mega__link {
    color: var(--ananas-mega-link);
    font-size: 16px;
    font-weight: 400;
    font-family: 'Expo Arabic', sans-serif;
    text-decoration: none;
    text-align: right;
    white-space: nowrap;
    line-height: 24px;
    transition: opacity .15s;
    display: block;
    width: 100%;
  }
  [dir="ltr"] .ananas-mega__link {
    text-align: left;
  }
  .ananas-mega__link:hover { opacity: .65; }

  /* ─── MEGA MENU: STATIC MODE ─────────────────── */
  /* Removed .ananas-mega--static.is-open max-height as it is now handled by opacity/visibility */

  /* Decorative element — positioned from panel left edge (full-width) */
  .ananas-mega__decor {
    position: absolute;
    left: calc(91.67% - 42px);
    top: 168px;
    width: 237px;
    height: 237px;
    pointer-events: none;
    z-index: 0;
  }
  .ananas-mega__decor img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.55;
  }

  /* Centered content container (matches 1440px inner max-width) */
  .ananas-mega__static-inner {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    height: 352px;
    z-index: 1;
  }

  /* Featured image — left absolute */
  .ananas-mega__static-img {
    position: absolute;
    left: 56px;
    top: 32px;
    width: 280px;
    height: 280px;
    overflow: hidden;
    display: block;
    text-decoration: none;
    flex-shrink: 0;
  }
  .ananas-mega__static-img .ananas-mega__img {
    width: 100%;
    height: 117.9%;
