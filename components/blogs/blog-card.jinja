{#
  Blog Card (Ananas) - matches the card style of templates/blogs.jinja

  Props:
  - blog: BlogPost (title, slug, snippet, cover, published_at)
  - index: number (optional) - for lazy loading
#}
{% set card_index = index | default(0) %}
{% set blog_image = blog.cover.image.medium if blog.cover and blog.cover.image and blog.cover.image.medium else none %}
{% set blog_href = '/blogs/' ~ (blog.slug | default('')) %}

<article class="group bg-white shadow-sm rounded h-full flex flex-col overflow-hidden border border-transparent transition-colors duration-200 hover:border-primary">
  <a href="{{ blog_href }}" class="block aspect-[4/3] w-full overflow-hidden bg-gray-50" tabindex="-1" aria-hidden="true">
    {% if blog_image %}
      <img
        src="{{ blog_image }}"
        alt="{{ (blog.cover.alt_text if blog.cover and blog.cover.alt_text else blog.title) | default('') }}"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        {% if card_index > 0 %}loading="lazy"{% endif %}
      />
    {% else %}
      <span class="flex h-full w-full items-center justify-center text-gray-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </span>
    {% endif %}
  </a>
  <div class="px-4 py-3 border-b">
    <h3 class="font-bold text-sm text-gray-700 line-clamp-2">
      <a href="{{ blog_href }}" class="hover:text-primary">{{ blog.title }}</a>
    </h3>
    {% if blog.published_at %}
      <span class="mt-1 block text-xs text-gray-500" data-blog-date="{{ blog.published_at }}">{{ blog.published_at }}</span>
    {% endif %}
  </div>
  {% if blog.snippet %}
    <p class="p-3 text-gray-500 text-sm line-clamp-3">{{ blog.snippet | striptags | truncate(160) }}</p>
  {% endif %}
  <div class="mt-auto flex items-center px-4 py-2 bg-gray-50">
    <a href="{{ blog_href }}" class="text-primary inline-flex items-center text-sm hover:underline">
      <span>{{ _("Read More") }}</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ms-2 rtl:rotate-180" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</article>
