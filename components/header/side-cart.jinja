<div
  id="side-cart-drawer"
  class="ananas-side-cart"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
>
  <div
    class="ananas-side-cart__overlay"
    id="side-cart-close-overlay"
  ></div>
  <div class="ananas-side-cart__content">
    <div class="ananas-side-cart__header">
      <div class="flex items-center gap-2">
        <span class="font-expo text-base font-normal text-black">{{ _('Added to cart') }}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C13.4121 3 14.7482 3.32519 15.9375 3.90476M19.3125 6.375L11.4375 14.25L9.1875 12" stroke="#468500" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <button
        id="side-cart-close-btn"
        type="button"
        class="text-gray-500 hover:text-black"
        aria-label="{{ _('Close') }}"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M6 18L18 6M6 6L18 18"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>

    {% set side_cart_subtotal_condition = cart.free_shipping_rule.subtotal_condition if cart.free_shipping_rule else none %}
    {% set side_cart_free_shipping_status = side_cart_subtotal_condition.status | default('') if side_cart_subtotal_condition else '' %}
    {% set side_cart_free_shipping_remaining = side_cart_subtotal_condition.remaining | default('57.00 SAR') if side_cart_subtotal_condition else '57.00 SAR' %}
    {% set side_cart_free_shipping_percent = side_cart_subtotal_condition.products_subtotal_percentage_from_min | default(0) if side_cart_subtotal_condition else 70 %}
    {% set side_cart_free_shipping_width = 100 if side_cart_free_shipping_status == 'applied' else side_cart_free_shipping_percent %}
    <div class="ananas-side-cart__shipping-wrapper">
      <div class="ananas-side-cart__shipping">
        <div class="flex w-full items-center justify-start   gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="13" viewBox="0 0 18 13" fill="none">
            <path d="M0 0V1.125H10.6875V9.5625H7.22475C6.97387 8.59556 6.10425 7.875 5.0625 7.875C4.02075 7.875 3.15113 8.59556 2.90025 9.5625H2.25V6.75H1.125V10.6875H2.90025C3.15113 11.6544 4.02075 12.375 5.0625 12.375C6.10425 12.375 6.97387 11.6544 7.22475 10.6875H11.9003C12.1511 11.6544 13.0208 12.375 14.0625 12.375C15.1042 12.375 15.9739 11.6544 16.2247 10.6875H18V6.09975L17.9646 6.01144L16.8396 2.63644L16.7175 2.25H11.8125V0H0ZM0.5625 2.25V3.375H5.625V2.25H0.5625ZM11.8125 3.375H15.9081L16.875 6.25781V9.5625H16.2247C15.9739 8.59556 15.1042 7.875 14.0625 7.875C13.0208 7.875 12.1511 8.59556 11.9003 9.5625H11.8125V3.375ZM1.125 4.5V5.625H4.5V4.5H1.125ZM5.0625 9C5.69081 9 6.1875 9.49669 6.1875 10.125C6.1875 10.7533 5.69081 11.25 5.0625 11.25C4.43419 11.25 3.9375 10.7533 3.9375 10.125C3.9375 9.49669 4.43419 9 5.0625 9ZM14.0625 9C14.6908 9 15.1875 9.49669 15.1875 10.125C15.1875 10.7533 14.6908 11.25 14.0625 11.25C13.4342 11.25 12.9375 10.7533 12.9375 10.125C12.9375 9.49669 13.4342 9 14.0625 9Z" fill="#171717"/>
          </svg>
          <span
            class="font-expo text-xs font-normal text-[#171717]"
            id="side-cart-shipping-text"
          >
            {% if side_cart_free_shipping_status == 'applied' %}
              {{ _('Free shipping applied!') }}
            {% else %}
              {{ _('Add purchases worth %(total)s %(currency)s to get free shipping') | replace('%(total)s', '<span id="side-cart-shipping-remaining"></span>') | replace('%(currency)s', session.currency) }}
            {% endif %}
          </span>
        </div>
        <div class="ananas-side-cart__progress-bar">
          <div
            class="ananas-side-cart__progress-fill"
            id="side-cart-shipping-progress"
            style="width: {{ side_cart_free_shipping_width }}%"
          ></div>
        </div>
      </div>
    </div>

    <div
      class="ananas-side-cart__items"
      id="side-cart-items"
    >
      {% if cart.products and cart.products | length > 0 %}
        {% for item in cart.products %}
          {% set product_image = '' %}
          {% if item.product and item.product.images and item.product.images[0] %}
            {% set product_image = item.product.images[0].image.full_size | default(item.product.images[0].image.medium | default(item.product.images[0].image.thumbnail | default(item.product.images[0].image.url | default(item.product.images[0].url | default(item.product.images[0].image_url | default('')))))) %}
          {% endif %}
          {% if not product_image %}
          {% endif %}
          {% set _currency = cart.currency.cart_currency.code if (cart.currency and cart.currency.cart_currency) else session.currency %}
          {% set _price_num = item.price | float if item.price else 0 %}
          {% set _compare_num = item.compare_at_price | float if item.compare_at_price else 0 %}
          {% set current_price = ('%.2f' | format(_price_num) ~ ' ' ~ _currency) if _price_num else (item.price_string | default(item.price_formatted | default(item.product.selected_product.formatted_sale_price | default(item.product.formatted_sale_price | default(''))))) %}
          {% set compare_price = ('%.2f' | format(_compare_num) ~ ' ' ~ _currency) if _compare_num > _price_num else '' %}
          {% set discount_percent = item.discount_percentage | default(item.discount_percent | default(item.product.selected_product.discount_percentage | default(item.product.discount_percentage | default('')))) %}
          {% if not discount_percent and item.compare_at_price and item.price and (item.compare_at_price | float) > (item.price | float) %}
            {% set compare_value = item.compare_at_price | float %}
            {% set price_value = item.price | float %}
            {% set discount_percent = (((compare_value - price_value) / compare_value) * 100) | round(0, 'floor') | int %}
          {% endif %}
          {% set product_url = item.product.url | default(item.product.html_url | default('')) %}
          <div class="ananas-side-cart__item">
            <a class="ananas-side-cart__item-img-wrap" {% if product_url %}href="{{ product_url }}"{% endif %}>
              {% if product_image %}
                <img
                  src="{{ product_image }}"
                  alt="{{ item.product.name | default(item.name) }}"
                  class="ananas-side-cart__item-img"
                />
              {% endif %}
            </a>
            <div class="ananas-side-cart__item-info">
              <div class="flex items-start justify-between">
                <div class="font-expo">
                  {% set item_meta = item.product.categories[0].name if item.product and item.product.categories else (item.product.category.name if item.product and item.product.category else '') %}
                  <div class="ananas-side-cart__item-topline">
                    {% if item_meta %}
                      <p class="ananas-side-cart__item-meta">{{ item_meta }}</p>
                    {% else %}
                      <span></span>
                    {% endif %}
                    {% if discount_percent %}
                      <span class="ananas-side-cart__discount font-expo">{{ _('%(percent)s discount') | format(percent=(discount_percent ~ '%')) }}</span>
                    {% endif %}
                  </div>
                  <a class="ananas-side-cart__item-title" {% if product_url %}href="{{ product_url }}"{% endif %}>{{ item.product.name | default(item.name) }}</a>
                </div>
              </div>
              <div class="ananas-side-cart__price-row">
                <span class="ananas-side-cart__item-price {% if compare_price %}is-sale{% endif %} font-expo"
                  >{{ current_price }}</span
                >
                {% if compare_price %}
                  <span class="ananas-side-cart__compare-price font-expo"
                    >{{ compare_price }}</span
                  >
                {% endif %}
              </div>
              <div class="ananas-side-cart__item-actions">
                <div class="ananas-side-cart__qty">
                  <button
                    class="ananas-side-cart__qty-btn"
                    type="button"
                    data-side-cart-action="decrease"
                    data-cart-item-id="{{ item.id }}"
                    data-cart-qty="{{ item.quantity }}"
                  >
                    −
                  </button>
                  <input
                    type="text"
                    class="ananas-side-cart__qty-input font-expo"
                    value="{{ item.quantity }}"
                    readonly
                  />
                  <button
                    class="ananas-side-cart__qty-btn"
                    type="button"
                    data-side-cart-action="increase"
                    data-cart-item-id="{{ item.id }}"
                    data-cart-qty="{{ item.quantity }}"
                  >
                    +
                  </button>
                </div>

                <div class="ananas-side-cart__item-icons">
                  <!-- Wishlist Button with Heart-Add Icon -->
                  <button
                    type="button"
                    class="ananas-side-cart__icon-btn"
                    data-wishlist-btn
                    data-product-id="{{ item.product.id | default(item.product_id) }}"
                    aria-label="{{ _('Add to wishlist') }}"
                  >
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path
                        d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3c2.09 0 3.96 1.15 4.9 2.87"
                      />
                      <path d="M11 16h10" />
                      <path d="M14 13l-3 3 3 3" />
                    </svg>
                  </button>

                  <!-- Trash Button -->
                  <button
                    type="button"
                    class="ananas-side-cart__icon-btn"
                    data-side-cart-action="remove"
                    data-cart-item-id="{{ item.id }}"
                    aria-label="{{ _('Remove') }}"
                  >
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <path
                        d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2M10 11v6M14 11v6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p class="font-expo mt-8 text-center text-gray-500">{{ _('Cart is empty') }}</p>
      {% endif %}
    </div>

    <div class="ananas-side-cart__footer">
      <div class="ananas-side-cart__summary">
        <div class="ananas-side-cart__summary-copy">
          <span class="font-expo text-lg font-medium text-black">{{ _('Total') }}</span>
          <span
            class="font-expo text-sm font-normal text-gray-500"
            id="side-cart-count"
            >({{ _('%(count)s items in cart') | format(count=(cart.products_count | default(0))) }})</span
          >
        </div>
        <div class="ananas-side-cart__summary-total">
          <span
            class="font-expo text-lg font-medium text-black"
            id="side-cart-total"
            >{{ cart.total_string | default(cart.total) | default('0.00') }}</span
          >
        </div>
      </div>
      <div class="flex w-full items-center gap-3">
        <a
          href="/checkout"
          class="ananas-side-cart__btn ananas-side-cart__btn--primary font-expo"
          >{{ _('Checkout page') }}</a
        >
        <a
          href="{{ url_for('cart_page') }}"
          class="ananas-side-cart__btn ananas-side-cart__btn--outline font-expo"
          >{{ _('Go to cart') }}</a
        >
      </div>
    </div>
  </div>
</div>

<style>
  .ananas-side-cart {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    display: flex;
    pointer-events: none;
    /*direction: rtl;*/
  }
  .ananas-side-cart.is-active {
    pointer-events: auto;
  }
  .ananas-side-cart__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .ananas-side-cart.is-active .ananas-side-cart__overlay {
    opacity: 1;
  }
  .ananas-side-cart__content {
    position: absolute;
    top: 0;
    left: -100%;
    width: 390px;
    max-width: 100%;
    height: 100%;
    max-height: 100dvh;
    background: #fcfaf7;
    transition: left 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    overscroll-behavior: contain;
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.1);
  }
  .ananas-side-cart.is-active .ananas-side-cart__content {
    left: 0;
  }
  .ananas-side-cart__header {
    flex: 0 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 56px;
    padding: 24px 16px 16px;
    border-bottom: 1px solid #e7e5e4;
  }
  .ananas-side-cart__shipping-wrapper {
    flex: 0 0 auto;
    padding: 16px 16px 0;
    background: transparent;
  }
  .ananas-side-cart__shipping {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ananas-side-cart__progress-bar {
    width: 100%;
    height: 4px;
    background: #e7e5e4;
    border-radius: 2px;
    overflow: hidden;
    direction: ltr;
  }
  .ananas-side-cart__progress-fill {
    height: 100%;
    margin-left: auto;
    background: linear-gradient(90deg, #92db5d 0%, #25a562 100%);
    transition: width 0.3s ease;
  }
  .ananas-side-cart__items {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 0;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }
  .ananas-side-cart__item {
    flex: 0 0 auto;
    display: flex;
    gap: 8px;
    align-items: flex-start;
    background: transparent;
    border: 0;
    border-bottom: 1px solid #e7e5e4;
    border-radius: 0;
    padding: 0 0 16px;
    margin-bottom: 16px;
    min-height: 0;
    height: auto;
    overflow: visible;
  }
  .ananas-side-cart__item-img-wrap {
    width: 100px;
    height: 128px;
    min-height: 0;
    align-self: flex-start;
    border-radius: 0 8px 8px 0;
    overflow: hidden;
    flex-shrink: 0;
    background: #f3f3f3;
    display: block;
    text-decoration: none;
  }
  .ananas-side-cart__item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ananas-side-cart__item-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    gap: 6px;
    min-height: 128px;
    height: auto;
    padding: 2px 8px 0 0;
    position: relative;
    overflow: visible;
  }
  .ananas-side-cart__item-meta {
    margin: 0;
    color: #71717b;
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    text-align: right;
    white-space: nowrap;
  }
  [dir="ltr"] .ananas-side-cart__item-meta {
    text-align: left;
  }
  .ananas-side-cart__item-topline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    min-height: 22px;
    /*direction: rtl;*/
  }
  .ananas-side-cart__item-title {
    font-size: 16px;
    font-weight: 400;
    color: #000;
    line-height: 24px;
    margin: 0;
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    white-space: normal;
    word-break: normal;
    text-decoration: none;
  }
  [dir="ltr"] .ananas-side-cart__item-title {
    text-align: left;
  }
  .ananas-side-cart__price-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    flex-wrap: wrap;
    /*direction: rtl;*/
  }
  .ananas-side-cart__item-price {
    font-size: 18px;
    font-weight: 500;
    line-height: 28px;
    color: #000;
    white-space: nowrap;
  }
  .ananas-side-cart__item-price.is-sale {
    color: #c70036;
  }
  .ananas-side-cart__compare-price {
    color: #737373;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    text-decoration: line-through;
    white-space: nowrap;
  }
  .ananas-side-cart__discount {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: 22px;
    padding: 3px 6px;
    background: #d3db6f;
    color: #000;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    white-space: nowrap;
  }
  .ananas-side-cart__options {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 2px;
  }
  .ananas-side-cart__option {
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    color: #52525c;
    font-size: 12px;
    line-height: 16px;
    text-align: right;
    width: 100%;
    min-width: 0;
  }
    [dir="ltr"] .ananas-side-cart__option {
    text-align: left;
  }
  .ananas-side-cart__option-label {
    color: #18181b;
    font-weight: 600;
    flex: 0 0 auto;
  }
  .ananas-side-cart__variant-select {
    flex: 1 1 96px;
    width: auto;
    min-width: 0;
    max-width: 150px;
    height: 32px;
    padding: 0 28px 0 10px;
    border: 1px solid #d4d4d8;
    background: #fff;
    color: #27272a;
    font-size: 12px;
    line-height: 16px;
    /*direction: rtl;*/
    text-align: right;
  }
    [dir="ltr"] .ananas-side-cart__variant-select {
      text-align: left;
    }
  .ananas-side-cart__item-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 4px;
    flex-wrap: wrap;
  }
  .ananas-side-cart__qty {
    display: flex;
    align-items: center;
    border: 1px solid #e7e5e4;
    border-radius: 4px;
    height: 32px;
    overflow: hidden;
    direction: ltr;
  }
  .ananas-side-cart__qty-btn {
    width: 32px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: #5f5c5c;
    font-size: 20px;
    line-height: 1;
  }
  .ananas-side-cart__qty-btn:disabled,
  .ananas-side-cart__icon-btn:disabled {
    cursor: wait;
    opacity: 0.5;
  }
  .ananas-side-cart__qty-input {
    width: 32px;
    height: 30px;
    text-align: center;
    border: none;
    background: #f5f5f5;
    color: #5f5c5c;
    font-size: 16px;
    outline: none;
  }
  .ananas-side-cart__item-icons {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ananas-side-cart__icon-btn {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid #e5e5e5;
    border-radius: 4px;
    background: transparent;
    color: #5f5c5c;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .ananas-side-cart__icon-btn:hover {
    border-color: #f7512b;
    color: #f7512b;
  }
  .ananas-side-cart__footer {
    flex: 0 0 auto;
    padding: 16px 24px;
    border-top: 1px solid #d4d4d4;
    background: #fcfaf7;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .ananas-side-cart__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    /*direction: rtl;*/
  }
  .ananas-side-cart__summary-copy {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 4px;
    min-width: 0;
    white-space: nowrap;
    flex-direction: column;
  }
  .ananas-side-cart__summary-total {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    /*direction: rtl;*/
    white-space: nowrap;
  }
  .ananas-side-cart__btn {
    flex: 1;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .ananas-side-cart__btn--outline {
    border: 1.5px solid #f97316;
    color: #f7512b;
    background: transparent;
  }
  .ananas-side-cart__btn--primary {
    background: #f7512b;
    color: #fff;
    border: none;
  }
  .ananas-side-cart__btn:hover {
    opacity: 0.8;
  }
  @keyframes sideCartPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .ananas-side-cart__item--skeleton {
    pointer-events: none;
  }
  html.side-cart-open,
  body.side-cart-open {
    overflow: hidden;
  }
  @media (max-width: 767px) {
    .ananas-side-cart__content {
      width: min(343px, 100vw);
    }
    .ananas-side-cart__footer {
      gap: 8px;
    }
    .ananas-side-cart__btn {
      height: 44px;
    }
    .ananas-side-cart__item-title {
      font-size: 14px;
      line-height: 20px;
    }
  }
</style>

<script>
  (function () {
    const drawer = document.getElementById("side-cart-drawer");
    const closeBtn = document.getElementById("side-cart-close-btn");
    const overlay = document.getElementById("side-cart-close-overlay");
    const itemsContainer = document.getElementById("side-cart-items");
    const totalEl = document.getElementById("side-cart-total");
    const countEl = document.getElementById("side-cart-count");
    if (!drawer) return;

    // Free shipping data comes from the cart API/dashboard rule.
    const shippingTextEl = document.getElementById("side-cart-shipping-text");
    const shippingRemainingEl = document.getElementById("side-cart-shipping-remaining");
    const shippingProgressEl = document.getElementById("side-cart-shipping-progress");
    const shippingWrapperEl = document.querySelector(".ananas-side-cart__shipping-wrapper");
    const initialFreeShippingRule = {{ cart.free_shipping_rule | default(none) | tojson }};
    const currencyCode = {{ session.currency | default('SAR') | tojson }};
    const sideCartTranslations = {
      freeShippingApplied: {{ _('Free shipping applied!') | tojson }},
      addMoreForFreeShipping: {{ _('Add purchases worth %(total)s %(currency)s to get free shipping') | tojson }},
      discountTemplate: {{ _('%(percent)s discount') | tojson }},
      options: {{ _('Options') | tojson }},
      cartEmpty: {{ _('Cart is empty') | tojson }},
      itemsInCart: {{ _('%(count)s items in cart') | tojson }}
    };

    let isRefreshing = false;
    let isMutating = false;
    let suppressCartEvents = 0;
    let cachedCartData = null;

    // Initialize free shipping bar on load
    drawer.inert = true;
    updateShippingBar(Number("{{ cart.total | default(0, true) }}") || 0, { free_shipping_rule: initialFreeShippingRule });

    // Pre-fetch cart data in background so it's ready when drawer opens
    function prefetchCartData() {
      if (!window.zid || !window.zid.cart) return;
      window.zid.cart.get().then(function (cartData) {
        cachedCartData = cartData;
      }).catch(function () {});
    }

    if (document.readyState === "complete") {
      setTimeout(prefetchCartData, 300);
    } else {
      window.addEventListener("load", function () { setTimeout(prefetchCartData, 300); });
    }

    function closeSideCart() {
      if (drawer.contains(document.activeElement)) {
        document.activeElement.blur();
      }
      drawer.classList.remove("is-active");
      drawer.setAttribute("aria-hidden", "true");
      drawer.inert = true;
      document.documentElement.classList.remove("side-cart-open");
      document.body.classList.remove("side-cart-open");
    }

    if (closeBtn) closeBtn.addEventListener("click", closeSideCart);
    if (overlay) overlay.addEventListener("click", closeSideCart);
    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && drawer.classList.contains("is-active")) {
        closeSideCart();
      }
    });

    function showSideCartLoading() {
      if (!itemsContainer) return;
      var hasItems = itemsContainer.querySelector(".ananas-side-cart__item");
      if (hasItems) return; // Already showing real items — don't flash skeleton
      itemsContainer.innerHTML = [1, 2].map(function () {
        return '<div class="ananas-side-cart__item ananas-side-cart__item--skeleton">' +
          '<div class="ananas-side-cart__item-img-wrap" style="background:#ece9e3;animation:sideCartPulse 1.2s ease-in-out infinite;"></div>' +
          '<div class="ananas-side-cart__item-info" style="gap:8px;">' +
            '<div style="height:12px;width:60%;background:#ece9e3;border-radius:4px;animation:sideCartPulse 1.2s ease-in-out infinite;"></div>' +
            '<div style="height:16px;width:85%;background:#ece9e3;border-radius:4px;animation:sideCartPulse 1.2s ease-in-out infinite 0.1s;"></div>' +
            '<div style="height:20px;width:40%;background:#ece9e3;border-radius:4px;animation:sideCartPulse 1.2s ease-in-out infinite 0.2s;"></div>' +
          '</div>' +
        '</div>';
      }).join("");
    }

    // Provide a global function to open
    window.openSideCart = function () {
      drawer.inert = false;
      drawer.classList.add("is-active");
      drawer.setAttribute("aria-hidden", "false");
      document.documentElement.classList.add("side-cart-open");
      document.body.classList.add("side-cart-open");
      showSideCartLoading();
      fetchCartData();
    };

    function getFreeShippingState(cartData, total) {
      const condition =
        cartData?.free_shipping_rule?.subtotal_condition ||
        cartData?.cart?.free_shipping_rule?.subtotal_condition ||
        null;

      if (condition) {
        const status = condition.status || "";
        const remaining = condition.remaining || condition.remaining_amount || "0";
        const percentage = status === "applied"
          ? 100
          : Math.max(0, Math.min(100, Number(condition.products_subtotal_percentage_from_min || 0)));
        return { status, remaining, percentage };
      }

      return null;
    }

    function updateShippingBar(total, cartData) {
      if (!shippingTextEl || !shippingProgressEl) return;

      const state = getFreeShippingState(cartData, total);
      if (!state) {
        if (shippingWrapperEl) shippingWrapperEl.classList.add("hidden");
        return;
      }

      if (shippingWrapperEl) shippingWrapperEl.classList.remove("hidden");

      if (state.status === "applied") {
        shippingTextEl.textContent = sideCartTranslations.freeShippingApplied;
        shippingProgressEl.style.width = "100%";
      } else {
        shippingTextEl.innerHTML = sideCartTranslations.addMoreForFreeShipping
          .replace("%(total)s", '<span id="side-cart-shipping-remaining">' + state.remaining + '</span>')
          .replace("%(currency)s", currencyCode);
        shippingProgressEl.style.width = state.percentage + "%";
      }
    }

    function formatMoney(amount) {
      return (
        normalizeNumber(amount).toLocaleString("en-US", {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }) + " " + currencyCode
      );
    }

    function escapeHtml(value) {
      return String(value ?? "").replace(/[&<>"']/g, function (char) {
        return {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;"
        }[char];
      });
    }

    function escapeAttr(value) {
      return escapeHtml(value).replace(/`/g, "&#96;");
    }

    function normalizeNumber(value) {
      if (value && typeof value === "object") {
        value = value.amount ?? value.value ?? value.formatted ?? value.string ?? 0;
      }
      if (typeof value === "number") return value;
      var cleaned = String(value || "")
        .replace(/,/g, "")
        .replace(/[^\d.-]/g, "");
      return parseFloat(cleaned) || 0;
    }

    function resolveImageUrl(value) {
      if (!value) return "";
      if (typeof value === "string") return value;
      return (
        value.url ||
        value.full_size ||
        value.medium ||
        value.thumbnail ||
        value.small ||
        value.image_url ||
        value.src ||
        value.path ||
        value.image?.url ||
        value.image?.full_size ||
        value.image?.medium ||
        value.image?.thumbnail ||
        value.image?.small ||
        value.image?.original ||
        value.image?.src ||
        value.image?.path ||
        value.data?.url ||
        value.data?.full_size ||
        value.data?.medium ||
        value.data?.thumbnail ||
        value.data?.image_url ||
        ""
      );
    }

    function getItemMeta(item) {
      return item.product?.categories?.[0]?.name || item.product?.category?.name || item.category?.name || "";
    }

    function asArray(value) {
      if (!value) return [];
      if (Array.isArray(value)) return value;
      if (Array.isArray(value.data)) return value.data;
      if (Array.isArray(value.items)) return value.items;
      return [];
    }

    function asOptionArray(value) {
      if (!value) return [];
      if (Array.isArray(value)) return value;
      if (Array.isArray(value.data)) return value.data;
      if (Array.isArray(value.items)) return value.items;
      if (typeof value === "object") {
        return Object.entries(value).map(function ([name, optionValue]) {
          return { name, value: optionValue };
        });
      }
      return [];
    }

    function pickOptionLabel(option) {
      return (
        option?.name ||
        option?.title ||
        option?.label ||
        option?.option?.name ||
        option?.option?.title ||
        option?.attribute?.name ||
        option?.attribute?.title ||
        option?.attribute_name ||
        option?.property_name ||
        ""
      );
    }

    function pickOptionValue(option) {
      const value = option?.value ?? option?.selected_value ?? option?.option_value ?? option?.value_name ?? option?.label;
      if (value && typeof value === "object") {
        return value.name || value.title || value.label || value.value || value.display_value || "";
      }
      return value || "";
    }

    function getItemOptions(item) {
      const sources = [
        item?.options,
        item?.product_options,
        item?.selected_options,
        item?.variant_options,
        item?.attributes,
        item?.selected_product?.attributes,
        item?.selected_product?.options,
        item?.variant?.attributes,
        item?.variant?.options,
        item?.product?.selected_options,
        item?.product?.selected_product?.options,
        item?.product?.selected_product?.option_values,
        item?.product?.selected_product?.attributes,
        item?.product?.variant?.attributes,
        item?.product?.attributes
      ];

      const options = [];
      sources.forEach(function (source) {
        asOptionArray(source).forEach(function (option) {
          const label = String(pickOptionLabel(option) || "").trim();
          const value = String(pickOptionValue(option) || "").trim();
          if (!value) return;
          const key = label + ":" + value;
          if (!options.some(function (existing) { return existing.key === key; })) {
            options.push({ key, label, value });
          }
        });
      });
      return options;
    }

    function getItemPriceText(item) {
      const numericPrice = item.price || item.product?.selected_product?.sale_price || item.product?.sale_price;
      if (numericPrice) return formatMoney(numericPrice);
      return (
        item.price_formatted ||
        item.price_string ||
        item.product?.selected_product?.formatted_sale_price ||
        item.product?.formatted_sale_price ||
        item.total_string ||
        item.total_formatted ||
        ""
      );
    }

    function getItemCompareText(item) {
      if (item.compare_at_price) return formatMoney(item.compare_at_price);
      return (
        item.compare_at_price_formatted ||
        item.compare_at_price_string ||
        (item.product?.selected_product?.formatted_sale_price ? item.product?.selected_product?.formatted_price : "") ||
        (item.product?.formatted_sale_price ? item.product?.formatted_price : "") ||
        ""
      );
    }

    function getDiscountLabel(item) {
      const direct =
        item.discount_percentage ||
        item.discount_percent ||
        item.product?.selected_product?.discount_percentage ||
        item.product?.discount_percentage;
      if (direct) return sideCartTranslations.discountTemplate.replace("%(percent)s", direct + "%");

      const price = normalizeNumber(
        item.price || item.product?.selected_product?.sale_price || item.product?.sale_price || getItemPriceText(item)
      );
      const compare = normalizeNumber(
        item.compare_at_price || item.product?.selected_product?.price || item.product?.price || getItemCompareText(item)
      );
      if (!compare || !price || compare <= price) return "";
      return sideCartTranslations.discountTemplate.replace("%(percent)s", Math.round(((compare - price) / compare) * 100) + "%");
    }

    function getItemImage(item) {
      return (
        resolveImageUrl(item.image_url) ||
        resolveImageUrl(item.image) ||
        resolveImageUrl(item.images?.[0]) ||
        resolveImageUrl(item.product?.image) ||
        resolveImageUrl(item.product?.image_url) ||
        resolveImageUrl(item.product?.main_image) ||
        resolveImageUrl(item.product?.images?.[0]) ||
        resolveImageUrl(item.product?.thumbnail) ||
        resolveImageUrl(item.thumbnail) ||
        resolveImageUrl(item.product?.media?.[0]) ||
        resolveImageUrl(item.product?.selected_product?.media?.[0]) ||
        resolveImageUrl(item.product?.selected_product?.images?.[0]) ||
        resolveImageUrl(item.selected_product?.media?.[0]) ||
        resolveImageUrl(item.selected_product?.images?.[0]) ||
        resolveImageUrl(item.variant?.media?.[0]) ||
        resolveImageUrl(item.variant?.images?.[0])
      );
    }

    function debugFirstCartItem(products) {
      if (!products || !products.length) return;
      var first = products[0];
      console.log("[SideCart debug] first cart item:", first);
      console.log("[SideCart debug] resolved image:", getItemImage(first));
      console.log("[SideCart debug] image candidates:", {
        image_url: first.image_url,
        image: first.image,
        images0: first.images?.[0],
        product_image: first.product?.image,
        product_image_url: first.product?.image_url,
        product_images0: first.product?.images?.[0],
        product_main_image: first.product?.main_image,
        selected_product_images0: first.product?.selected_product?.images?.[0],
        selected_product_media0: first.product?.selected_product?.media?.[0],
        thumbnail: first.thumbnail,
        product_thumbnail: first.product?.thumbnail,
        product_media0: first.product?.media?.[0]
      });
    }

    function getItemUrl(item) {
      return escapeAttr(
        item?.product?.url ||
        item?.product?.html_url ||
        item?.url ||
        item?.html_url ||
        ""
      );
    }

    function renderItem(item, products) {
      const id = item.id || item.product_id;
      const name = escapeHtml((item.product && item.product.name) || item.name || "");
      const meta = escapeHtml(getItemMeta(item));
      const comparePriceText = getItemCompareText(item);
      const price = escapeHtml(getItemPriceText(item));
      const comparePrice = comparePriceText ? escapeHtml(comparePriceText) : null;
      const qty = item.quantity || 1;
      const imgSrc = escapeAttr(getItemImage(item));
      const productId = escapeAttr((item.product && item.product.id) || item.product_id || id);
      const safeId = escapeAttr(id);
      const discountLabel = escapeHtml(getDiscountLabel(item));
      const optionsMarkup = renderOptions(item, products || []);
      const productUrl = getItemUrl(item);
      const topLine = meta || discountLabel
        ? `<div class="ananas-side-cart__item-topline">${meta ? `<p class="ananas-side-cart__item-meta">${meta}</p>` : "<span></span>"}${discountLabel ? `<span class="ananas-side-cart__discount font-expo">${discountLabel}</span>` : ""}</div>`
        : "";

      return `<div class="ananas-side-cart__item">
        <a class="ananas-side-cart__item-img-wrap" ${productUrl ? `href="${productUrl}"` : ""}>
          ${imgSrc ? `<img src="${imgSrc}" alt="${name}" class="ananas-side-cart__item-img">` : ""}
        </a>
        <div class="ananas-side-cart__item-info">
          <div class="flex justify-between items-start">
            <div class="font-expo">
              ${topLine}
              <a class="ananas-side-cart__item-title" ${productUrl ? `href="${productUrl}"` : ""}>${name}</a>
            </div>
          </div>
          <div class="ananas-side-cart__price-row">
            <span class="ananas-side-cart__item-price ${comparePrice ? "is-sale" : ""} font-expo">${price}</span>
            ${comparePrice ? `<span class="ananas-side-cart__compare-price font-expo">${comparePrice}</span>` : ""}
          </div>
          ${optionsMarkup}
          <div class="ananas-side-cart__item-actions">
            <div class="ananas-side-cart__qty">
              <button class="ananas-side-cart__qty-btn" type="button" data-side-cart-action="decrease" data-cart-item-id="${safeId}" data-cart-qty="${qty}">−</button>
              <input type="text" class="ananas-side-cart__qty-input font-expo" value="${qty}" readonly>
              <button class="ananas-side-cart__qty-btn" type="button" data-side-cart-action="increase" data-cart-item-id="${safeId}" data-cart-qty="${qty}">+</button>
            </div>
            <div class="ananas-side-cart__item-icons">
              <button type="button" class="ananas-side-cart__icon-btn"
                      data-wishlist-btn
                      data-product-id="${productId}"
                      aria-label="Add to wishlist">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3c2.09 0 3.96 1.15 4.9 2.87" />
                  <path d="M11 16h10" />
                  <path d="M14 13l-3 3 3 3" />
                </svg>
              </button>
              <button type="button" class="ananas-side-cart__icon-btn" data-side-cart-action="remove" data-cart-item-id="${safeId}" aria-label="Remove">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2M10 11v6M14 11v6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>`;
    }

    function getExistingItemImages() {
      var images = {};
      if (!itemsContainer) return images;

      itemsContainer.querySelectorAll(".ananas-side-cart__item").forEach(function (item) {
        var key =
          item.querySelector("[data-cart-item-id]")?.getAttribute("data-cart-item-id") ||
          item.querySelector("[data-product-id]")?.getAttribute("data-product-id");
        var src = item.querySelector(".ananas-side-cart__item-img")?.getAttribute("src");
        if (key && src) images[key] = src;
      });

      return images;
    }

    function hydrateMissingImages(products, existingImages) {
      return products.map(function (item) {
        if (getItemImage(item)) return item;
        var id = item.id || item.product_id;
        var productId = (item.product && item.product.id) || item.product_id || id;
        var cachedImage = existingImages[id] || existingImages[productId];
        if (!cachedImage) return item;
        return Object.assign({}, item, { image_url: cachedImage });
      });
    }

    const productImageCache = new Map();
    const productDetailsCache = new Map();

    function normalizeId(value) {
      return value === undefined || value === null ? "" : String(value);
    }

    function normalizeProductResponse(response) {
      return response?.product || response?.data?.product || response?.data || response;
    }

    function getItemIdCandidates(item) {
      return [
        item?.product?.selected_product?.id,
        item?.selected_product?.id,
        item?.variant?.id,
        item?.selected_product_id,
        item?.variant_id,
        item?.product_id,
        item?.product?.id,
        item?.parent_id,
        item?.id
      ]
        .map(normalizeId)
        .filter(Boolean);
    }

    function getProductFetchCandidates(item) {
      return [
        item?.product?.id,
        item?.parent_id,
        item?.product?.parent_id,
        item?.product?.selected_product?.product_id,
        item?.selected_product?.product_id,
        item?.product_id,
        item?.product?.selected_product?.id,
        item?.selected_product?.id,
        item?.variant?.id,
        item?.selected_product_id,
        item?.variant_id,
        item?.id
      ]
        .map(normalizeId)
        .filter(Boolean);
    }

    function getVariantList(product) {
      return [
        product?.selected_product,
        product?.variant,
        product?.selected_variant,
        ...asArray(product?.variants),
        ...asArray(product?.products),
        ...asArray(product?.selected_products),
        ...asArray(product?.options?.variants)
      ].filter(Boolean);
    }

    function matchProductVariant(item, product) {
      var itemIds = new Set(getItemIdCandidates(item));
      var itemSku = normalizeId(item?.sku || item?.product?.selected_product?.sku || item?.selected_product?.sku);

      return getVariantList(product).find(function (variant) {
        var variantIds = [variant?.id, variant?.product_id, variant?.selected_product_id, variant?.variant_id]
          .map(normalizeId)
          .filter(Boolean);
        if (variantIds.some(function (id) { return itemIds.has(id); })) return true;
        return itemSku && normalizeId(variant?.sku) === itemSku;
      });
    }

    function getProductDetailImage(product, variant) {
      return (
        resolveImageUrl(product?.images?.[0]) ||
        resolveImageUrl(product?.image) ||
        resolveImageUrl(product?.image_url) ||
        resolveImageUrl(product?.main_image) ||
        resolveImageUrl(product?.media?.[0]) ||
        resolveImageUrl(product?.thumbnail) ||
        resolveImageUrl(product?.selected_product?.media?.[0]) ||
        resolveImageUrl(product?.selected_product?.images?.[0]) ||
        resolveImageUrl(product?.selected_product?.image) ||
        resolveImageUrl(variant?.media?.[0]) ||
        resolveImageUrl(variant?.images?.[0]) ||
        resolveImageUrl(variant?.image) ||
        resolveImageUrl(variant?.image_url) ||
        resolveImageUrl(variant?.main_image) ||
        ""
      );
    }

    function getVariantId(variant) {
      return normalizeId(variant?.id || variant?.product_id || variant?.selected_product_id || variant?.variant_id);
    }

    function getVariantLabel(variant) {
      const attributes = asOptionArray(variant?.attributes || variant?.options || variant?.option_values)
        .map(function (option) { return pickOptionValue(option); })
        .filter(Boolean);
      return attributes.length ? attributes.join(" - ") : variant?.name || variant?.title || getVariantId(variant);
    }

    function getItemGroupKey(item) {
      return normalizeId(item?.product?.html_url || item?.product?.url || item?.url || item?.product?.id || "");
    }

    function itemToVariant(item) {
      return {
        id: item?.product_id || item?.product?.selected_product?.id || item?.selected_product_id || item?.variant_id || item?.id,
        name: item?.product?.name || item?.name || "",
        attributes: getItemOptions(item).map(function (option) {
          return { name: option.label, value: option.value };
        })
      };
    }

    function getSiblingVariants(item, products) {
      const groupKey = getItemGroupKey(item);
      if (!groupKey) return [];
      return products
        .filter(function (candidate) {
          return candidate !== item && getItemGroupKey(candidate) === groupKey;
        })
        .map(itemToVariant);
    }

    function renderOptions(item, products) {
      const variants = [...getVariantList(item?.product), ...getSiblingVariants(item, products || [])];
      const uniqueVariants = [];
      const seen = new Set();

      variants.forEach(function (variant) {
        const id = getVariantId(variant);
        if (!id || seen.has(id)) return;
        seen.add(id);
        uniqueVariants.push(variant);
      });

      if (uniqueVariants.length > 1) {
        const selectedVariant = matchProductVariant(item, item.product);
        const selectedId = getVariantId(selectedVariant) || normalizeId(item?.product_id || item?.selected_product_id || item?.variant_id);
        return `<div class="ananas-side-cart__options">
          <div class="ananas-side-cart__option">
            <select class="ananas-side-cart__variant-select" data-side-cart-variant-select data-cart-item-id="${escapeAttr(item.id || item.product_id)}" data-current-variant-id="${escapeAttr(selectedId)}">
              ${uniqueVariants.map(function (variant) {
                const id = getVariantId(variant);
                return `<option value="${escapeAttr(id)}"${id === selectedId ? " selected" : ""}>${escapeHtml(getVariantLabel(variant))}</option>`;
              }).join("")}
            </select>
            <span class="ananas-side-cart__option-label">${escapeHtml(sideCartTranslations.options)}:</span>
          </div>
        </div>`;
      }

      const options = getItemOptions(item);
      if (!options.length) return "";
      return `<div class="ananas-side-cart__options">
        ${options.map(function (option) {
          return `<div class="ananas-side-cart__option"><span>${escapeHtml(option.value)}</span>${option.label ? `<span class="ananas-side-cart__option-label">${escapeHtml(option.label)}:</span>` : ""}</div>`;
        }).join("")}
      </div>`;
    }

    async function fetchProductDetails(productId) {
      if (!productId || !window.zid?.products?.get) return null;
      var key = normalizeId(productId);
      if (productDetailsCache.has(key)) return productDetailsCache.get(key);
      try {
        const response = await window.zid.products.get(productId);
        const product = normalizeProductResponse(response);
        productDetailsCache.set(key, product || null);
        return product || null;
      } catch (err) {
        productDetailsCache.set(key, null);
        return null;
      }
    }

    async function fetchProductDetailsForItem(item) {
      var candidates = [...new Set(getProductFetchCandidates(item))];
      var fallbackProduct = null;
      for (var i = 0; i < candidates.length; i += 1) {
        var product = await fetchProductDetails(candidates[i]);
        if (!product) continue;
        if (getVariantList(product).length > 1) return product;
        if (!fallbackProduct && getProductDetailImage(product)) fallbackProduct = product;
      }
      return fallbackProduct;
    }

    function mergeProductDetails(item, product) {
      if (!product) return item;
      const variant = matchProductVariant(item, product);
      const selectedProduct = variant || product.selected_product || item?.product?.selected_product;
      return Object.assign({}, item, {
        product: Object.assign({}, item.product || {}, product, { selected_product: selectedProduct }),
        image_url: getProductDetailImage(product, variant) || item.image_url
      });
    }

    async function fetchImageFromProductsApi(productId, item) {
      const key = normalizeId(productId) + ":" + getItemIdCandidates(item || {}).join("|");
      if (productImageCache.has(key)) return productImageCache.get(key);

      const product = item ? await fetchProductDetailsForItem(item) : await fetchProductDetails(productId);
      const variant = item ? matchProductVariant(item, product) : null;
      const image = getProductDetailImage(product, variant);
      productImageCache.set(key, image);
      return image;
    }

    async function hydrateMissingImagesFromProductsApi(products) {
      if (!Array.isArray(products) || products.length === 0) return products;

      const updatedProducts = await Promise.all(
        products.map(async function (item) {
          if (getItemImage(item)) return item;

          const product = await fetchProductDetailsForItem(item);
          const enhancedItem = mergeProductDetails(item, product);
          const variant = matchProductVariant(item, product);
          const image = getProductDetailImage(product, variant);
          if (!image) return enhancedItem;

          return Object.assign({}, enhancedItem, { image_url: image });
        })
      );

      return updatedProducts;
    }

    function updateCartBadges(count) {
      document.querySelectorAll("[data-cart-badge]").forEach(function (badge) {
        if (count > 0) {
          badge.textContent = count > 99 ? "99+" : count;
          badge.removeAttribute("hidden");
        } else {
          badge.setAttribute("hidden", "");
        }
      });
    }

    function getProductsCount(cartData, products) {
      return (
        cartData?.products_count ?? cartData?.cart_items_quantity ?? cartData?.cart?.products_count ?? products.length
      );
    }

    function getCartTotalRaw(cartData) {
      return (
        cartData?.total ??
        cartData?.cart?.total ??
        cartData?.totals?.total ??
        cartData?.totals?.total_amount ??
        cartData?.total_amount ??
        0
      );
    }

    function getCartTotalFormatted(cartData) {
      return (
        cartData?.total_string ||
        cartData?.total_formatted ||
        cartData?.cart?.total_string ||
        cartData?.cart?.total_formatted ||
        cartData?.totals?.total_string ||
        cartData?.totals?.total_formatted ||
        formatMoney(getCartTotalRaw(cartData))
      );
    }

    function renderCartData(cartData, existingImages) {
      existingImages = existingImages || {};
      var products = hydrateMissingImages(cartData?.products || cartData?.cart?.products || [], existingImages);
      const productsCount = getProductsCount(cartData, products);
      const totalRaw = getCartTotalRaw(cartData);
      const totalFormatted = getCartTotalFormatted(cartData);

      if (itemsContainer) {
        if (products.length > 0) {
          itemsContainer.innerHTML = products.map(function (item) { return renderItem(item, products); }).join("");
        } else {
          itemsContainer.innerHTML = '<p class="text-center mt-8 text-gray-500 font-expo">' + escapeHtml(sideCartTranslations.cartEmpty) + '</p>';
        }
      }

      if (totalEl) totalEl.textContent = totalFormatted;
      if (countEl) countEl.textContent = "(" + sideCartTranslations.itemsInCart.replace("%(count)s", productsCount) + ")";
      updateCartBadges(productsCount);
      updateShippingBar(normalizeNumber(totalRaw), cartData);
      if (window.initWishlistButtons) window.initWishlistButtons();
      return products;
    }

    async function fetchCartData() {
      if (isRefreshing) return;
      isRefreshing = true;

      // If we have cached data, render it immediately for instant display
      if (cachedCartData) {
        var existingImages = getExistingItemImages();
        renderCartData(cachedCartData, existingImages);
      }

      var zidReady = window.zid && window.zid.cart;
      if (!zidReady) {
        // Wait up to 3s for zid to initialize
        await new Promise(function (resolve) {
          var attempts = 0;
          var interval = setInterval(function () {
            attempts += 1;
            if ((window.zid && window.zid.cart) || attempts >= 30) {
              clearInterval(interval);
              resolve();
            }
          }, 100);
        });
      }

      try {
        if (!window.zid || !window.zid.cart) return;
        const cartData = await window.zid.cart.get();
        cachedCartData = cartData;

        const existingImages = getExistingItemImages();
        let products = renderCartData(cartData, existingImages);
        products = await hydrateMissingImagesFromProductsApi(products);
        debugFirstCartItem(products);

        // Re-render with enhanced images after async fetch
        if (itemsContainer && products.length > 0) {
          itemsContainer.innerHTML = products.map(function (item) { return renderItem(item, products); }).join("");
          if (window.initWishlistButtons) window.initWishlistButtons();
        }

        return cartData;
      } catch (err) {
        console.error("Error refreshing side cart:", err);
      } finally {
        isRefreshing = false;
      }
    }

    function notifyCartUpdated(cartData) {
      const products = cartData?.products || cartData?.cart?.products || [];
      const count = getProductsCount(cartData, products);
      const detail = { cart: cartData, items_count: count };
      suppressCartEvents = 2;
      window.dispatchEvent(new CustomEvent("cart:updated", { detail, bubbles: true }));
      document.dispatchEvent(new CustomEvent("cart:updated", { detail, bubbles: true }));
      document.dispatchEvent(new CustomEvent("zid:cart:updated", { detail, bubbles: true }));
    }

    function showSideCartToast(key) {
      var labels = window.cartToastTranslations || {};
      var fallbacks = {
        addedToCart: "Product added to cart",
        removedFromCart: "Product removed from cart"
      };
      var message = labels[key] || fallbacks[key];

      if (window.zid && window.zid.store && window.zid.store.showMessage) {
        window.zid.store.showMessage(message, "success");
        return;
      }

      if (window.showAnanasToast) {
        window.showAnanasToast(message, "success");
        return;
      }

      window.dispatchEvent(new CustomEvent("toast:show", { detail: { message: message, type: "success" } }));
    }

    function setItemLoading(button, isLoading) {
      var item = button && button.closest(".ananas-side-cart__item");
      if (!item) return;
      item.querySelectorAll("button").forEach(function (btn) {
        btn.disabled = isLoading;
      });
      item.querySelectorAll("select").forEach(function (select) {
        select.disabled = isLoading;
      });
    }

    async function mutateCart(id, qty, trigger) {
      if (!window.zid || !window.zid.cart || !id || isMutating) return;
      isMutating = true;
      if (trigger) setItemLoading(trigger, true);

      try {
        if (qty <= 0) {
          await window.zid.cart.removeProduct({ product_id: id }, { showErrorNotification: true });
        } else {
          await window.zid.cart.updateProduct({ product_id: id, quantity: qty }, { showErrorNotification: true });
        }

        const cartData = await fetchCartData();
        if (cartData) notifyCartUpdated(cartData);
        if (qty <= 0) showSideCartToast("removedFromCart");
      } catch (err) {
        console.error("Error updating side cart item:", err);
      } finally {
        isMutating = false;
        if (trigger) setItemLoading(trigger, false);
      }
    }

    async function changeSideCartVariant(select) {
      if (!window.zid || !window.zid.cart || isMutating) return;

      var nextVariantId = select.value;
      var currentVariantId = select.getAttribute("data-current-variant-id") || "";
      var cartItemId = select.getAttribute("data-cart-item-id");
      var item = select.closest(".ananas-side-cart__item");
      var qty = Number(item?.querySelector(".ananas-side-cart__qty-input")?.value) || 1;

      if (!nextVariantId || nextVariantId === currentVariantId || !cartItemId) return;

      isMutating = true;
      setItemLoading(select, true);

      try {
        await window.zid.cart.addProduct({ product_id: nextVariantId, quantity: qty }, { showErrorNotification: true });
        await window.zid.cart.removeProduct({ product_id: cartItemId }, { showErrorNotification: true });

        const cartData = await fetchCartData();
        if (cartData) notifyCartUpdated(cartData);
      } catch (err) {
        console.error("Error changing side cart variant:", err);
        select.value = currentVariantId;
      } finally {
        isMutating = false;
        setItemLoading(select, false);
      }
    }

    if (itemsContainer) {
      itemsContainer.addEventListener("click", function (event) {
        var button = event.target.closest("[data-side-cart-action]");
        if (!button) return;

        var action = button.getAttribute("data-side-cart-action");
        var id = button.getAttribute("data-cart-item-id");
        var qty = Number(button.getAttribute("data-cart-qty")) || 1;

        if (action === "increase") mutateCart(id, qty + 1, button);
        if (action === "decrease") mutateCart(id, Math.max(1, qty - 1), button);
        if (action === "remove") mutateCart(id, 0, button);
      });

      itemsContainer.addEventListener("change", function (event) {
        var select = event.target.closest("[data-side-cart-variant-select]");
        if (!select) return;
        changeSideCartVariant(select);
      });
    }

    window.updateSideCartItem = async function (id, qty) {
      await mutateCart(id, qty);
    };

    window.removeSideCartItem = async function (id) {
      await mutateCart(id, 0);
    };

    // Listen to generic cart update events
    function handleExternalCartUpdated() {
      if (suppressCartEvents > 0) {
        suppressCartEvents -= 1;
        return;
      }
      fetchCartData();
    }

    window.addEventListener("cart:updated", handleExternalCartUpdated);
    document.addEventListener("cart:updated", handleExternalCartUpdated);
    window.addEventListener("zidcart:updated", handleExternalCartUpdated);
  })();
</script>
