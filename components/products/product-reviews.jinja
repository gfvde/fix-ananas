{#
  Product Reviews Component

  Props:
  - product: Product object with:
    - rating.average: number
    - rating.total_count: number
    - rating.ratings_5.count, ratings_4.count, etc.
    - reviews.results: array of review objects
    - reviews.pages_count: number
  - store: Store object
  - session: Session object (for guest check)
#}
{% if product %}
  {# Time Ago Labels for JS #}
  <script
    type="application/json"
    data-time-ago-labels
  >
    {
      "year": "{{ _('year') }}",
      "years": "{{ _('years') }}",
      "month": "{{ _('month') }}",
      "months": "{{ _('months') }}",
      "week": "{{ _('week') }}",
      "weeks": "{{ _('weeks') }}",
      "day": "{{ _('day') }}",
      "days": "{{ _('days') }}",
      "hour": "{{ _('hour') }}",
      "hours": "{{ _('hours') }}",
      "minute": "{{ _('minute') }}",
      "minutes": "{{ _('minutes') }}",
      "ago": "{{ _('%s ago') }}",
      "justNow": "{{ _('Just now') }}"
    }
  </script>

  <div class="pdp-reviews">
    {# Summary: overall rating, distribution, write-a-review #}
    <aside class="pdp-reviews__summary">
      <h3 class="pdp-reviews__heading">{{ _("Overall rating") }}</h3>
      {% if product.rating %}
        <div class="pdp-reviews__score">
          <span class="pdp-reviews__avg">{{ product.rating.average|round(1) }}</span>
          {% with rating=product.rating.average, size=22 %}
            {% include 'components/rating-stars.jinja' %}
          {% endwith %}
        </div>
        <p class="pdp-reviews__count">{{ product.rating.total_count or 0 }} {{ _("reviews") }}</p>

        {% set total_reviews = product.rating.total_count or 1 %}
        <ul class="pdp-reviews__bars">
          {% for i in range(5, 0, -1) %}
            {% set rating_data = product.rating['ratings_' ~ i] %}
            {% set count = rating_data.count if rating_data else 0 %}
            {% set percentage = (count / total_reviews * 100) if total_reviews > 0 else 0 %}
            <li class="pdp-reviews__bar">
              <span class="pdp-reviews__bar-label">{{ i }} {{ _("star") if i == 1 else _("stars") }}</span>
              <span class="pdp-reviews__bar-track"><span style="width: {{ percentage|round(1) }}%"></span></span>
              <span class="pdp-reviews__bar-count">{{ count }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      <div class="pdp-reviews__cta">
        <p>{{ _("Your opinion matters... share your experience with us") }}</p>
        {# Write Review Button - Guest version (shown via JS) #}
        <button
          type="button"
          class="pdp-btn pdp-btn--outline-dark"
          data-login-redirect="{{ url_for('add_product_review', slug=product.id) }}"
          data-auth-guest
        >
          {{ _("Add your review") }}
        </button>
        {# Write Review Button - Authenticated version (shown via JS) #}
        <a
          href="{{ url_for('add_product_review', slug=product.slug) }}"
          class="pdp-btn pdp-btn--outline-dark hidden"
          data-auth-user
        >
          {{ _("Add your review") }}
        </a>
      </div>
    </aside>

    {# Reviews list #}
    <div class="pdp-reviews__list">
      <h3 class="pdp-reviews__heading">{{ _("Customer reviews") }}</h3>
      {% if product.reviews and product.reviews.results %}
        <div class="pdp-reviews__items">
          {% for review in product.reviews.results %}
            {% with review=review, store=store %}
              {% include 'components/products/review-card.jinja' %}
            {% endwith %}
          {% endfor %}
        </div>

        {% if product.reviews.pages_count > 1 %}
          <a href="{{ url_for('product_reviews', slug=product.id) }}" class="pdp-reviews__more">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="8.25" stroke="currentColor" stroke-width="1.5"/>
              <path d="M12.5 7.5 7.5 12.5m0 0h4m-4 0v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{{ _("Show more") }}</span>
          </a>
        {% endif %}
      {% else %}
        <p class="pdp-muted">{{ _("There are no reviews yet. Be the first one to review this product") }}</p>
      {% endif %}
    </div>
  </div>

  <script src="{{ 'js/time-ago.js' | asset_url }}"></script>
{% endif %}
