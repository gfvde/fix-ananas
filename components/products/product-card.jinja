    background: #F7512B !important;
    color: #FFFFFF !important;
  }
  .pc-notify-btn:hover {
    background: #D64625 !important;
  }

  /* Hide icon/label sub-elements by default (desktop shows plain text) */
  .pc-cta__icon  { display: none; }
  .pc-cta__label { display: inline; }

  /* ── Mobile CTA button inside wrapper ── */
  .pc-cta-wrap-mb .pc-cta {
    background: transparent !important;
    border: 1px solid #000 !important;
    color: #000 !important;
    font-weight: 400;
    border-radius: 0; /* Figma seems to have sharp corners or very subtle rounding */
  }
  .pc-cta-wrap-mb .pc-notify-btn {
    background: transparent !important;
    color: #000000 !important;
    border: 1px solid #000 !important;
  }
  .pc-cta-wrap-mb .pc-notify-btn:hover {
    background: #D64625 !important;
  }

  /* ── Static CTA ── */
  .pc-static-cta {
    display: none;
    align-items: center;
    justify-content: center;
    width: 175px;
    min-height: 40px;
    padding: 8px 12px;
    border: 1px solid #000;
    background: transparent;
    color: #000;
    font-size: clamp(0.75rem, 0.6735rem + 0.3265vw, 1rem);
