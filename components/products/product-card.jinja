    line-height: 24px;
    cursor: pointer;
    text-decoration: none;
  }
  .pc-card--figma-products .pc-static-cta {
    display: inline-flex;
  }

  /* DESKTOP (min-width: 768px)
     Hover overlay visible, mobile wrapper hidden */
  @media (min-width: 768px) {
    .pc-cta-wrap    { display: block; }
    .pc-cta-wrap-mb { display: none !important; }

    /* Desktop button is always full-width inside its parent */
    .pc-cta-wrap-mb .pc-cta {
      width: 100%;
    }

    /* Restore icon/label for desktop — only text matters */
    .pc-cta__icon  { display: none; }
    .pc-cta__label { display: inline; }
  }

  /* MOBILE (max-width: 767px)
     Hover overlay hidden, mobile wrapper visible */
  @media (max-width: 767px) {
    .pc-cta-wrap { display: none !important; }
    .pc-cta-wrap-mb { display: flex; }
  }


  /* ── Info ── */
  .pc-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .pc-card--unified .pc-info {
    flex-grow: 1;
  }

  .pc-name {
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    color: #000;
    margin: 0;
    width: 100%;
  }
  @media (min-width: 768px) {
    .pc-name {
      font-size: 14px;
      line-height: 20px;
    }
  }
  .pc-name--truncate {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pc-name a {
    color: inherit;
    text-decoration: none;
  }
  .pc-name a:hover {
    text-decoration: underline;
  }

  /* Flavor tags */

  .pc-tag {
    background: #f0f0f0;
    color: #737373;
    font-size: 11px;
    font-weight: 500;
    line-height: 16px;
    padding: 4px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }

  /* Rating */
  .pc-rating {
    display: flex;
    align-items: center;
    gap: 4px;
    justify-content: center;
  }
  .pc-rating__score {
    font-size: 16px;
    font-weight: 500;
    color: #000;
    line-height: 24px;
  }
  .pc-rating__count {
    font-size: 14px;
    font-weight: 500;
    color: #000;
    line-height: 20px;
  }

  /* Price */
  .pc-price-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    justify-content: center;
  }
  .pc-price {
    font-size: 20px;
    font-weight: 500;
    color: #000;
    line-height: 28px;
  }
  .pc-price--old {
    font-size: 14px;
    color: #737373;
    text-decoration: line-through;
    line-height: 20px;
  }
  .pc-discount {
    font-size: 12px;
    font-weight: 500;
    color: #e63b2e;
    background: rgba(230, 59, 46, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* Description (list view) */
  .pc-desc {
    font-size: 14px;
    color: #737373;
    line-height: 20px;
    margin: 0;
    
    -webkit-box-orient: vertical;
  }

  /* Notify button */
  .pc-notify-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    background: #ffffff !important;
    border: none;
    cursor: pointer;
    padding: 8px 12px;
    font-size: 16px;
    font-weight: 500;
    color: #000000 !important;
    white-space: nowrap;
    line-height: 24px;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .pc-notify-btn:hover {
    background: #D64625 !important;
    color: #ffffff !important;
  }
  .pc-cta-wrap-mb .pc-notify-btn {
   
  }
  /* ── List view overrides ── */
  [data-grid="list"] .pc-card {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: 1fr auto;
    gap: 16px;
  }
  [data-grid="list"] .pc-img-wrap {
    aspect-ratio: 1/1;
    width: 160px;
    grid-row: 1 / 3;
  }
  [data-grid="list"] .pc-info {
    align-items: flex-start;
    text-align: right;
    padding: 0;
  }
  [data-grid="list"] .pc-name,
  [data-grid="list"] .pc-rating,
  [data-grid="list"] .pc-price-wrap,
  [data-grid="list"] .pc-tags {
    justify-content: flex-start;
    text-align: right;
  }

  /* ────────────────────────────────────────────────
   Stock info component
──────────────────────────────────────────────── */

/* ── Stock info: flip between sold & qty ── */
.pc-stock {
  position: relative;
  height: 20px;
  width: 100%;
  overflow: hidden;
}

.pc-stock-sold,
.pc-stock-qty {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  white-space: nowrap;
}

.pc-stock-sold,
.pc-stock-qty {
  position: absolute;
  inset: 0;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.45s ease, transform 0.45s ease;
  pointer-events: none;
}

.pc-stock-sold {
  color: #737373;
}

.pc-stock-qty {
  color: #F7512B;
}

.pc-stock-sold.active,
.pc-stock-qty.active {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

body[data-pc-align="center"] .pc-stock-sold,
body[data-pc-align="center"] .pc-stock-qty { justify-content: center; }

body[data-pc-align="start"] .pc-stock-sold,
body[data-pc-align="start"] .pc-stock-qty { justify-content: flex-start; }

[dir="ltr"] .pc-stock-sold,
[dir="ltr"] .pc-stock-qty { justify-content: flex-start; }

/* ── Tags infinite loop ── */
.pc-tags-container {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
}

.pc-tags-scroll-btn {
  display: none; /* Hidden by default, shown via JS if overflow exists */
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10; /* High z-index to stay above mask and track */
  background: #F5F5F5;
  border: none;
  width: 16px;
  height: 24px;
  padding: 0;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  border-radius: 4px;
  color: #525252;
  box-shadow: none;
  opacity: 1;
  transition: all 0.2s;
  pointer-events: auto;
}

.pc-tags-scroll-btn:hover {
  background: #E5E5E5;
  transform: translateY(-50%) scale(1.05);
}

.pc-tags-wrapper {
  width: 100%;
  overflow-x: auto !important;
  overflow-y: hidden;
  cursor: grab;
  scrollbar-width: none;
  -ms-overflow-style: none;
  position: relative;
  z-index: 1;
  pointer-events: auto;
  /* fade edges */
  -webkit-mask-image: linear-gradient(to left, transparent 0%, black 12%, black 88%, transparent 100%);
  mask-image: linear-gradient(to left, transparent 0%, black 12%, black 88%, transparent 100%);
}

.pc-tags-wrapper:active {
  cursor: grabbing;
}

.pc-tags-wrapper::-webkit-scrollbar {
  display: none;
}

.pc-tags-track {
  display: flex;
  gap: 0;
  width: max-content;
  /* مفيش animation هنا خالص */
}

/* الـ animation يشتغل بس لما الـ loop مفعل والـ hover على الكارد */
.pc-card:hover .pc-tags-track[data-loop="true"] {
  animation: pc-tags-scroll 12s linear infinite;
}

/* لو مش hover — واقف حتى لو loop مفعل */
.pc-tags-track[data-loop="true"] {
  animation: none;
}

.pc-card:hover .pc-tags-track[data-loop="true"] {
  animation: pc-tags-scroll 12s linear infinite;
}

/* لو loop مش مفعل — مفيش animation خالص */
.pc-tags-track[data-loop="false"] {
  animation: none;
}

@keyframes pc-tags-scroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-25%); }
}

.pc-tag {
  background: #f0f0f0;
  color: #737373;
  font-size: 11px;
  font-weight: 500;
  line-height: 16px;
  white-space: nowrap;
  flex-shrink: 0;
  padding: 4px 8px;
  border-radius: 4px;
}
@media (max-width:768px) {
  .qty_mob{
    display: none;
  }
}

/* Aspect ratio per-section override (hardcoded on specific sections) */
.pc-img-wrap[data-aspect="square"]   { aspect-ratio: 1 / 1 !important; }
.pc-img-wrap[data-aspect="portrait"] { aspect-ratio: 3 / 4 !important; }
.pc-img-wrap[data-aspect="landscape"]{ aspect-ratio: 4 / 3 !important; }
.pc-img-wrap[data-aspect="adapt"]    { aspect-ratio: auto !important; }
</style>

<script>
window.productcard  = {{ product | tojson | safe }};
console.log('window.productcard',window.productcard);
(function () {
  // Fake sold count: stable hash from product id string
  function hashId(str) {
    var h = 0;
    for (var i = 0; i < str.length; i++) {
      h = (h * 31 + str.charCodeAt(i)) >>> 0;
    }
    return h;
  }

  function initFakeSold() {
    if (document.body.dataset.pcFakeSold !== 'true') return;
    var soldLabel = (window.productTranslations && window.productTranslations.soldThisMonth) || 'Sold %s pieces this month';
    var min = parseInt(document.body.dataset.pcFakeMin) || 100;
    var max = parseInt(document.body.dataset.pcFakeMax) || 1000;
    if (max < min) { var temp = min; min = max; max = temp; }

    document.querySelectorAll('[data-fake-sold]').forEach(function (el) {
      var id = el.dataset.fakeSold;
      var num = (hashId(id) % (max - min + 1)) + min;
      var text = el.querySelector('[data-fake-sold-text]');
      if (text) text.textContent = soldLabel.replace('%s', num.toLocaleString());
      el.classList.add('pc-stock-sold--ready');
    });
  }

  function initStockFlip(container) {
    var soldEl = container.querySelector(".pc-stock-sold");
    // Skip fake sold spans that haven't been populated (setting disabled)
    var sold = (soldEl && (!soldEl.classList.contains('pc-stock-sold--fake') || soldEl.classList.contains('pc-stock-sold--ready'))) ? soldEl : null;
    var qty  = container.querySelector(".pc-stock-qty");
    var items = [sold, qty].filter(Boolean);
    if (items.length === 0) { container.hidden = true; return; }
    if (items.length === 1) { items[0].classList.add("active"); return; }

    var current = 0;
    items[0].classList.add("active");
    setInterval(function () {
      items[current].classList.remove("active");
      current = (current + 1) % items.length;
      items[current].classList.add("active");
    }, 2500);
  }

  function initTagsArrows() {
    document.querySelectorAll('.pc-tags-container').forEach(function(container) {
      var wrapper = container.querySelector('.pc-tags-wrapper');
      var btn = container.querySelector('.pc-tags-scroll-btn');
      if (!wrapper || !btn) return;
      
      // If looping is active, it's always "overflowing" because of duplicate sets.
      // But we check if the wrapper itself is actually scrollable relative to its content.
      if (wrapper.scrollWidth > wrapper.clientWidth + 2) {
        btn.style.display = 'flex';
      } else {
        btn.style.display = 'none';
      }
    });
  }

  function initAll() {
    initFakeSold();
    initTagsArrows();
    document.querySelectorAll(".pc-stock:not([data-flip-init])").forEach(function(c) {
      c.dataset.flipInit = '1';
      initStockFlip(c);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll);
  } else {
    initAll();
  }

  window.addEventListener("content:loaded", initAll);
})();
</script>

