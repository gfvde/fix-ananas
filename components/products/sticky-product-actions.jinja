{# Preorder (port of upstream deb8912): can_be_preordered keeps the CTA for out-of-stock variants #}
{% set sticky_selected = product.selected_product if product.selected_product else product %}
{% set sticky_in_stock = sticky_selected.in_stock if sticky_selected.in_stock is defined else product.in_stock %}
{% set sticky_can_buy = sticky_in_stock or product.can_be_preordered %}
<div
  id="sticky-cta"
  class="pdp-sticky bg-[#FAF7F2] border-border-light fixed inset-x-0 bottom-0 z-40 hidden border-t px-4 py-4 transition-transform transition-discrete duration-300 md:px-16 starting:translate-y-full"
  data-sticky-cta
  aria-hidden="true"
>
  <div class="theme-container">
    <div class="flex items-center gap-4">
      {# Product Image #}
      <div class="size-16 shrink-0 overflow-hidden rounded hidden md:block">
        {% if product.images and product.images|length > 0 %}
          {% set img_src = product.images[0].image.thumbnail if product.images[0].image else product.images[0] %}
          <img
            src="{{ image_url(img_src, w=128, q=85, f='auto') }}"
            alt="{{ product.name }}"
            class="size-full object-cover"
            data-sticky-cta-image
          />
        {% else %}
          <div class="bg-background size-full"></div>
        {% endif %}
      </div>

      {# Product Info #}
      <div class="hidden md:flex min-w-0 flex-1 items-center gap-4">
        <div class="min-w-0 flex-1">
          {# Product Name #}
          <h3
            class="text-foreground text-sm font-medium truncate"
            data-sticky-cta-name
          >
            {{ product.name }}
          </h3>
          {# Selected Options #}
          <p
            class="text-muted text-xs uppercase tracking-wide truncate"
            data-sticky-cta-options
          >
            {# Will be populated by JS when variant changes #}
          </p>
        </div>

        {# Price #}
        <div class="shrink-0 pdp-sticky__price">
          <span
            class="text-foreground font-medium"
            data-sticky-cta-price
          >
            {{ product.formatted_sale_price if product.formatted_sale_price else product.formatted_price }}
          </span>
          {% if product.formatted_sale_price %}
            <span class="pdp-price-old" data-product-price-old>{{ product.formatted_price }}</span>
          {% endif %}
        </div>
      </div>

      {# In Stock State #}
      
      <div
        class="{{ 'hidden' if not sticky_can_buy }} flex flex-1  items-center gap-4"
        data-sticky-cta-in-stock
      >
        {# Quantity Input #}
        <div class="{{ 'hidden' if not sticky_in_stock }} shrink-0" data-sticky-quantity-wrapper>
          {% with id='sticky-qty', name='sticky_quantity', sync_target='product-quantity' %}
            {% include 'components/ui/quantity-input.jinja' %}
          {% endwith %}
        </div>

        {# Add to Cart Button #}
        <button
          type="button"
          class="btn btn-lg shrink-0 transition-all duration-200 flex-grow pdp-btn pdp-btn--primary"
          data-sticky-cta-add-to-cart
        >
          {# Default state #}
          <span
            class="inline-flex items-center gap-2"
            data-sticky-cta-btn-default
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="hidden sm:block"
            >
              <circle
                cx="8"
                cy="21"
                r="1"
              ></circle>
              <circle
                cx="19"
                cy="21"
                r="1"
              ></circle>
              <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
            </svg>
            <span>{{ _("Preorder now") if product.preorder_campaign else _("Add to cart") }}</span>
            <span class="pdp-sticky__btn-price" data-product-price>{{ product.formatted_sale_price if product.formatted_sale_price else product.formatted_price }}</span>
          </span>
          {# Loading state #}
          <span
            class="hidden items-center gap-2"
            data-sticky-cta-btn-loading
          >
            <svg
              class="size-5 animate-spin"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M21 12a9 9 0 1 1-6.219-8.56" />
            </svg>
          </span>
          {# Success state #}
          <span
            class="hidden items-center gap-2"
            data-sticky-cta-btn-success
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{{ _("Added!") }}</span>
          </span>
        </button>
      </div>

      {# Out of Stock State #}
      <div
        class="{{ 'hidden' if sticky_can_buy }} flex items-center gap-2"
        data-sticky-cta-out-of-stock
      >
        {# Notify Me Button #}
        <button
          type="button"
          class="btn btn-lg shrink-0 pdp-btn pdp-btn--primary"
          data-notify-me-trigger="{{ product.selected_product.id if product.selected_product else product.id }}"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden sm:block"
          >
            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
          </svg>
          <span>{{ _("Notify me when available") }}</span>
        </button>
      </div>
    </div>
  </div>
</div>
