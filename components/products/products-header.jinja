{#
  Products header: filters drawer (advanced filters: availability, sale,
  price, attributes, sorting) and the applied filter badges.
  The visible toolbar is components/products/filters/sidebar-topbar.jinja; the
  drawer is opened by the toolbar (drawer layout) or the "All filters" chip.
#}
{% set filters=products.filters %}

<div class="products-header plp-header flex flex-col">
  <div class="products-header__drawer-source plp-drawer-source" data-plp-drawer-source>
    {% include 'components/products/filters/advanced-filters.jinja' %}
  </div>

  {% include 'components/products/filters/applied-filters.jinja' %}
</div>
