{#
  PLP toolbar (Dara filter bar, Figma 11150:17839 / 11571:29491):
  [filter toggle + chevron] [showing x - y of z] ........ [sort]

  The filter toggle (assets/js/dara/plp-filters.js) collapses/expands the
  sidebar on desktop, opens the drawer in the "drawer" layout and shows/hides
  the filter chips row on mobile and in the "topbar" layout.
  Styles: assets/css/dara/plp-listing.css
#}
{% set toolbar_layout = toolbar_layout | default('sidebar') %}
{% set current_sort_by = session.query_params.get('sort_by') or 'popularity_order' %}
{% set current_order = session.query_params.get('order') or 'asc' %}
{% set current_sort_label = _('Sort: Most requested') %}
{% if current_sort_by == 'created_at' and current_order == 'desc' %}
  {% set current_sort_label = _('Sort: Newest') %}
{% elif current_sort_by == 'price' and current_order == 'asc' %}
  {% set current_sort_label = _('Sort: Price low to high') %}
{% elif current_sort_by == 'price' and current_order == 'desc' %}
  {% set current_sort_label = _('Sort: Price high to low') %}
{% endif %}
{% set page_size = (session.query_params.get('page_size') or 24)|int %}
{% set current_page = products.page|default(1)|int %}
{% set products_total = products.count|default(0)|int %}
{% set products_current = products.results|length if products and products.results else 0 %}
{% set products_start = ((current_page - 1) * page_size) + 1 if products_total > 0 else 0 %}
{% set products_end = products_start + products_current - 1 if products_current > 0 else 0 %}

<div class="products-sidebar-topbar plp-toolbar plp-toolbar--{{ toolbar_layout }}">
  <button
    class="products-sidebar-topbar__filter plp-toolbar__filter"
    type="button"
    data-plp-filter-toggle
    aria-expanded="true"
    aria-label="{{ _('Filter') }}"
  >
    <span class="plp-toolbar__label">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6.46154 12H17.5385M4 7H20M10.1538 17H13.8462" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{{ _('Filter') }}</span>
    </span>
    <svg class="plp-toolbar__chevron plp-toolbar__chevron--filter" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M7 15L12 10L17 15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div class="products-sidebar-topbar__count plp-toolbar__count" data-products-range-count>
    {{ _('Showing %(start)s - %(end)s of %(total)s') | format(start=products_start, end=products_end, total=products_total) }}
  </div>

  <form class="products-sidebar-topbar__sort plp-toolbar__sort" method="get" onsubmit="return false">
    <label>
      <span class="plp-toolbar__label">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5.83333 13.3333V3.33333M9.16667 6.66667L5.83333 3.33333L2.5 6.66667M14.1667 6.66667V16.6667M10.8333 13.3333L14.1667 16.6667L17.5 13.3333" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="plp-toolbar__sort-current">{{ current_sort_label }}</span>
        <span class="plp-toolbar__sort-short">{{ _('Sort by') }}</span>
      </span>
      <svg class="plp-toolbar__chevron" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <select onchange="window.productFilter.handleSortChange(this.value)" aria-label="{{ _('Sort by') }}">
        <option value="popularity_order-asc" {% if current_sort_by == 'popularity_order' and current_order == 'asc' %}selected{% endif %}>{{ _('Sort: Most requested') }}</option>
        <option value="created_at-desc" {% if current_sort_by == 'created_at' and current_order == 'desc' %}selected{% endif %}>{{ _('Sort: Newest') }}</option>
        <option value="price-asc" {% if current_sort_by == 'price' and current_order == 'asc' %}selected{% endif %}>{{ _('Sort: Price low to high') }}</option>
        <option value="price-desc" {% if current_sort_by == 'price' and current_order == 'desc' %}selected{% endif %}>{{ _('Sort: Price high to low') }}</option>
      </select>
    </label>
  </form>
</div>
