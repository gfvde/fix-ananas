{% set current_sort_by = session.query_params.get('sort_by') or 'popularity_order' %}
{% set current_order = session.query_params.get('order') or 'asc' %}
{% set current_sort_label = _('Sort: Most requested') %}
{% if current_sort_by == 'created_at' and current_order == 'desc' %}
  {% set current_sort_label = _('Sort: Newest') %}
{% elif current_sort_by == 'price' and current_order == 'asc' %}
  {% set current_sort_label = _('Sort: Price low to high') %}
{% elif current_sort_by == 'price' and current_order == 'desc' %}
  {% set current_sort_label = _('Sort: Price high to low') %}
{% endif %}
{% set page_size = (session.query_params.get('page_size') or 24)|int %}
{% set current_page = products.page|default(1)|int %}
{% set products_total = products.count|default(0)|int %}
{% set products_current = products.results|length if products and products.results else 0 %}
{% set products_start = ((current_page - 1) * page_size) + 1 if products_total > 0 else 0 %}
{% set products_end = products_start + products_current - 1 if products_current > 0 else 0 %}

<div class="products-sidebar-topbar hidden lg:grid">
  <form class="products-sidebar-topbar__sort" method="get" onsubmit="return false" >
    <label>
      <span class="products-sidebar-topbar__sort-current">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M6 3v14m0 0 3-3m-3 3-3-3M14 17V3m0 0 3 3m-3-3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{{ current_sort_label }}</span>
      </span>
      <svg class="products-sidebar-topbar__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <select onchange="window.productFilter.handleSortChange(this.value)" aria-label="{{ _('Sort by') }}">
        <option value="popularity_order-asc" {% if current_sort_by == 'popularity_order' and current_order == 'asc' %}selected{% endif %}>{{ _('Sort: Most requested') }}</option>
        <option value="created_at-desc" {% if current_sort_by == 'created_at' and current_order == 'desc' %}selected{% endif %}>{{ _('Sort: Newest') }}</option>
        <option value="price-asc" {% if current_sort_by == 'price' and current_order == 'asc' %}selected{% endif %}>{{ _('Sort: Price low to high') }}</option>
        <option value="price-desc" {% if current_sort_by == 'price' and current_order == 'desc' %}selected{% endif %}>{{ _('Sort: Price high to low') }}</option>
      </select>
    </label>
  </form>

  <div class="products-sidebar-topbar__count"  data-products-range-count>
    {{ _('Showing %(start)s - %(end)s of %(total)s') | format(start=products_start, end=products_end, total=products_total) }}
  </div>

  <button class="products-sidebar-topbar__filter" type="button" >
    <span>{{ _('Filter') }}</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 7h16M8 12h8M11 17h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </button>
</div>

<style>
  .products-sidebar-topbar {
    display: none;
    grid-template-columns: 200px minmax(0, 1fr) 144px;
    align-items: center;
    width: 100%;
    height: 36px;
    margin: 16px 0;
    border: 1px solid var(--border);
    background: var(--background);
  }

  @media (min-width: 1024px) {
    .products-sidebar-topbar {
      display: grid !important;
    }
  }

  .products-sidebar-topbar > * {
    min-height: 34px;
    border: 0;
    background: var(--background);
  }

  .products-sidebar-topbar__sort {
    grid-column: 1;
    border-right: 1px solid var(--border);
  }

  .products-sidebar-topbar__sort label,
  .products-sidebar-topbar__filter,
  .products-sidebar-topbar__count {
    display: flex;
    position: relative;
    height: 100%;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding: 7px 16px;
    color: var(--foreground);
    font-size: 14px;
    line-height: 20px;
    white-space: nowrap;
  }
  [dir="ltr"] .products-sidebar-topbar__sort label,
  [dir="ltr"] .products-sidebar-topbar__filter, [dir="ltr"] .products-sidebar-topbar__count {
    /*justify-content: flex-start;*/
  }

  .products-sidebar-topbar__sort select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
    color: transparent;
    outline: none;
    opacity: 0;
    appearance: none;
    font: inherit;
    cursor: pointer;
  }

  .products-sidebar-topbar__sort-current {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }

  .products-sidebar-topbar__sort-current span {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .products-sidebar-topbar__sort svg,
  .products-sidebar-topbar__filter svg {
    flex: 0 0 auto;
  }

  .products-sidebar-topbar__chevron {
    margin-inline-start: auto;
  }

  .products-sidebar-topbar__count {
    grid-column: 2;
    min-width: 0;
  }

  .products-sidebar-topbar__filter {
    flex-direction: row;
    grid-column: 3;
    justify-content: flex-end;
    border-left: 1px solid var(--border);
    border-right: 0;
  }
  html[dir="ltr"] .products-sidebar-topbar__filter{
    flex-direction: row-reverse;
    justify-content: flex-start;
    border-right: 1px solid var(--border);
    border-left: 0;
  }
  html[dir="ltr"] .products-sidebar-topbar__sort{
    border-right: 0;
    border-left: 1px solid var(--border);
  }
</style>
