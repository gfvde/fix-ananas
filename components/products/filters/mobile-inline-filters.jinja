{#
  Filter chips row (Dara, Figma 11150:17839 / 11571:29491 / 11150:17829).
  Shown under the PLP toolbar on mobile (all layouts) and on desktop in the
  "topbar" layout. It is collapsed/expanded by the toolbar filter toggle.
  Styles: assets/css/dara/plp-listing.css
#}
{% set filters=products.filters %}
{% set products_total = products.count|default(0)|int %}
{% set chips_from_price = session.query_params.get('from_price') if session and session.query_params else '' %}
{% set chips_to_price = session.query_params.get('to_price') if session and session.query_params else '' %}

<div class="mobile-inline-filters plp-chips">
  <div class="mobile-inline-filters__chips plp-chips__row" aria-label="{{ _('Filters') }}" data-plp-chips>
    {% if filters and filters.attributes %}
      {% for attribute in filters.attributes %}
        {% if attribute.is_enabled and attribute.data | length > 0 %}
          {% set attr_key = 'attributes[' ~ attribute.slug ~ '][]' %}
          {% set selected_values = session.query_params.getlist(attr_key) if session and session.query_params else [] %}
          <div class="plp-chip{% if selected_values %} is-active{% endif %}">
            <details class="mobile-inline-filter" data-plp-chip>
              <summary>
                <span>{{ attribute.name }}{% if selected_values %} ({{ selected_values | length }}){% endif %}</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <form
                class="mobile-inline-filter__panel"
                method="get"
                data-clear-empty-param="attributes[{{ attribute.slug }}][]"
                onsubmit="return window.productFilter.submitDrawerForm(event)"
              >
                <div class="mobile-inline-filter__options">
                  {% for option in attribute.data %}
                    <label>
                      <input
                        type="checkbox"
                        name="attributes[{{ attribute.slug }}][]"
                        value="{{ option.value }}"
                        {% if option.value in selected_values %}checked{% endif %}
                      >
                      {% if option.type == 'color' and option.type_value %}
                        <span class="plp-swatch" style="background-color: {{ option.type_value }};" aria-hidden="true"></span>
                      {% endif %}
                      <span>{{ option.value }}</span>
                    </label>
                  {% endfor %}
                </div>
                <div class="mobile-inline-filter__actions">
                  <button type="submit">{{ _("Apply") }}</button>
                </div>
              </form>
            </details>
            {% if selected_values %}
              <button
                type="button"
                class="plp-chip__clear"
                data-plp-chip-clear="{{ attr_key }}"
                aria-label="{{ _('Remove filter') }}: {{ attribute.name }}"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 7l10 10M17 7 7 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}

    <div class="plp-chip{% if chips_from_price or chips_to_price %} is-active{% endif %}">
      <details class="mobile-inline-filter" data-plp-chip>
        <summary>
          <span>{{ _("Price") }}</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <form class="mobile-inline-filter__panel" method="get" onsubmit="return window.productFilter.handlePriceSubmit(event, 'price_min_mobile_inline', 'price_max_mobile_inline')">
          {%
            with
            slider_id='price-slider-mobile-inline',
            min_input_id='price_min_mobile_inline',
            max_input_id='price_max_mobile_inline'
          %}
            {% include 'components/products/filters/price-filter.jinja' %}
          {% endwith %}
          <div class="mobile-inline-filter__actions">
            <button type="submit">{{ _("Apply") }}</button>
          </div>
        </form>
      </details>
      {% if chips_from_price or chips_to_price %}
        <button
          type="button"
          class="plp-chip__clear"
          data-plp-chip-clear="from_price,to_price"
          aria-label="{{ _('Remove filter') }}: {{ _('Price') }}"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M7 7l10 10M17 7 7 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      {% endif %}
    </div>

    {# Availability, sale and sorting live in the filters drawer #}
    <div class="plp-chip plp-chip--all">
      <button type="button" class="plp-chip__all" data-plp-open-drawer>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6.46154 12H17.5385M4 7H20M10.1538 17H13.8462" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{{ _("All filters") }}</span>
      </button>
    </div>
  </div>

  <div class="mobile-inline-filters__result-count plp-chips__count" data-products-total-count>
    {{ _('%(count)s results') | format(count=products_total) }}
  </div>
</div>
