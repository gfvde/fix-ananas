{#
  =========================================================
  Product Gallery Component — Swiper.js v11 (CDN)
  =========================================================
  Parameters:
    - product      : product object (images / selected_product.media)
    - gallery_id   : unique ID string (optional)
    - badges       : array of badge strings (optional)

  Config (from layout.schema.json → product_gallery group):
    - layout.thumbnail_layout   : "vertical" | "horizontal"  (default: "vertical")
    - layout.thumbnail_position : "start" | "end"            (default: "start")
    - layout.enable_loop        : true | false               (default: false)
    - layout.enable_keyboard    : true | false               (default: true)
  =========================================================
#}

{# ── Unique ID ─────────────────────────────────────────── #}
{% set gallery_id = gallery_id | default('pg-' ~ range(1000, 9999) | random) %}

{# ── Read settings from layout.schema ─────────────────── #}
{% set thumb_layout   = settings.product_gallery_thumbnail_layout   | default('vertical') %}
{% set thumb_position = settings.product_gallery_thumbnail_position | default('start') %}
{% set enable_loop    = settings.product_gallery_enable_loop        | default(false) %}
{% set enable_kb      = settings.product_gallery_enable_keyboard    | default(true) %}

{# ── Media source ─────────────────────────────────────── #}
{% set gallery_media = product.selected_product.media
   if product.selected_product and product.selected_product.media and product.selected_product.media | length > 0
   else product.images %}
{% set media_count = gallery_media | length if gallery_media else 0 %}
{% set has_multiple = media_count > 1 %}

{# ── Swiper CDN — NO defer so it's available for the inline init script ── #}
{% if not swiper_cdn_loaded %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
{% endif %}

{# ── Hidden Lightbox Gallery (PhotoSwipe compatible) ───── #}
<div id="{{ gallery_id }}-lightbox" class="hidden" aria-hidden="true">
  {% if gallery_media %}
    {% for item in gallery_media %}
      {% if not (item.provider and item.link) %}
        {% set full_src = item.image.full_size if item.image else item %}
        <a
          href="{{ image_url(full_src, w=1600, q=90, f='auto') }}"
          data-pswp-width="1600"
          data-pswp-height="2133"
        >
          <img
            src="{{ image_url(full_src, w=200, q=80, f='auto') }}"
            alt="{{ product.name }} - {{ _('Image') }} {{ loop.index }}"
            data-lightbox-item
            data-lightbox-src="{{ image_url(full_src, w=1600, q=90, f='auto') }}"
            data-lightbox-width="1600"
            data-lightbox-height="2133"
          />
        </a>
      {% endif %}
    {% endfor %}
  {% endif %}
</div>

{# ══════════════════════════════════════════════════════════
   WRAPPER — controls layout via data attributes
   ══════════════════════════════════════════════════════════ #}
<div
  class="pg-wrapper"
  data-thumb-layout="{{ thumb_layout }}"
  data-thumb-pos="{{ thumb_position }}"
  data-gallery-id="{{ gallery_id }}"
  id="{{ gallery_id }}-wrapper"
>

  {# ────────────────────────────────────────────────────────
     VERTICAL THUMBNAILS  (desktop only, hidden on mobile)
     ──────────────────────────────────────────────────────── #}
  {% if has_multiple %}
  <div class="pg-thumbs" id="{{ gallery_id }}-thumbs-v" aria-label="{{ _('Image thumbnails') }}">
    {# Swiper prev arrow (top) #}
    <div
      class="pg-thumbs__prev"
      id="{{ gallery_id }}-thumbs-v-prev"
      role="button"
      aria-label="{{ _('Scroll thumbnails up') }}"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 15l-6-6-6 6"/>
      </svg>
    </div>

    {# Swiper container #}
    <div class="swiper" id="{{ gallery_id }}-swiper-thumbs-v">
      <div class="swiper-wrapper">
        {% for item in gallery_media %}
          {% set thumb_src = item.image.thumbnail if item.image else item %}
          {% set is_video = item.provider and item.link %}
          <div
            class="swiper-slide pg-thumbs__slide"
            role="button"
            tabindex="0"
            aria-label="{{ _('Thumbnail') }} {{ loop.index }}"
          >
            <img
              src="{{ image_url(thumb_src, w=120, q=80, f='auto') }}"
              alt="{{ _('Thumbnail') }} {{ loop.index }}"
              loading="lazy"
            />
            {% if is_video %}
              <span class="pg-thumb__video-badge" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="18" height="18">
                  <path d="M8 5.14v14l11-7-11-7z"/>
                </svg>
              </span>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    {# Swiper next arrow (bottom) #}
    <div
      class="pg-thumbs__next"
      id="{{ gallery_id }}-thumbs-v-next"
      role="button"
      aria-label="{{ _('Scroll thumbnails down') }}"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </div>
  </div>
  {% endif %}

  {# ────────────────────────────────────────────────────────
     MAIN SWIPER
     ──────────────────────────────────────────────────────── #}
  <div class="pg-main" id="{{ gallery_id }}-main">

    {# Badges overlay #}
    {% if badges %}
      <div class="pg-badges" aria-hidden="true">
        {% for badge in badges %}
          <span class="pg-badge">{{ badge }}</span>
        {% endfor %}
      </div>
    {% endif %}

    {# Main Swiper container #}
    <div class="swiper" id="{{ gallery_id }}-swiper-main">
      <div class="swiper-wrapper">

        {% if gallery_media and media_count > 0 %}
          {% for item in gallery_media %}
            {% set img_src = item.image.medium if item.image else item %}
            {% set is_video = item.provider and item.link %}

            <div class="swiper-slide pg-main__slide" data-index="{{ loop.index0 }}">

              {# Image #}
              <img
                src="{{ image_url(img_src, w=750, q=85, f='auto') }}"
                srcset="
                  {{ image_url(img_src, w=400,  q=85, f='auto') }}  400w,
                  {{ image_url(img_src, w=640,  q=85, f='auto') }}  640w,
                  {{ image_url(img_src, w=750,  q=85, f='auto') }}  750w,
                  {{ image_url(img_src, w=960,  q=85, f='auto') }}  960w,
                  {{ image_url(img_src, w=1200, q=85, f='auto') }} 1200w
                "
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 75vw, 50vw"
                alt="{{ item.alt_text | default(product.name ~ ' - ' ~ _('Image') ~ ' ' ~ loop.index) }}"
                class="{{ 'cursor-zoom-in' if not is_video else '' }}"
                {% if not is_video %}data-lightbox-trigger="{{ loop.index0 }}"{% endif %}
                {% if loop.index > 1 %}loading="lazy"{% endif %}
              />

              {# ── Video Slide ── #}
              {% if is_video %}
                <button
                  class="pg-slide__video-overlay"
                  type="button"
                  data-video-play
                  data-video-src="{{ item.link }}"
                  aria-label="{{ _('Play video') }}"
                >
                  <span class="pg-slide__play-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="30" height="30" style="margin-left:4px; color:#0B0A09;">
                      <path d="M8 5.14v14l11-7-11-7z"/>
                    </svg>
                  </span>
                </button>

                <div class="pg-slide__video-container hidden" data-video-container>
                  <button
                    type="button"
                    class="pg-slide__video-close"
                    data-video-close
                    aria-label="{{ _('Close video') }}"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                      <path d="M18 6L6 18M6 6l12 12"/>
                    </svg>
                  </button>
                  <iframe
                    src=""
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    aria-label="{{ _('Product video') }}"
                  ></iframe>
                </div>
              {% endif %}

            </div>{# /swiper-slide #}
          {% endfor %}

        {% else %}
          {# Graceful fallback — no images #}
          <div class="swiper-slide pg-main__slide">
            <img
              src="{{ 'images/placeholder.png' | asset_url }}"
              alt="{{ product.name }}"
            />
          </div>
        {% endif %}

      </div>{# /swiper-wrapper #}

      {# Navigation Arrows (inside main swiper) #}
      {% if has_multiple %}
        <div class="swiper-button-prev" id="{{ gallery_id }}-main-prev" aria-label="{{ _('Previous image') }}"></div>
        <div class="swiper-button-next" id="{{ gallery_id }}-main-next" aria-label="{{ _('Next image') }}"></div>
      {% endif %}

    </div>{# /swiper #}

    {# Progress bar — shown on mobile #}
    {% if has_multiple %}
      <div class="pg-progress" aria-hidden="true" id="{{ gallery_id }}-progress">
        <div class="pg-progress__bar" id="{{ gallery_id }}-progress-bar"></div>
      </div>
    {% endif %}

  </div>{# /pg-main #}

  {# ────────────────────────────────────────────────────────
     HORIZONTAL THUMBNAILS (below image)
     Shown in horizontal mode on desktop, always on mobile
     ──────────────────────────────────────────────────────── #}
  {% if has_multiple %}
  <div class="pg-thumbs-h" id="{{ gallery_id }}-thumbs-h" aria-label="{{ _('Image thumbnails') }}">
    <div class="swiper" id="{{ gallery_id }}-swiper-thumbs-h">
      <div class="swiper-wrapper">
        {% for item in gallery_media %}
          {% set thumb_src = item.image.thumbnail if item.image else item %}
          {% set is_video  = item.provider and item.link %}
          <div
            class="swiper-slide pg-thumbs-h__slide"
            role="button"
            tabindex="0"
            aria-label="{{ _('Thumbnail') }} {{ loop.index }}"
          >
            <img
              src="{{ image_url(thumb_src, w=100, q=80, f='auto') }}"
              alt="{{ _('Thumbnail') }} {{ loop.index }}"
              loading="lazy"
            />
            {% if is_video %}
              <span class="pg-thumb__video-badge" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="16" height="16">
                  <path d="M8 5.14v14l11-7-11-7z"/>
                </svg>
              </span>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}

</div>{# /pg-wrapper #}

{# ══════════════════════════════════════════════════════════
   INITIALIZATION SCRIPT
   ══════════════════════════════════════════════════════════ #}
<script>
(function () {
  'use strict';

  // Safely parse template variables with proper defaults
  var PG_CONFIG = {
    galleryId   : '{{ gallery_id }}',
    thumbLayout : '{{ thumb_layout }}',
    thumbPos    : '{{ thumb_position }}',
    loop        : {{ 'true' if enable_loop else 'false' }},
    keyboard    : {{ 'true' if enable_kb else 'false' }},
    mediaCount  : {{ media_count if media_count is defined else 0 }}
  };

  // Debug log to verify config
  console.log('PG_CONFIG:', PG_CONFIG);

  function waitForSwiper(cb) {
    if (typeof Swiper !== 'undefined') {
      cb();
      return;
    }

    var tries = 0;
    var maxTries = 100;
    var t = setInterval(function () {
      if (typeof Swiper !== 'undefined') {
        clearInterval(t);
        cb();
      } else if (++tries >= maxTries) {
        clearInterval(t);
        console.error('Swiper failed to load within timeout');
      }
    }, 50);
  }

  function getYouTubeEmbedUrl(url) {
    if (!url || typeof url !== 'string') return url;
    var m = url.match(
      /(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/(?:[^\/\n\s]+\/\S+\/|(?:v|e(?:mbed)?|.*[?&]v=)|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/
    );
    return m ? 'https://www.youtube.com/embed/' + m[1] + '?autoplay=1&enablejsapi=1' : url;
  }

  function initVideoControls(galleryNode, mainSwiper) {
    if (!galleryNode) return;

    // Use event delegation for video controls
    galleryNode.addEventListener('click', function (e) {
      // Handle play button
      var play = e.target.closest('[data-video-play]');
      if (play) {
        e.preventDefault();
        e.stopPropagation();
        
        var slide = play.closest('.pg-main__slide');
        if (!slide) return;
        
        var container = slide.querySelector('[data-video-container]');
        var iframe = container && container.querySelector('iframe');
        
        if (!container || !iframe) return;

        var videoSrc = play.getAttribute('data-video-src');
        iframe.src = getYouTubeEmbedUrl(videoSrc);
        container.classList.remove('hidden');
        play.classList.add('hidden');
        return;
      }

      // Handle close button
      var close = e.target.closest('[data-video-close]');
      if (close) {
        e.preventDefault();
        e.stopPropagation();
        
        var container = close.closest('[data-video-container]');
        var slide = close.closest('.pg-main__slide');
        var iframe = container && container.querySelector('iframe');
        var playBtn = slide && slide.querySelector('[data-video-play]');

        if (iframe) iframe.src = '';
        if (container) container.classList.add('hidden');
        if (playBtn) playBtn.classList.remove('hidden');
        return;
      }
    });

    // Stop videos on slide change
    if (mainSwiper) {
      mainSwiper.on('slideChangeTransitionStart', function () {
        galleryNode.querySelectorAll('[data-video-container]').forEach(function (c) {
          var iframe = c.querySelector('iframe');
          var slide = c.closest('.pg-main__slide');
          var playBtn = slide && slide.querySelector('[data-video-play]');
          
          if (iframe) iframe.src = '';
          c.classList.add('hidden');
          if (playBtn) playBtn.classList.remove('hidden');
        });
      });
    }
  }

  function updateProgress(swiper, barEl) {
    if (!barEl || !swiper || swiper.destroyed) return;

    // Handle both loop and non-loop modes
    var totalSlides = swiper.slides.length;
    if (swiper.params.loop) {
      totalSlides = swiper.slides.length - (swiper.loopedSlides * 2 || 2);
    }
    
    totalSlides = Math.max(totalSlides - 1, 1);
    var progress = swiper.realIndex / totalSlides;
    
    barEl.style.width = (Math.min(Math.max(progress, 0), 1) * 100) + '%';
  }

  function initGallery() {
    var id = PG_CONFIG.galleryId;
    
    // Validate ID
    if (!id) {
      console.error('Gallery ID is undefined');
      return;
    }
    
    var wrapper = document.getElementById(id + '-wrapper');
    if (!wrapper) {
      console.warn('Gallery wrapper not found:', id + '-wrapper');
      return;
    }

    // Get navigation elements
    var mainPrevEl = document.getElementById(id + '-main-prev');
    var mainNextEl = document.getElementById(id + '-main-next');
    var thumbVPrev = document.getElementById(id + '-thumbs-v-prev');
    var thumbVNext = document.getElementById(id + '-thumbs-v-next');

    // Validate main swiper container exists
    var mainSwiperEl = document.getElementById(id + '-swiper-main');
    if (!mainSwiperEl) {
      console.error('Main swiper container not found');
      return;
    }

    /* Initialize Thumbs V Swiper */
    var thumbsVSwiper = null;
    if (PG_CONFIG.mediaCount > 1) {
      var thumbsVEl = document.getElementById(id + '-swiper-thumbs-v');
      if (thumbsVEl) {
        var configV = {
          direction: 'vertical',
          slidesPerView: 7,
          spaceBetween: 8,
          freeMode: true,
          watchSlidesProgress: true,
          observer: true,
          observeParents: true,
          breakpoints: {
            0: {
              direction: 'horizontal',
              slidesPerView: 5,
              spaceBetween: 6
            },
            1024: {
              direction: 'vertical',
              slidesPerView: 7,
              spaceBetween: 8
            }
          }
        };

        // Only add navigation if elements exist
        if (thumbVPrev && thumbVNext) {
          configV.navigation = {
            prevEl: thumbVPrev,
            nextEl: thumbVNext
          };
        }

        try {
          thumbsVSwiper = new Swiper('#' + id + '-swiper-thumbs-v', configV);
          console.log('Thumbs V Swiper initialized');
        } catch (error) {
          console.error('Error initializing Thumbs V Swiper:', error);
        }
      }
    }

    /* Initialize Thumbs H Swiper */
    var thumbsHSwiper = null;
    if (PG_CONFIG.mediaCount > 1) {
      var thumbsHEl = document.getElementById(id + '-swiper-thumbs-h');
      if (thumbsHEl) {
        try {
          thumbsHSwiper = new Swiper('#' + id + '-swiper-thumbs-h', {
            direction: 'horizontal',
            slidesPerView: 5,
            spaceBetween: 8,
            freeMode: true,
            watchSlidesProgress: true,
            observer: true,
            observeParents: true,
            breakpoints: {
              0: {
                slidesPerView: 5,
                spaceBetween: 6
              },
              768: {
                slidesPerView: 6,
                spaceBetween: 8
              },
              1024: {
                slidesPerView: 7,
                spaceBetween: 10
              }
            }
          });
          console.log('Thumbs H Swiper initialized');
        } catch (error) {
          console.error('Error initializing Thumbs H Swiper:', error);
        }
      }
    }

    function getActiveThumbsSwiper() {
      var isDesktop = window.innerWidth >= 1024;
      var isVertical = PG_CONFIG.thumbLayout === 'vertical';
      
      // On desktop with vertical layout, prefer vertical thumbs
      if (isDesktop && isVertical && thumbsVSwiper && !thumbsVSwiper.destroyed) {
        return thumbsVSwiper;
      }
      
      // Fallback to horizontal thumbs
      if (thumbsHSwiper && !thumbsHSwiper.destroyed) {
        return thumbsHSwiper;
      }
      
      // If both are unavailable, try vertical again
      if (thumbsVSwiper && !thumbsVSwiper.destroyed) {
        return thumbsVSwiper;
      }
      
      return null;
    }

    var progressBar = document.getElementById(id + '-progress-bar');

    /* Initialize Main Swiper - WITH RETRY LOGIC & NAVIGATION FIX */
    var mainSwiper = null;
    var initRetries = 0;
    var initMaxRetries = 5;

    function tryInitializeMainSwiper() {
      initRetries++;
      
      try {
        // 🔧 Re-fetch navigation elements (might not exist yet on first try)
        if (!mainPrevEl) {
          mainPrevEl = document.getElementById(id + '-main-prev');
          console.log('Re-fetching prev button:', mainPrevEl ? '✅ Found' : '❌ Not found');
        }
        if (!mainNextEl) {
          mainNextEl = document.getElementById(id + '-main-next');
          console.log('Re-fetching next button:', mainNextEl ? '✅ Found' : '❌ Not found');
        }

        var mainConfig = {
          loop: PG_CONFIG.loop,
          spaceBetween: 0,
          observer: true,
          observeParents: true,
          keyboard: PG_CONFIG.keyboard ? { 
            enabled: true, 
            onlyInViewport: true 
          } : false,
          on: {
            init: function () {
              console.log('✅ Main Swiper init event fired');
              updateProgress(this, progressBar);
              
              // 🔧 CRITICAL: Force update navigation after init
              // This ensures Swiper properly binds to the button elements
              if (this.navigation) {
                console.log('📍 Navigation module exists, updating...');
                this.navigation.update();
                console.log('✅ Navigation force-updated');
              } else {
                console.warn('⚠️  Navigation module not found');
              }
            },
            slideChange: function () {
              updateProgress(this, progressBar);
            }
          }
        };

        // Add navigation only if elements exist
        if (mainPrevEl && mainNextEl) {
          mainConfig.navigation = {
            prevEl: mainPrevEl,
            nextEl: mainNextEl
          };
          console.log('✅ Navigation configured in mainConfig');
        } else {
          console.warn('⚠️  Navigation elements still not found - will retry');
          
          // Retry if not found
          if (initRetries < initMaxRetries) {
            console.log(`📌 Retry ${initRetries}/${initMaxRetries} after 100ms`);
            setTimeout(tryInitializeMainSwiper, 100);
            return;
          } else {
            console.error('❌ Max retries reached, navigation may not work');
          }
        }

        // Add thumbs only if we have a thumbs swiper
        var activeThumbs = getActiveThumbsSwiper();
        if (activeThumbs) {
          mainConfig.thumbs = {
            swiper: activeThumbs
          };
          console.log('✅ Thumbs linked');
        }

        // Create Swiper instance
        mainSwiper = new Swiper('#' + id + '-swiper-main', mainConfig);
        console.log('✅ Main Swiper instance created');
        
      } catch (error) {
        console.error('❌ Error initializing Main Swiper:', error);
        
        // Retry on error
        if (initRetries < initMaxRetries) {
          console.log(`📌 Retrying after error (${initRetries}/${initMaxRetries})`);
          setTimeout(tryInitializeMainSwiper, 100);
          return;
        }
      }
    }

    // Start initialization with retry logic
    tryInitializeMainSwiper();

    // Initialize video controls
    initVideoControls(wrapper, mainSwiper);

    /* Bind thumbnail click handlers */
    function bindThumbClicks(containerEl) {
      if (!containerEl) return;

      containerEl.addEventListener('click', function (e) {
        var slide = e.target.closest('.swiper-slide');
        if (!slide || !mainSwiper || mainSwiper.destroyed) return;

        var slides = Array.from(containerEl.querySelectorAll('.swiper-slide'));
        var idx = slides.indexOf(slide);

        if (idx !== -1) {
          if (PG_CONFIG.loop) {
            mainSwiper.slideToLoop(idx);
          } else {
            mainSwiper.slideTo(idx);
          }
        }
      });

      // Add keyboard support for accessibility
      containerEl.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        
        var slide = e.target.closest('.swiper-slide');
        if (!slide || !mainSwiper || mainSwiper.destroyed) return;

        e.preventDefault();
        var slides = Array.from(containerEl.querySelectorAll('.swiper-slide'));
        var idx = slides.indexOf(slide);

        if (idx !== -1) {
          if (PG_CONFIG.loop) {
            mainSwiper.slideToLoop(idx);
          } else {
            mainSwiper.slideTo(idx);
          }
        }
      });
    }

    // Bind clicks to both thumb containers
    var thumbsVContainer = document.getElementById(id + '-swiper-thumbs-v');
    var thumbsHContainer = document.getElementById(id + '-swiper-thumbs-h');
    
    bindThumbClicks(thumbsVContainer);
    bindThumbClicks(thumbsHContainer);

    /* Handle resize events */
    var resizeTimer;
    var handleResize = function () {
      clearTimeout(resizeTimer);
      
      resizeTimer = setTimeout(function () {
        if (!mainSwiper || mainSwiper.destroyed) return;

        var newThumbs = getActiveThumbsSwiper();

        if (newThumbs && mainSwiper.thumbs && mainSwiper.thumbs.swiper !== newThumbs) {
          mainSwiper.thumbs.swiper = newThumbs;
          mainSwiper.thumbs.init();
          mainSwiper.thumbs.update(true);
        }

        // Update progress bar
        updateProgress(mainSwiper, progressBar);
      }, 250);
    };

    window.addEventListener('resize', handleResize);

    // Store instances for cleanup
    window.__pgInstances = window.__pgInstances || {};
    window.__pgInstances[id] = {
      main: mainSwiper,
      thumbsV: thumbsVSwiper,
      thumbsH: thumbsHSwiper,
      handleResize: handleResize,
      destroy: function() {
        if (mainSwiper && !mainSwiper.destroyed) mainSwiper.destroy(true, true);
        if (thumbsVSwiper && !thumbsVSwiper.destroyed) thumbsVSwiper.destroy(true, true);
        if (thumbsHSwiper && !thumbsHSwiper.destroyed) thumbsHSwiper.destroy(true, true);
        window.removeEventListener('resize', handleResize);
        delete window.__pgInstances[id];
      }
    };
  }

  function bootstrap() {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        waitForSwiper(initGallery);
      });
    } else {
      waitForSwiper(initGallery);
    }
  }

  bootstrap();

})();
</script>