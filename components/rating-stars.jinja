{#
  Rating Stars Component

  Props:
  - rating: number (0-5)
  - size: number (default 24) - size in pixels
#}

{% set star_size = size or 24 %}

{% if rating is not none %}
  {% set ratingRounded = ((rating * 2) | round(0, 'ceil')) / 2 %}
  <div class="flex gap-0.5">
    {% for n in range(1, 6) %}
      {% if n <= ratingRounded %}
        {# Full star #}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="{{ star_size }}"
          height="{{ star_size }}"
          viewBox="0 0 24 24"
          fill="none"
          class="text-warning"
        >
          <path
            d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"
            fill="currentColor"
          />
        </svg>
      {% elif n <= ratingRounded + 0.5 %}
        {# Half star #}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="{{ star_size }}"
          height="{{ star_size }}"
          viewBox="0 0 24 24"
          fill="none"
        >
          <defs>
            <linearGradient id="half-star-{{ n }}">
              <stop
                offset="50%"
                stop-color="var(--color-warning)"
              />
              <stop
                offset="50%"
                stop-color="var(--color-muted-foreground)"
              />
            </linearGradient>
          </defs>
          <path
            d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"
            fill="url(#half-star-{{ n }})"
          />
        </svg>
      {% else %}
        {# Empty star #}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="{{ star_size }}"
          height="{{ star_size }}"
          viewBox="0 0 24 24"
          fill="none"
          class="text-muted-foreground"
        >
          <path
            d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"
            fill="currentColor"
          />
        </svg>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}
