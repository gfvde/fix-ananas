{# Mobile benefits: Loyalty + UVPs + Payment methods (mirrors sidebar cart-benefits) #}
{% set cart_settings = settings %}
{% set is_guest_customer = safeget(session, 'is_guest', true) %}
{% set feature_title_color = safeget(cart_settings, 'cart_page_feature_title_color', '#000000') %}
{% set feature_subtitle_color = safeget(cart_settings, 'cart_page_feature_subtitle_color', '#52525C') %}
{% set loyalty_bg = safeget(cart_settings, 'cart_page_loyalty_background_color', '#F5F5F5') %}
{% set loyalty_text = safeget(cart_settings, 'cart_page_loyalty_text_color', '#0D0702') %}
{% set features = safeget(cart_settings, 'cart_page_features', []) %}
{% set payment_methods = safeget(cart_settings, 'cart_page_payment_methods', []) %}

<div
  class="cart-mobile-benefits"
  style="
    --cart-feature-title: {{ feature_title_color }};
    --cart-feature-subtitle: {{ feature_subtitle_color }};
    --cart-loyalty-bg: {{ loyalty_bg }};
    --cart-loyalty-text: {{ loyalty_text }};
  "
>
  {# Loyalty points #}
  {% if store.settings.checkout.is_loyalty_enabled | default(false) %}
    <div class="cart-loyalty" data-loyalty-section>
      <div class="cart-loyalty__top">
        <strong>+ <span data-loyalty-calculated-points>0</span> {{ _('points') }}</strong>
        <span class="cart-loyalty__label">
          <svg class="cart-loyalty__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6.2 15.8C7.7 18.8 10.6 20.7 14 20.7C17.9 20.7 21.1 17.6 21.1 13.7C21.1 9.8 17.9 6.7 14 6.7C10.8 6.7 8.1 8.8 7.2 11.7" stroke="#FFB22E" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M3.3 14.8C4.7 14.2 6 14.4 7.2 15.3L8.8 16.5C9.3 16.9 9.9 17.1 10.6 17.1H14.4" stroke="#FF8A00" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14 16.8C16.2 16.8 18 15 18 12.8C18 10.6 16.2 8.8 14 8.8C11.8 8.8 10 10.6 10 12.8C10 15 11.8 16.8 14 16.8Z" fill="#FFD874" stroke="#F6A21A" stroke-width="1.3"/>
            <path d="M14 10.5V15.1M12.7 11.7H14.5C15.1 11.7 15.5 12 15.5 12.5C15.5 13 15.1 13.3 14.5 13.3H13.4" stroke="#8A5300" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18.9 2.6L19.7 4.5L21.6 5.3L19.7 6L18.9 7.9L18.2 6L16.3 5.3L18.2 4.5L18.9 2.6Z" fill="#FFDD5C"/>
            <path d="M5.6 3.6L6.1 4.8L7.3 5.3L6.1 5.8L5.6 7L5.1 5.8L3.9 5.3L5.1 4.8L5.6 3.6Z" fill="#FF7A1A"/>
            <path d="M2.3 10.1L2.7 10.9L3.5 11.3L2.7 11.6L2.3 12.4L2 11.6L1.2 11.3L2 10.9L2.3 10.1Z" fill="#FFD874"/>
          </svg>
          {{ _('Loyalty points') }}
        </span>
      </div>
      <a
        href="/auth/login?redirect_to=/cart"
        class="cart-loyalty__link{{ ' hidden' if not is_guest_customer }}"
        data-auth-guest
        data-action="login"
        data-redirect="/cart"
        data-add-to-url="false"
      >
        {{ _('Please log in to view and redeem your points') }} ←
      </a>
      <span
        class="cart-loyalty__link cart-loyalty__link--note{{ ' hidden' if is_guest_customer }}"
        data-auth-user
      >
        {{ _('Points will be added to your balance after your order is completed') }}
      </span>
    </div>
  {% endif %}

  {# UVP features + payment methods marquee #}
  {% include 'components/cart/cart-uvps.jinja' %}
  {% include 'components/cart/cart-payments.jinja' %}
</div>
