{% set cart_settings = settings %}
{% set feature_title_color = safeget(cart_settings, 'cart_page_feature_title_color', safeget(cart_settings, 'cart_page_cart_page_feature_title_color', '#000000')) %}
{% set feature_subtitle_color = safeget(cart_settings, 'cart_page_feature_subtitle_color', safeget(cart_settings, 'cart_page_cart_page_feature_subtitle_color', '#52525C')) %}
{% set loyalty_bg = safeget(cart_settings, 'cart_page_loyalty_background_color', safeget(cart_settings, 'cart_page_cart_page_loyalty_background_color', '#F5F5F5')) %}
{% set loyalty_text = safeget(cart_settings, 'cart_page_loyalty_text_color', safeget(cart_settings, 'cart_page_cart_page_loyalty_text_color', '#0D0702')) %}
{% set cta_bg = safeget(cart_settings, 'cart_page_checkout_button_color', safeget(cart_settings, 'cart_page_cart_page_checkout_button_color', '#F7512B')) %}
{% set cta_text = safeget(cart_settings, 'cart_page_checkout_button_text_color', safeget(cart_settings, 'cart_page_cart_page_checkout_button_text_color', '#FFFFFF')) %}
{% set features = safeget(cart_settings, 'cart_page_features', safeget(cart_settings, 'cart_page_cart_page_features', [])) %}
{% set payment_methods = safeget(cart_settings, 'cart_page_payment_methods', safeget(cart_settings, 'cart_page_cart_page_payment_methods', [])) %}

{% if not features or features | length == 0 %}
  {%
    set features = [
      {'title': _('Fast delivery'), 'subtitle': _('You can drink it before your mood gets cold')},
      {'title': _('Secure payment'), 'subtitle': _('Flexible and secure payment options for a worry-free experience')},
      {'title': _('Guaranteed quality'), 'subtitle': _('Carefully selected crops that match your mood')}
    ]
  %}
{% endif %}

{% set subtotal_condition = cart.free_shipping_rule.subtotal_condition if cart.free_shipping_rule else none %}
{% set free_shipping_status = subtotal_condition.status | default('') if subtotal_condition else '' %}
{% set free_shipping_remaining_raw = subtotal_condition.remaining | default('57.00 SAR') if subtotal_condition else '57.00 SAR' %}
{% set free_shipping_remaining_num = free_shipping_remaining_raw | replace(' SAR', '') | replace(' sar', '') | replace('SAR', '') | trim %}
{% set free_shipping_remaining = free_shipping_remaining_num %}
{% set free_shipping_percent = subtotal_condition.products_subtotal_percentage_from_min | default(0) if subtotal_condition else 70 %}
{% set free_shipping_width = 100 if free_shipping_status == 'applied' else free_shipping_percent %}

<aside
  class="cart-sidebar"
  style="
    --cart-feature-title: {{ feature_title_color }};
    --cart-feature-subtitle: {{ feature_subtitle_color }};
    --cart-loyalty-bg: {{ loyalty_bg }};
    --cart-loyalty-text: {{ loyalty_text }};
    --cart-cta-bg: {{ cta_bg }};
    --cart-cta-text: {{ cta_text }};
  "
>
  <div class="cart-sidebar__panel">
    <div
      class="cart-free-shipping cart-free-shipping--desktop"
      data-free-shipping-bar
      data-free-shipping-remaining="{{ free_shipping_remaining }}"
      data-free-shipping-percentage="{{ free_shipping_width }}"
    >
      <div class="cart-free-shipping__message-row">
        <svg
          class="cart-free-shipping__truck"
          width="30"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 7H14V17H3V7Z"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <path
            d="M14 11H18L21 14V17H14V11Z"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <circle
            cx="7"
            cy="18"
            r="1.5"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <circle
            cx="17"
            cy="18"
            r="1.5"
            stroke="currentColor"
            stroke-width="1.5"
          />
        </svg>
        <span
          class="cart-free-shipping__message"
          data-free-shipping-message
        >
          {% if free_shipping_status == 'applied' %}
            {{ _('Free shipping applied!') }}
          {% else %}
            {% set riyal_svg %}<svg class="riyal-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124.14 1256.39" width="12" height="14" style="display:inline-block;vertical-align:-0.1em"><path fill="currentColor" d="M699.62,1113.02h0c-20.06,44.48-33.32,92.75-38.4,143.37l424.51-90.24c20.06-44.47,33.31-92.75,38.4-143.37l-424.51,90.24Z"/><path fill="currentColor" d="M1085.73,895.8c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.33v-135.2l292.27-62.11c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.27V66.13c-50.67,28.45-95.67,66.32-132.25,110.99v403.35l-132.25,28.11V0c-50.67,28.44-95.67,66.32-132.25,110.99v525.69l-295.91,62.88c-20.06,44.47-33.33,92.75-38.42,143.37l334.33-71.05v170.26l-358.3,76.14c-20.06,44.47-33.32,92.75-38.4,143.37l375.04-79.7c30.53-6.35,56.77-24.4,73.83-49.24l68.78-101.97v-.02c7.14-10.55,11.3-23.27,11.3-36.97v-149.98l132.25-28.11v270.4l424.53-90.28Z"/></svg>{% endset %}
            {{ (_('Add purchases worth %(amount)s to get free shipping') | format(amount=free_shipping_remaining ~ ' ' ~ riyal_svg)) | safe }}
          {% endif %}
        </span>
      </div>
      <div
        class="cart-free-shipping__track"
        data-free-shipping-progress-wrapper
      >
        <span
          class="cart-free-shipping__fill"
          style="width: {{ free_shipping_width }}%"
          data-free-shipping-progress-bar
        ></span>
      </div>
    </div>

    <div>{% include 'components/cart/cart-summary.jinja' %}</div>

    <div class="cart-benefits">
      {% if store.settings.checkout.is_loyalty_enabled | default(false) %}
        <div
          class="cart-loyalty"
          data-loyalty-section
        >
          <div class="cart-loyalty__top">
            <strong>+ <span data-loyalty-calculated-points>0</span> {{ _('points') }}</strong>
            <span class="cart-loyalty__label">
              <svg
                class="cart-loyalty__icon"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M6.2 15.8C7.7 18.8 10.6 20.7 14 20.7C17.9 20.7 21.1 17.6 21.1 13.7C21.1 9.8 17.9 6.7 14 6.7C10.8 6.7 8.1 8.8 7.2 11.7"
                  stroke="#FFB22E"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
                <path
                  d="M3.3 14.8C4.7 14.2 6 14.4 7.2 15.3L8.8 16.5C9.3 16.9 9.9 17.1 10.6 17.1H14.4"
                  stroke="#FF8A00"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M14 16.8C16.2 16.8 18 15 18 12.8C18 10.6 16.2 8.8 14 8.8C11.8 8.8 10 10.6 10 12.8C10 15 11.8 16.8 14 16.8Z"
                  fill="#FFD874"
                  stroke="#F6A21A"
                  stroke-width="1.3"
                />
                <path
                  d="M14 10.5V15.1M12.7 11.7H14.5C15.1 11.7 15.5 12 15.5 12.5C15.5 13 15.1 13.3 14.5 13.3H13.4"
                  stroke="#8A5300"
                  stroke-width="1.1"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M18.9 2.6L19.7 4.5L21.6 5.3L19.7 6L18.9 7.9L18.2 6L16.3 5.3L18.2 4.5L18.9 2.6Z"
                  fill="#FFDD5C"
                />
                <path
                  d="M5.6 3.6L6.1 4.8L7.3 5.3L6.1 5.8L5.6 7L5.1 5.8L3.9 5.3L5.1 4.8L5.6 3.6Z"
                  fill="#FF7A1A"
                />
                <path
                  d="M2.3 10.1L2.7 10.9L3.5 11.3L2.7 11.6L2.3 12.4L2 11.6L1.2 11.3L2 10.9L2.3 10.1Z"
                  fill="#FFD874"
                />
              </svg>
              {{ _('Loyalty points') }}
            </span>
          </div>
          <a
            href="/auth/login?redirect_to=/cart"
            class="cart-loyalty__link"
            data-action="login"
            data-redirect="/cart"
            data-add-to-url="false"
          >
            {{ _('Please log in to view and redeem your points') }} ←
          </a>
        </div>
      {% endif %}

      <div class="cart-features">
        {% for feature in features[:3] %}
          <div class="cart-feature">
            <div class="cart-feature__image">
              {% if feature.image %}
                <img
                  src="{{ image_url(feature.image, w=140, h=120, f='auto') }}"
                  alt=""
                />
              {% else %}
                <svg
                  viewBox="0 0 64 56"
                  fill="none"
                  aria-hidden="true"
                >
                  <rect
                    x="8"
                    y="18"
                    width="34"
                    height="22"
                    rx="4"
                    stroke="#1583C7"
                    stroke-width="2"
                  />
                  <path
                    d="M42 26H52L58 33V40H42V26Z"
                    stroke="#F7941D"
                    stroke-width="2"
                  />
                  <circle
                    cx="20"
                    cy="43"
                    r="4"
                    fill="#F7941D"
                  />
                  <circle
                    cx="49"
                    cy="43"
                    r="4"
                    fill="#1583C7"
                  />
                </svg>
              {% endif %}
            </div>
            <h3>{{ feature.title | default(_('Fast delivery')) }}</h3>
            <p>{{ feature.subtitle | default(_('You can drink it before your mood gets cold')) }}</p>
          </div>
        {% endfor %}
      </div>

      <div
        class="cart-payments"
        aria-label="{{ _('Payment methods') }}"
      >
        <div class="cart-payments__track">
          {% for repeat in [1, 2] %}
            <div
              class="cart-payments__group"
              {% if repeat == 2 %}aria-hidden="true"{% endif %}
            >
              {% if payment_methods and payment_methods | length > 0 %}
                {% for method in payment_methods %}
                  <span class="cart-payment">
                    {% if method.image %}
                      <img
                        src="{{ image_url(method.image, w=120, h=56, f='auto') }}"
                        alt="{{ method.title | default('') }}"
                      />
                    {% else %}
                      {{ method.title | default(_('Pay')) }}
                    {% endif %}
                  </span>
                {% endfor %}
              {% else %}
                {% for label in ['tabby', _('Tamara'), 'VISA', 'mada', 'MasterCard', 'valu', 'Apple Pay'] %}
                  <span class="cart-payment cart-payment--text">{{ label }}</span>
                {% endfor %}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div
      class="cart-sidebar__hidden-widgets"
      data-payment-widgets
    >
      {% include 'vitrin:cart/payment_widgets.jinja' %}
      {% include 'vitrin:checkout/apple-pay-quick-checkout.jinja' %}
    </div>
  </div>
</aside>
