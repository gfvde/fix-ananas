{% macro get_total(code) %}
  {%- for cartTotal in cart.totals -%}
    {%- if cartTotal.code == code -%}
      {{- cartTotal.value_string -}}
    {%- endif -%}
  {%- endfor -%}
{% endmacro %}

{% macro get_total_amount(code) %}
  {%- for cartTotal in cart.totals -%}
    {%- if cartTotal.code == code -%}
      {{- cartTotal.value | default(cartTotal.amount | default(cartTotal.value_string | default(''))) -}}
    {%- endif -%}
  {%- endfor -%}
{% endmacro %}

{% macro get_first_total(codes) %}
  {%- for code in codes -%}
    {%- set value = get_total(code) | trim -%}
    {%- if value -%}
      {{- value -}}
    {%- endif -%}
  {%- endfor -%}
{% endmacro %}

{% macro money_text(value) -%}
  {{- (value|string)|trim -}}
{%- endmacro %}

{% set products_subtotal = namespace(value=0) %}
{% if cart.products %}
  {% for item in cart.products %}
    {% set line_total = item.total | default(item.total_value | default(item.total_price | default(item.line_total | default(none)))) %}
    {% if line_total is not none %}
      {% set products_subtotal.value = products_subtotal.value + (line_total | float) %}
    {% else %}
      {% set unit_price = item.price | default(item.sale_price | default(item.product.sale_price | default(item.product.price | default(0)))) %}
      {% set products_subtotal.value = products_subtotal.value + ((unit_price | float) * (item.quantity | default(1) | float)) %}
    {% endif %}
  {% endfor %}
{% endif %}

{% set subtotal_text = get_first_total(['sub_totals', 'subtotal', 'sub_total', 'products_subtotal', 'products_total']) | trim %}
{% if not subtotal_text %}
  {% set subtotal_text = cart.sub_total_string | default(cart.subtotal_string | default(cart.products_subtotal_string | default(cart.products_total_string | default('')))) %}
{% endif %}
{% set total_text = get_total('total') | trim %}
{% set shipping_text = get_total('shipping') | trim %}
{% set discount_text = get_first_total(['discount', 'coupon_discount', 'products_discount', 'cart_discount', 'coupon', 'discounts']) | trim %}
{% if not discount_text and cart.coupon %}
  {% set discount_text = cart.coupon.amount_string | default(cart.coupon.discount_amount_string | default(cart.coupon.discount_string | default(cart.coupon.amount | default(cart.coupon.discount_amount | default(cart.coupon.discount_value | default('')))))) %}
{% endif %}
{% if discount_text and not discount_text.startswith('-') %}
  {% set discount_text = '-' ~ discount_text %}
{% endif %}
{% if not shipping_text %}{% set shipping_text = '-' %}{% endif %}
{% set currency_code = cart.currency.cart_currency.code | default(session.currency.code | default('')) %}
{% if products_subtotal.value > 0 %}
  {% set subtotal_text = '%.2f' | format(products_subtotal.value) ~ (' ' ~ currency_code if currency_code else '') %}
{% endif %}
{% if not subtotal_text %}
  {% set subtotal_text = total_text %}
{% endif %}
{% if not discount_text and cart.coupon and products_subtotal.value > 0 %}
  {% set total_amount = get_total_amount('total') | trim %}
  {% set total_number = total_amount | default(cart.total_value | default(cart.total | default(0))) | float %}
  {% if total_number > 0 and products_subtotal.value > total_number %}
    {% set discount_text = '-%.2f' | format(products_subtotal.value - total_number) ~ (' ' ~ currency_code if currency_code else '') %}
  {% endif %}
{% endif %}

<div
  class="cart-summary"
  data-cart-summary-root
>
  <h2 class="cart-summary__title">{{ _('Order summary') }}</h2>

  <div
    class="cart-coupon"
    data-coupon-section
  >
    {% if cart.coupon and cart.coupon.code %}
      <div
        class="cart-coupon__applied-wrap"
        data-applied-coupon
      >
        <span class="cart-coupon__applied-label">{{ _('Coupon code') }}</span>
        <div class="cart-coupon__applied">
          <button
            type="button"
            class="cart-coupon__remove"
            data-action="coupon-remove"
            data-coupon-delete-btn
            aria-label="{{ _('Remove coupon') }}"
          >
            <span data-coupon-delete-icon>×</span>
            <svg
              class="hidden size-4 animate-spin"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              data-coupon-delete-spinner
              aria-hidden="true"
            >
              <path d="M21 12a9 9 0 1 1-6.219-8.56" />
            </svg>
          </button>
          <span class="cart-coupon__code">{{ cart.coupon.code }}</span>
          <svg
            class="cart-coupon__tag"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M2.667 5.333V3.333C2.667 2.965 2.965 2.667 3.333 2.667H5.333L13.333 10.667L10.667 13.333L2.667 5.333Z"
              fill="currentColor"
            />
            <path
              d="M5 5H5.007"
              stroke="#FFFFFF"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </div>
      </div>
    {% else %}
      <details class="cart-coupon__details">
        <summary>{{ _('Enter coupon code') }}</summary>
        <form
          class="cart-coupon__form"
          data-coupon-form
        >
          <button
            type="submit"
            data-action="coupon-apply"
            data-coupon-submit-btn
            disabled
          >
            <span data-coupon-submit-text>{{ _('Apply') }}</span>
            <svg
              class="hidden size-4 animate-spin"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              data-coupon-submit-spinner
            >
              <path d="M21 12a9 9 0 1 1-6.219-8.56" />
            </svg>
          </button>
          <label class="cart-coupon__input-wrap">
            <input
              name="coupon_code"
              type="text"
              placeholder="{{ _('Coupon code') }}"
              required
              data-coupon-input
            />
            <svg
              class="cart-coupon__input-icon"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2.667 5.333V3.333C2.667 2.965 2.965 2.667 3.333 2.667H5.333L13.333 10.667L10.667 13.333L2.667 5.333Z"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M5 5H5.007"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>
          </label>
        </form>
      </details>
    {% endif %}
  </div>

  {% include 'components/cart/gift-order.jinja' %}

  <div
    class="cart-summary__rows"
    data-cart-totals
  >
    <div class="cart-summary__row">
      <span
        class="cart-summary__value"
        data-cart-summary-subtotal
        >{{ money_text(subtotal_text) }}</span
      >
      <span class="cart-summary__label"
        >{{ _('Subtotal') }} <span data-cart-items-count>({{ _('%(count)s products') | format(count=(cart.products_count | default(0))) }})</span></span
      >
    </div>
    <div class="cart-summary__row">
      <span
        class="cart-summary__value cart-summary__value--success"
        data-cart-summary-shipping
        >{{ money_text(shipping_text) }}</span
      >
      <span class="cart-summary__label">{{ _('Shipping fees') }}</span>
    </div>
    <div class="cart-summary__row cart-summary__row--discount{% if not discount_text %} hidden{% endif %}">
      <span
        class="cart-summary__value cart-summary__value--discount"
        data-cart-summary-discount
        >{{ money_text(discount_text) }}</span
      >
      <span class="cart-summary__label">{{ _('Discount') }}</span>
    </div>
    <div class="cart-summary__divider"></div>
    <div class="cart-summary__row cart-summary__row--total">
      <span
        class="cart-summary__total-value"
        data-cart-summary-total
        >{{ money_text(total_text) }}</span
      >
      <span class="cart-summary__total-label"> <small>{{ _('VAT included') }}</small>{{ _('Total') }}</span>
    </div>
  </div>

  <a
    href="/checkout"
    class="cart-summary__checkout"
  >
    <span data-cart-summary-checkout-total>{{ money_text(total_text) }}</span>
    <span>{{ _('Complete your order') }}</span>
  </a>
</div>
