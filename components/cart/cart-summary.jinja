{% macro get_total(code) %}
  {%- for cartTotal in cart.totals -%}
    {%- if cartTotal.code == code -%}
      {{- cartTotal.value_string -}}
    {%- endif -%}
  {%- endfor -%}
{% endmacro %}

{% macro get_first_total(codes) %}
  {%- for code in codes -%}
    {%- set value = get_total(code) | trim -%}
    {%- if value -%}
      {{- value -}}
    {%- endif -%}
  {%- endfor -%}
{% endmacro %}

{% macro money_text(value) -%}
  {{- (value|string)|trim -}}
{%- endmacro %}

{# Totals come from the platform-formatted cart.totals (value_string) only #}
{% set subtotal_text = get_first_total(['sub_totals', 'sub_totals_before_vat', 'subtotal', 'sub_total', 'products_subtotal', 'products_total']) | trim %}
{% if not subtotal_text %}
  {% set subtotal_text = cart.sub_total_string | default(cart.subtotal_string | default(cart.products_subtotal_string | default(cart.products_total_string | default('')))) %}
{% endif %}
{% set total_text = get_total('total') | trim %}
{% set shipping_text = get_total('shipping') | trim %}
{% set discount_text = get_first_total(['discount', 'coupon_discount', 'products_discount', 'cart_discount', 'coupon', 'discounts']) | trim %}
{% if not discount_text and cart.coupon %}
  {% set discount_text = cart.coupon.amount_string | default(cart.coupon.discount_amount_string | default(cart.coupon.discount_string | default(cart.coupon.amount | default(cart.coupon.discount_amount | default(cart.coupon.discount_value | default('')))))) %}
{% endif %}
{% if discount_text and not discount_text.startswith('-') %}
  {% set discount_text = '-' ~ discount_text %}
{% endif %}
{% if not shipping_text %}{% set shipping_text = '-' %}{% endif %}
{# Loyalty points redemption is its own total (code loyalty_redemption, already negative) #}
{% set loyalty_text = get_total('loyalty_redemption') | trim %}
{% set loyalty_points = cart.loyalty_applied_redemption_method.points_to_redeem if cart.loyalty_applied_redemption_method else '' %}
{% if not subtotal_text %}
  {% set subtotal_text = total_text %}
{% endif %}
{% set coupon_form_enabled = safeget(store, 'settings.checkout.is_coupon_form_enabled', true) != false %}

<div
  class="cart-summary"
  data-cart-summary-root
>
  <h2 class="cart-summary__title">{{ _('Order summary') }}</h2>

  {% if coupon_form_enabled %}
  <div
    class="cart-coupon"
    data-coupon-section
  >
    {% if cart.coupon and cart.coupon.code %}
      <div
        class="cart-coupon__applied-wrap"
        data-applied-coupon
      >
        <span class="cart-coupon__applied-label">{{ _('Coupon code') }}</span>
        <div class="cart-coupon__applied">
          <button
            type="button"
            class="cart-coupon__remove"
            data-action="coupon-remove"
            data-coupon-delete-btn
            aria-label="{{ _('Remove coupon') }}"
          >
            <span data-coupon-delete-icon>×</span>
            <svg
              class="hidden size-4 animate-spin"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              data-coupon-delete-spinner
              aria-hidden="true"
            >
              <path d="M21 12a9 9 0 1 1-6.219-8.56" />
            </svg>
          </button>
          <span class="cart-coupon__code">{{ cart.coupon.code }}</span>
          <svg
            class="cart-coupon__tag"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M2.667 5.333V3.333C2.667 2.965 2.965 2.667 3.333 2.667H5.333L13.333 10.667L10.667 13.333L2.667 5.333Z"
              fill="currentColor"
            />
            <path
              d="M5 5H5.007"
              stroke="#FFFFFF"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </div>
      </div>
    {% else %}
      <details class="cart-coupon__details">
        <summary>{{ _('Enter coupon code') }}</summary>
        <form
          class="cart-coupon__form"
          data-coupon-form
        >
          <button
            type="submit"
            data-action="coupon-apply"
            data-coupon-submit-btn
            disabled
          >
            <span data-coupon-submit-text>{{ _('Apply') }}</span>
            <svg
              class="hidden size-4 animate-spin"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              data-coupon-submit-spinner
            >
              <path d="M21 12a9 9 0 1 1-6.219-8.56" />
            </svg>
          </button>
          <label class="cart-coupon__input-wrap">
            <input
              name="coupon_code"
              type="text"
              placeholder="{{ _('Coupon code') }}"
              required
              data-coupon-input
            />
            <svg
              class="cart-coupon__input-icon"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2.667 5.333V3.333C2.667 2.965 2.965 2.667 3.333 2.667H5.333L13.333 10.667L10.667 13.333L2.667 5.333Z"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M5 5H5.007"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>
          </label>
        </form>
      </details>
    {% endif %}
  </div>
  {% endif %}

  {% include 'components/cart/gift-order.jinja' %}

  <div
    class="cart-summary__rows"
    data-cart-totals
  >
    <div class="cart-summary__row">
      <span
        class="cart-summary__value"
        data-cart-summary-subtotal
        >{{ money_text(subtotal_text) }}</span
      >
      <span class="cart-summary__label"
        >{{ _('Subtotal') }} <span data-cart-items-count>({{ _('%(count)s products') | format(count=(cart.products_count | default(0))) }})</span></span
      >
    </div>
    <div class="cart-summary__row">
      <span
        class="cart-summary__value cart-summary__value--success"
        data-cart-summary-shipping
        >{{ money_text(shipping_text) }}</span
      >
      <span class="cart-summary__label">{{ _('Shipping fees') }}</span>
    </div>
    <div class="cart-summary__row cart-summary__row--discount{% if not discount_text %} hidden{% endif %}">
      <span
        class="cart-summary__value cart-summary__value--discount"
        data-cart-summary-discount
        >{{ money_text(discount_text) }}</span
      >
      <span class="cart-summary__label">{{ _('Discount') }}</span>
    </div>
    <div class="cart-summary__row cart-summary__row--discount cart-summary__row--loyalty{% if not loyalty_text %} hidden{% endif %}" data-cart-summary-loyalty-row>
      <span
        class="cart-summary__value cart-summary__value--discount"
        data-cart-summary-loyalty
        >{{ money_text(loyalty_text) }}</span
      >
      <span class="cart-summary__label">{{ _('Loyalty points discount') }}<span data-cart-summary-loyalty-points>{% if loyalty_points %} ({{ _('%(count)s points') | format(count=loyalty_points) }}){% endif %}</span></span>
    </div>
    <div class="cart-summary__divider"></div>
    <div class="cart-summary__row cart-summary__row--total">
      <span
        class="cart-summary__total-value"
        data-cart-summary-total
        >{{ money_text(total_text) }}</span
      >
      <span class="cart-summary__total-label"><span class="cart-summary__total-text">{{ _('Total') }}</span> <small>{{ _('VAT included') }}</small></span>
    </div>
  </div>

  {% if safeget(store, 'settings.general.availability.closed_now') %}
    <button
      type="button"
      class="cart-summary__checkout"
      disabled
    >
      <span data-cart-summary-checkout-total>{{ money_text(total_text) }}</span>
      <span>{{ _('Store is closed') }}</span>
    </button>
    {% set closed_info = safeget(store, 'settings.general.availability') or {} %}
    {% set reopen = closed_info.time_until_reopening or {} %}
    {% if closed_info.message or (closed_info.is_time_counter_displayed and reopen.date) %}
      <div class="cart-summary__closed-note" role="status">
        {% if closed_info.message %}<p>{{ closed_info.message }}</p>{% endif %}
        {% if closed_info.is_time_counter_displayed and reopen.date %}
          <p class="cart-summary__closed-reopen">
            {% if reopen.remaining_days %}
              {{ _('Reopens in %(days)s d %(hours)s h %(minutes)s min') | format(days=reopen.remaining_days, hours=reopen.remaining_hours | default(0), minutes=reopen.remaining_minutes | default(0)) }}
            {% else %}
              {{ _('Reopens in %(hours)s h %(minutes)s min') | format(hours=reopen.remaining_hours | default(0), minutes=reopen.remaining_minutes | default(0)) }}
            {% endif %}
          </p>
        {% endif %}
      </div>
    {% endif %}
  {% else %}
    <a
      href="/checkout"
      class="cart-summary__checkout"
    >
      <span data-cart-summary-checkout-total>{{ money_text(total_text) }}</span>
      <span>{{ _('Complete your order') }}</span>
    </a>
  {% endif %}
</div>
