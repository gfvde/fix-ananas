{% set desktop_gap = settings.desktop_gap | default(16) %}
{% set mobile_gap = settings.mobile_gap | default(16) %}
{% set mobile_row_gap = settings.mobile_row_gap | default(8) %}
{% set mobile_padding = settings.mobile_padding | default(0) %}
{% set title_color = settings.title_color | default('#000000') %}
{% set subtitle_color = settings.subtitle_color | default('#000000') %}

<section
  section-id="{{ sectionId }}"
  data-no-mb="{{ 'true' if settings.remove_bottom_margin else 'false' }}"
  class="image-strip"
  style="
    --image-strip-desktop-gap: {{ desktop_gap }}px;
    --image-strip-mobile-gap: {{ mobile_gap }}px;
    --image-strip-mobile-row-gap: {{ mobile_row_gap }}px;
    --image-strip-mobile-padding: {{ mobile_padding }}px;
    --image-strip-title-color: {{ title_color }};
    --image-strip-subtitle-color: {{ subtitle_color }};
    background-color: {{ settings.background_color | default('transparent') }};
  "
>
  {% set imgs = [settings.photo1, settings.photo2, settings.photo3, settings.photo4] %}
  {% set urls = [settings.photo1_url, settings.photo2_url, settings.photo3_url, settings.photo4_url] %}
  {% set titles = [settings.photo1_title, settings.photo2_title, settings.photo3_title, settings.photo4_title] %}
  {% set subtitles = [settings.photo1_subtitle, settings.photo2_subtitle, settings.photo3_subtitle, settings.photo4_subtitle] %}
  {% set fallback = [
    'https://www.figma.com/api/mcp/asset/25fecfb6-2575-4a48-b501-fe46765f5c36',
    'https://www.figma.com/api/mcp/asset/219fb7e7-571c-4c3e-9f38-7bfc958afb7f',
    'https://www.figma.com/api/mcp/asset/06f71408-762e-4081-80e0-8e68b6a90352',
    'https://www.figma.com/api/mcp/asset/72261d83-e7c5-452c-a490-15f0d0c77a6b'
  ] %}
  <div class="image-strip__grid">
    {% for i in range(4) %}
      <div class="image-strip__item">
        {% if urls[i] %}
          <a href="{{ urls[i] }}" class="image-strip__link" aria-label="{{ titles[i] | default(_('Open image link'), true) }}">
            <span class="image-strip__media">
              <img src="{{ image_url(imgs[i], w=420, h=420, f='auto') if imgs[i] else fallback[i] }}" alt="{{ titles[i] | default('', true) }}" loading="lazy" />
            </span>
            {% if titles[i] or subtitles[i] %}
              <span class="image-strip__caption">
                {% if titles[i] %}<span class="image-strip__title">{{ titles[i] }}</span>{% endif %}
                {% if subtitles[i] %}<span class="image-strip__subtitle">{{ subtitles[i] }}</span>{% endif %}
              </span>
            {% endif %}
          </a>
        {% else %}
          <div class="image-strip__content">
            <span class="image-strip__media">
              <img src="{{ image_url(imgs[i], w=420, h=420, f='auto') if imgs[i] else fallback[i] }}" alt="{{ titles[i] | default('', true) }}" loading="lazy" />
            </span>
            {% if titles[i] or subtitles[i] %}
              <span class="image-strip__caption">
                {% if titles[i] %}<span class="image-strip__title">{{ titles[i] }}</span>{% endif %}
                {% if subtitles[i] %}<span class="image-strip__subtitle">{{ subtitles[i] }}</span>{% endif %}
              </span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

<style>
  [section-id="{{ sectionId }}"].image-strip {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: 24px 0;
    overflow: hidden;
  }

  [section-id="{{ sectionId }}"] .image-strip__grid {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--image-strip-desktop-gap);
  }

  [section-id="{{ sectionId }}"] .image-strip__item {
    width: 198px;
    flex: 0 0 198px;
    min-width: 0;
  }

  [section-id="{{ sectionId }}"] .image-strip__link,
  [section-id="{{ sectionId }}"] .image-strip__content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }

  [section-id="{{ sectionId }}"] .image-strip__media {
    display: block;
    width: 198px;
    height: 198px;
    overflow: hidden;
  }

  [section-id="{{ sectionId }}"] .image-strip__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  [section-id="{{ sectionId }}"] .image-strip__caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: center;
  }

  [section-id="{{ sectionId }}"] .image-strip__title {
    color: var(--image-strip-title-color);
    font-size: 18px;
    font-weight: 500;
    line-height: 28px;
  }

  [section-id="{{ sectionId }}"] .image-strip__subtitle {
    color: var(--image-strip-subtitle-color);
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
  }

  @media (max-width: 767px) {
    [section-id="{{ sectionId }}"].image-strip {
      padding: 0 var(--image-strip-mobile-padding);
      overflow: hidden;
    }

    [section-id="{{ sectionId }}"] .image-strip__grid {
      width: auto;
      display: grid;
      grid-template-columns: repeat(2, 120px);
      gap: var(--image-strip-mobile-row-gap) var(--image-strip-mobile-gap);
      justify-content: center;
    }

    [section-id="{{ sectionId }}"] .image-strip__item {
      width: 120px;
      flex-basis: 120px;
    }

    [section-id="{{ sectionId }}"] .image-strip__media {
      width: 120px;
      height: 120px;
    }

    [section-id="{{ sectionId }}"] .image-strip__title {
      font-size: 18px;
      line-height: 28px;
    }

    [section-id="{{ sectionId }}"] .image-strip__subtitle {
      font-size: 16px;
      font-weight: 500;
      line-height: 24px;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    [section-id="{{ sectionId }}"].image-strip {
      padding: 0 var(--image-strip-mobile-padding);
    }

    [section-id="{{ sectionId }}"] .image-strip__grid {
      display: grid;
      grid-template-columns: repeat(2, 198px);
      gap: var(--image-strip-mobile-gap);
    }
  }
</style>
