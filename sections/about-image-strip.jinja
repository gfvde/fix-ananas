{% set desktop_gap = settings.desktop_gap | default(16) %}
{% set mobile_gap = settings.mobile_gap | default(16) %}
{% set mobile_row_gap = settings.mobile_row_gap | default(8) %}
{% set mobile_padding = settings.mobile_padding | default(0) %}
{% set title_color = settings.title_color | default('#000000') %}
{% set subtitle_color = settings.subtitle_color | default('#000000') %}

<link rel="stylesheet" href="{{ 'css/sections/about-image-strip.css' | asset_url }}">
<section
  section-id="{{ sectionId }}" data-section="about-image-strip"
  data-no-mb="{{ 'true' if settings.remove_bottom_margin else 'false' }}"
  class="image-strip"
  style="
    --image-strip-desktop-gap: {{ desktop_gap }}px;
    --image-strip-mobile-gap: {{ mobile_gap }}px;
    --image-strip-mobile-row-gap: {{ mobile_row_gap }}px;
    --image-strip-mobile-padding: {{ mobile_padding }}px;
    --image-strip-title-color: {{ title_color }};
    --image-strip-subtitle-color: {{ subtitle_color }};
    background-color: {{ settings.background_color | default('transparent') }};
  "
>
  {% set imgs = [settings.photo1, settings.photo2, settings.photo3, settings.photo4] %}
  {% set urls = [settings.photo1_url, settings.photo2_url, settings.photo3_url, settings.photo4_url] %}
  {% set titles = [settings.photo1_title, settings.photo2_title, settings.photo3_title, settings.photo4_title] %}
  {% set subtitles = [settings.photo1_subtitle, settings.photo2_subtitle, settings.photo3_subtitle, settings.photo4_subtitle] %}
  <div class="image-strip__grid">
    {% for i in range(4) if imgs[i] %}
      <div class="image-strip__item">
        {% if urls[i] %}
          <a href="{{ urls[i] }}" class="image-strip__link" aria-label="{{ titles[i] | default(_('Open image link'), true) }}">
            <span class="image-strip__media">
              <img src="{{ image_url(imgs[i], w=420, h=420, f='auto') }}" alt="{{ titles[i] | default('', true) }}" width="420" height="420" loading="lazy" decoding="async" />
            </span>
            {% if titles[i] or subtitles[i] %}
              <span class="image-strip__caption">
                {% if titles[i] %}<span class="image-strip__title">{{ titles[i] }}</span>{% endif %}
                {% if subtitles[i] %}<span class="image-strip__subtitle">{{ subtitles[i] }}</span>{% endif %}
              </span>
            {% endif %}
          </a>
        {% else %}
          <div class="image-strip__content">
            <span class="image-strip__media">
              <img src="{{ image_url(imgs[i], w=420, h=420, f='auto') }}" alt="{{ titles[i] | default('', true) }}" width="420" height="420" loading="lazy" decoding="async" />
            </span>
            {% if titles[i] or subtitles[i] %}
              <span class="image-strip__caption">
                {% if titles[i] %}<span class="image-strip__title">{{ titles[i] }}</span>{% endif %}
                {% if subtitles[i] %}<span class="image-strip__subtitle">{{ subtitles[i] }}</span>{% endif %}
              </span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

