{
  "template": "sections/products-normal.jinja",
  "name": {
    "ar": "قائمة المنتجات (العادي)",
    "en": "Products (Normal)"
  },
  "icon": "shopping-bag-line",
  "meta": {
    "type": "products"
  },
  "settings": [
    {
      "id": "layout",
      "type": "select",
      "label": {
        "ar": "نوع العرض",
        "en": "Layout"
      },
      "options": [
        {
          "value": "carousel",
          "label": {
            "ar": "سلايدر",
            "en": "Slider"
          }
        },
        {
          "value": "grid",
          "label": {
            "ar": "جريد",
            "en": "Grid"
          }
        }
      ],
      "default": "carousel"
    },
    {
      "id": "products",
      "type": "products",
      "label": {
        "ar": "المنتجات",
        "en": "Products"
      }
    },
    {
      "id": "products_limit",
      "type": "range",
      "label": {
        "ar": "عدد المنتجات المعروضة",
        "en": "Number of products"
      },
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "id": "title",
      "type": "text",
      "label": {
        "ar": "العنوان",
        "en": "Title"
      },
      "default": "لكل مناسبة، إطلالة"
    },
    {
      "id": "subtitle",
      "type": "text",
      "label": {
        "ar": "الوصف",
        "en": "Subtitle"
      },
      "default": "قصات وألوان تناسب ذوقك"
    },
    {
      "id": "display_more",
      "type": "checkbox",
      "label": {
        "ar": "عرض زر المزيد",
        "en": "Display More Button"
      },
      "default": true
    },
    {
      "id": "more_text",
      "type": "text",
      "label": {
        "ar": "نص زر المزيد",
        "en": "More Button Text"
      },
      "default": "اكتشفي إطلالتك"
    },
    {
      "id": "more_url",
      "type": "url",
      "label": {
        "ar": "رابط زر المزيد",
        "en": "More Button URL"
      },
      "default": ""
    },
    {
      "id": "background_color",
      "type": "color",
      "label": {
        "ar": "لون الخلفية",
        "en": "Background Color"
      },
      "default": "#FAF7F2"
    },
    {
      "id": "text_color",
      "type": "color",
      "label": {
        "ar": "لون النص",
        "en": "Text Color"
      },
      "default": "#000000"
    },
    {
      "id": "muted_color",
      "type": "color",
      "label": {
        "ar": "لون النص الثانوي",
        "en": "Muted Text Color"
      },
      "default": "#737373"
    },
    {
      "id": "border_color",
      "type": "color",
      "label": {
        "ar": "لون الحدود",
        "en": "Border Color"
      },
      "default": "#000000"
    },
    {
      "id": "chip_bg_color",
      "type": "color",
      "label": {
        "ar": "لون خلفية الوسوم",
        "en": "Chip Background Color"
      },
      "default": "#F0F0F0"
    },
    {
      "id": "badge_bg_color",
      "type": "color",
      "label": {
        "ar": "لون خلفية شارة المنتج",
        "en": "Product Badge Background Color"
      },
      "default": "#6B4A39"
    },
    {
      "id": "badge_text_color",
      "type": "color",
      "label": {
        "ar": "لون نص شارة المنتج",
        "en": "Product Badge Text Color"
      },
      "default": "#FFFFFF"
    },
    {
      "id": "button_bg_color",
      "type": "color",
      "label": {
        "ar": "لون خلفية زر السلة",
        "en": "Add Button Background Color"
      },
      "default": "#FAF7F2"
    },
    {
      "id": "button_text_color",
      "type": "color",
      "label": {
        "ar": "لون نص زر السلة",
        "en": "Add Button Text Color"
      },
      "default": "#000000"
    },
    {
      "id": "progress_bg_color",
      "type": "color",
      "label": {
        "ar": "لون خلفية المؤشر",
        "en": "Progress Background Color"
      },
      "default": "#E5E5E5"
    },
    {
      "id": "progress_fill_color",
      "type": "color",
      "label": {
        "ar": "لون المؤشر",
        "en": "Progress Fill Color"
      },
      "default": "#737373"
    },
    {
      "id": "remove_bottom_margin",
      "type": "checkbox",
      "label": {
        "ar": "إزالة المسافة السفلية",
        "en": "Remove Bottom Margin"
      },
      "default": false
    }
  ]
}
