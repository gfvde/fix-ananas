{
  "template": "sections/about-hero-banner.jinja",
  "name": {
    "ar": "هيرو بانر (About)",
    "en": "Hero Banner (About)"
  },
  "icon": "landscape-line",
  "meta": {
    "type": "slider"
  },
  "settings": [
    {
      "id": "bg_desktop",
      "type": "image",
      "label": {
        "ar": "صورة الخلفية (ديسكتوب)",
        "en": "Background Image (Desktop)"
      }
    },
    {
      "id": "bg_mobile",
      "type": "image",
      "label": {
        "ar": "صورة الخلفية (موبايل)",
        "en": "Background Image (Mobile)"
      }
    },
    {
      "id": "media_type",
      "type": "select",
      "label": {
        "ar": "نوع الخلفية",
        "en": "Background Type"
      },
      "default": "image",
      "options": [
        {
          "value": "image",
          "label": {
            "ar": "صورة",
            "en": "Image"
          }
        },
        {
          "value": "video",
          "label": {
            "ar": "فيديو",
            "en": "Video"
          }
        }
      ]
    },
    {
      "id": "video_desktop",
      "type": "video",
      "label": {
        "ar": "فيديو الخلفية (ديسكتوب)",
        "en": "Background Video (Desktop)"
      },
      "info": {
        "ar": "يشتغل تلقائياً بدون صوت ومتكرر. صور الخلفية تظهر كغلاف لحد ما الفيديو يحمّل",
        "en": "Autoplays muted on loop. The background images show as the poster until it loads"
      }
    },
    {
      "id": "video_mobile",
      "type": "video",
      "label": {
        "ar": "فيديو الخلفية (موبايل)",
        "en": "Background Video (Mobile)"
      },
      "info": {
        "ar": "اختياري، لو فاضي يستخدم فيديو الديسكتوب",
        "en": "Optional, falls back to the desktop video"
      }
    },
    {
      "id": "desktop_height",
      "type": "range",
      "label": {
        "ar": "ارتفاع السكشن ديسكتوب",
        "en": "Desktop Section Height"
      },
      "min": 360,
      "max": 720,
      "step": 1,
      "unit": "px",
      "default": 468
    },
    {
      "id": "mobile_height",
      "type": "range",
      "label": {
        "ar": "ارتفاع السكشن موبايل",
        "en": "Mobile Section Height"
      },
      "min": 360,
      "max": 720,
      "step": 1,
      "unit": "px",
      "default": 460
    },
    {
      "id": "desktop_content_offset_y",
      "type": "range",
      "label": {
        "ar": "تحريك المحتوى عمودياً ديسكتوب",
        "en": "Desktop Content Vertical Offset"
      },
      "min": -120,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "id": "mobile_content_offset_y",
      "type": "range",
      "label": {
        "ar": "تحريك المحتوى عمودياً موبايل",
        "en": "Mobile Content Vertical Offset"
      },
      "min": -120,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "id": "overlay_opacity",
      "type": "range",
      "label": {
        "ar": "شفافية تدرج الموبايل",
        "en": "Mobile Gradient Opacity"
      },
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "id": "desktop_overlay_opacity",
      "type": "range",
      "label": {
        "ar": "شفافية تعتيم الديسكتوب",
        "en": "Desktop Overlay Opacity"
      },
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "id": "show_desktop_content",
      "type": "checkbox",
      "label": {
        "ar": "إظهار النص والزر على الديسكتوب",
        "en": "Show Text and Button on Desktop"
      },
      "default": false
    },
    {
      "id": "desktop_content_side",
      "type": "select",
      "label": {
        "ar": "مكان النص على الديسكتوب",
        "en": "Desktop Text Position"
      },
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": {
            "ar": "حسب اتجاه اللغة",
            "en": "Follow language direction"
          }
        },
        {
          "value": "right",
          "label": {
            "ar": "يمين دائمًا",
            "en": "Always right"
          }
        },
        {
          "value": "left",
          "label": {
            "ar": "يسار دائمًا",
            "en": "Always left"
          }
        }
      ]
    },
    {
      "id": "heading",
      "type": "text",
      "label": {
        "ar": "العنوان الرئيسي",
        "en": "Heading"
      },
      "default": "أناقة على طريقتك"
    },
    {
      "id": "subheading",
      "type": "textarea",
      "label": {
        "ar": "العنوان الفرعي",
        "en": "Subheading"
      },
      "default": "عبايات وأزياء خليجية بتفاصيل تشبهك"
    },
    {
      "id": "heading_color",
      "type": "color",
      "label": {
        "ar": "لون العنوان",
        "en": "Heading Color"
      },
      "default": "#ffffff"
    },
    {
      "id": "subheading_color",
      "type": "color",
      "label": {
        "ar": "لون النص الفرعي",
        "en": "Subheading Color"
      },
      "default": "#ffffff"
    },
    {
      "id": "show_rating",
      "type": "checkbox",
      "label": {
        "ar": "إظهار التقييم",
        "en": "Show Rating"
      },
      "default": true
    },
    {
      "id": "rating",
      "type": "text",
      "label": {
        "ar": "قيمة التقييم",
        "en": "Rating Value"
      },
      "default": "4.8"
    },
    {
      "id": "rating_stars",
      "type": "range",
      "label": {
        "ar": "عدد النجوم",
        "en": "Stars Count"
      },
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "id": "rating_label",
      "type": "text",
      "label": {
        "ar": "العدد أسفل التقييم",
        "en": "Rating Sub-label Count"
      },
      "default": "+13K"
    },
    {
      "id": "rating_count",
      "type": "text",
      "label": {
        "ar": "النص أسفل التقييم",
        "en": "Rating Sub-label Text"
      },
      "default": "عميل"
    },
    {
      "id": "rating_scroll_target",
      "type": "select",
      "label": {
        "ar": "وجهة الضغط على التقييم",
        "en": "Rating Click Target"
      },
      "default": "about_reviews_featured",
      "options": [
        {
          "value": "about_reviews_featured",
          "label": {
            "ar": "تقييمات مميزة",
            "en": "Featured Reviews"
          }
        },
        {
          "value": "star_reviews",
          "label": {
            "ar": "تقييمات النجوم",
            "en": "Star Reviews"
          }
        }
      ]
    },
    {
      "id": "avatars",
      "type": "list",
      "label": {
        "ar": "صور العملاء",
        "en": "Customer Avatars"
      },
      "max_items": 3,
      "settings": [
        {
          "id": "image",
          "type": "image",
          "label": {
            "ar": "الصورة",
            "en": "Image"
          }
        }
      ],
      "default": []
    },
    {
      "id": "cta_link_on_banner",
      "type": "checkbox",
      "label": {
        "ar": "اجعل الرابط على البانر كله",
        "en": "Link Entire Banner"
      },
      "default": false
    },
    {
      "id": "cta_text",
      "type": "text",
      "label": {
        "ar": "نص الزر",
        "en": "CTA Text"
      },
      "default": "تسوّقي مجموعتنا"
    },
    {
      "id": "cta_url",
      "type": "url",
      "label": {
        "ar": "رابط الزر",
        "en": "CTA URL"
      },
      "default": "/products"
    },
    {
      "id": "cta_text_color",
      "type": "color",
      "label": {
        "ar": "لون نص الزر",
        "en": "CTA Text Color"
      },
      "default": "#ffffff"
    },
    {
      "id": "cta_border_color",
      "type": "color",
      "label": {
        "ar": "لون إطار الزر",
        "en": "CTA Border Color"
      },
      "default": "#ffffff"
    },
    {
      "id": "cta_bg_color",
      "type": "text",
      "label": {
        "ar": "لون خلفية الزر",
        "en": "CTA Background Color"
      },
      "default": "rgba(255,255,255,0)"
    },
    {
      "id": "cta_radius",
      "type": "range",
      "label": {
        "ar": "استدارة الزر",
        "en": "Button Radius"
      },
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "id": "cta_hover_bg_color",
      "type": "text",
      "label": {
        "ar": "لون خلفية الزر عند المرور",
        "en": "CTA Hover Background"
      },
      "default": "rgba(255,255,255,0.10)"
    },
    {
      "id": "background_color",
      "type": "color",
      "label": {
        "ar": "لون الخلفية",
        "en": "Background Color"
      },
      "default": "#171717"
    },
    {
      "id": "remove_bottom_margin",
      "type": "checkbox",
      "label": {
        "ar": "إزالة المسافة السفلية",
        "en": "Remove Bottom Margin"
      },
      "default": false
    }
  ]
}
