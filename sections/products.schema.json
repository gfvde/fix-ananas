{
  "template": "sections/products.jinja",
  "name": {
    "ar": "قائمة المنتجات",
    "en": "Products"
  },
  "icon": "shopping-bag-line",
  "meta": { "type": "products" },
  "settings": [
    {
      "id": "layout",
      "type": "select",
      "label": {
        "ar": "نوع العرض",
        "en": "Layout"
      },
      "options": [
        {
          "value": "carousel",
          "label": {
            "ar": "سلايدر",
            "en": "Slider"
          }
        },
        {
          "value": "grid",
          "label": {
            "ar": "جريد",
            "en": "Grid"
          }
        }
      ],
      "default": "carousel"
    },
    {
      "id": "title",
      "type": "text",
      "label": {
        "ar": "العنوان",
        "en": "Title"
      },
      "default": "وش نرشّح لك"
    },
    {
      "id": "subtitle",
      "type": "text",
      "label": {
        "ar": "الوصف في موبايل الجريد",
        "en": "Mobile Grid Subtitle"
      },
      "default": "نكهات متنوعة تناسب ذوقك"
    },
    {
      "id": "display_more",
      "type": "checkbox",
      "label": {
        "ar": "عرض زر المزيد",
        "en": "Display More Button"
      },
      "default": true
    },
    {
      "id": "more_text",
      "type": "text",
      "label": {
        "ar": "نص زر المزيد",
        "en": "More Button Text"
      },
      "default": "عرض الكل"
    },
    {
      "id": "more_url",
      "type": "url",
      "label": {
        "ar": "رابط زر المزيد",
        "en": "More Button URL"
      },
      "default": ""
    },
    {
      "id": "explore_text",
      "type": "text",
      "label": {
        "ar": "نص رابط موبايل الجريد",
        "en": "Mobile Grid Link Text"
      },
      "default": "استكشف نكهتك"
    },
    {
      "id": "explore_url",
      "type": "url",
      "label": {
        "ar": "رابط موبايل الجريد",
        "en": "Mobile Grid Link URL"
      },
      "default": ""
    },
    {
      "id": "products_source",
      "type": "select",
      "label": {
        "ar": "مصدر المنتجات",
        "en": "Products Source"
      },
      "options": [
        {
          "value": "tabs",
          "label": {
            "ar": "تبويبان",
            "en": "Two tabs"
          }
        },
        {
          "value": "products",
          "label": {
            "ar": "قائمة منتجات واحدة",
            "en": "Single product list"
          }
        }
      ],
      "default": "tabs"
    },
    {
      "id": "products",
      "type": "products",
      "label": {
        "ar": "اختر قائمة المنتجات",
        "en": "Select Products"
      },
      "visible_if": {
        "products_source": "products"
      }
    },
    {
      "id": "tab_1_text",
      "type": "text",
      "label": {
        "ar": "نص التبويب الأول",
        "en": "First Tab Text"
      },
      "default": "جديدنا"
    },
    {
      "id": "tab_1_products",
      "type": "products",
      "label": {
        "ar": "منتجات التبويب الأول",
        "en": "First Tab Products"
      }
    },
    {
      "id": "tab_2_text",
      "type": "text",
      "label": {
        "ar": "نص التبويب الثاني",
        "en": "Second Tab Text"
      },
      "default": "الأكثر مبيعا"
    },
    {
      "id": "tab_2_products",
      "type": "products",
      "label": {
        "ar": "منتجات التبويب الثاني",
        "en": "Second Tab Products"
      }
    },
    {
      "id": "active_tab",
      "type": "select",
      "label": {
        "ar": "التبويب النشط",
        "en": "Active Tab"
      },
      "options": [
        {
          "value": "tab_1",
          "label": {
            "ar": "الأول",
            "en": "First"
          }
        },
        {
          "value": "tab_2",
          "label": {
            "ar": "الثاني",
            "en": "Second"
          }
        }
      ],
      "default": "tab_2"
    },
    {
      "id": "products_limit",
      "type": "range",
      "label": {
        "ar": "عدد المنتجات المعروضة",
        "en": "Number of products"
      },
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "id": "mobile_tabs_layout",
      "type": "select",
      "label": {
        "ar": "شكل التبويبات في الموبايل",
        "en": "Mobile Tabs Layout"
      },
      "options": [
        {
          "value": "arrows",
          "label": {
            "ar": "سلايدر بالأسهم",
            "en": "Arrows Slider"
          }
        },
        {
          "value": "buttons",
          "label": {
            "ar": "مربعات عادية",
            "en": "Button Tabs"
          }
        }
      ],
      "default": "arrows"
    },
    {
      "id": "background_color",
      "type": "color",
      "label": {
        "ar": "لون الخلفية",
        "en": "Background Color"
      },
      "default": "#FCFAF7"
    },
    {
      "id": "text_color",
      "type": "color",
      "label": {
        "ar": "لون النص",
        "en": "Text Color"
      },
      "default": "#000000"
    },
    {
      "id": "muted_color",
      "type": "color",
      "label": {
        "ar": "لون النص الثانوي",
        "en": "Muted Text Color"
      },
      "default": "#737373"
    },
    {
      "id": "border_color",
      "type": "color",
      "label": {
        "ar": "لون الحدود",
        "en": "Border Color"
      },
      "default": "#000000"
    },
    {
      "id": "chip_bg_color",
      "type": "color",
      "label": {
        "ar": "لون خلفية الوسوم",
        "en": "Chip Background Color"
      },
      "default": "#F0F0F0"
    },
    {
      "id": "tab_bg_color",
      "type": "color",
      "label": {
        "ar": "لون خلفية التبويب",
        "en": "Tab Background Color"
      },
      "default": "#FCFAF7"
    },
    {
      "id": "active_tab_bg_color",
      "type": "color",
      "label": {
        "ar": "لون خلفية التبويب النشط",
        "en": "Active Tab Background Color"
      },
      "default": "#262626"
    },
    {
      "id": "active_tab_text_color",
      "type": "color",
      "label": {
        "ar": "لون نص التبويب النشط",
        "en": "Active Tab Text Color"
      },
      "default": "#FFFFFF"
    },
    {
      "id": "badge_bg_color",
      "type": "color",
      "label": {
        "ar": "لون خلفية شارة المنتج",
        "en": "Product Badge Background Color"
      },
      "default": "#F7512B"
    },
    {
      "id": "badge_text_color",
      "type": "color",
      "label": {
        "ar": "لون نص شارة المنتج",
        "en": "Product Badge Text Color"
      },
      "default": "#FFFFFF"
    },
    {
      "id": "button_bg_color",
      "type": "color",
      "label": {
        "ar": "لون خلفية زر السلة",
        "en": "Add Button Background Color"
      },
      "default": "#FCFAF7"
    },
    {
      "id": "button_text_color",
      "type": "color",
      "label": {
        "ar": "لون نص زر السلة",
        "en": "Add Button Text Color"
      },
      "default": "#000000"
    },
    {
      "id": "progress_bg_color",
      "type": "color",
      "label": {
        "ar": "لون خلفية المؤشر",
        "en": "Progress Background Color"
      },
      "default": "#E5E5E5"
    },
    {
      "id": "progress_fill_color",
      "type": "color",
      "label": {
        "ar": "لون المؤشر",
        "en": "Progress Fill Color"
      },
      "default": "#737373"
    },
    {
      "id": "remove_bottom_margin",
      "type": "checkbox",
      "label": {
        "ar": "إزالة المسافة السفلية",
        "en": "Remove Bottom Margin"
      },
      "default": false
    }
  ]
}