{% set title_color = settings.title_color | default('#000000') %}
{% set subtitle_color = settings.subtitle_color | default('#000000') %}
{% set border_radius = settings.border_radius | default(12) %}
{% set videos_list = safeget(settings, "videos", []) %}

{% if not videos_list or videos_list | length == 0 %}
  {% set videos_list = [
    {'thumbnail': '', 'video': ''},
    {'thumbnail': '', 'video': ''},
    {'thumbnail': '', 'video': ''},
    {'thumbnail': '', 'video': ''},
    {'thumbnail': '', 'video': ''}
  ] %}
{% endif %}

<link rel="stylesheet" href="{{ 'css/sections/video-ugc.css' | asset_url }}">
<section section-id="{{ sectionId }}" data-section="video-ugc"
  data-no-mb="{{ 'true' if settings.remove_bottom_margin else 'false' }}" class="section-video-ugc" style="background-color: {{ settings.background_color | default('#ffffff') }};" >

  {# Header #}
  <div class="video-ugc__header">
    <h2 class="video-ugc__title" style="color: {{ title_color }};">
      {{ settings.title | default(_('Ananas in every shot')) }}
    </h2>
    <p class="video-ugc__subtitle" style="color: {{ subtitle_color }};">
      {{ settings.subtitle | default(_('Coffee details as they are, from its look to its grind to the first sip')) }}
    </p>
  </div>

  {# Desktop: 5 videos side by side #}
  <div class="video-ugc__grid--desktop">
    {% for i in range(5) %}
      {% if videos_list | length > i %}
        {% set vid = videos_list[i] %}
        <div class="video-ugc__card" style="border-radius: {{ border_radius }}px;"
             data-video-url="{{ vid.video | default('') }}">
          <div class="video-ugc__thumb">
            {% if vid.thumbnail %}
              <img src="{{ image_url(vid.thumbnail, w=320, f='auto') }}" alt="" class="video-ugc__thumb-img" />
            {% else %}
              <div class="video-ugc__thumb-placeholder"></div>
            {% endif %}
            {% if vid.video %}
              <button class="video-ugc__play-btn" aria-label="{{ _('Play video') }}">
                <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" width="56" height="56">
                  <circle cx="28" cy="28" r="28" fill="rgba(0,0,0,0.45)"/>
                  <path d="M23 18L38 28L23 38V18Z" fill="white"/>
                </svg>
              </button>
            {% endif %}
          </div>
          <div class="video-ugc__player" style="display:none; border-radius: {{ border_radius }}px;"></div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {# Mobile: Slider showing 2 at a time #}
  <div class="video-ugc__slider--mobile" data-carousel>
    <div class="overflow-hidden" data-carousel-viewport>
      <div class="flex gap-3">
        {% for i in range(videos_list | length) %}
          {% set vid = videos_list[i] %}
          <div class="embla__slide video-ugc__slide-mobile"
               data-video-url="{{ vid.video | default('') }}">
            <div class="video-ugc__card" style="border-radius: {{ border_radius }}px;">
              <div class="video-ugc__thumb">
                {% if vid.thumbnail %}
                  <img src="{{ image_url(vid.thumbnail, w=200, f='auto') }}" alt="" class="video-ugc__thumb-img" />
                {% else %}
                  <div class="video-ugc__thumb-placeholder"></div>
                {% endif %}
                {% if vid.video %}
                  <button class="video-ugc__play-btn" aria-label="{{ _('Play video') }}">
                    <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" width="44" height="44">
                      <circle cx="28" cy="28" r="28" fill="rgba(0,0,0,0.45)"/>
                      <path d="M23 18L38 28L23 38V18Z" fill="white"/>
                    </svg>
                  </button>
                {% endif %}
              </div>
              <div class="video-ugc__player" style="display:none; border-radius: {{ border_radius }}px;"></div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    {# Progress bar #}
    <div class="video-ugc__progress-wrap">
      <div class="video-ugc__progress-track">
        <div class="video-ugc__progress-fill" data-carousel-progress></div>
      </div>
    </div>
  </div>

</section>


<script defer src="{{ 'js/sections/video-ugc.js' | asset_url }}"></script>
