{% set title_text = settings.title | default('اختار قهوتك علي مزاجك') %}
{% set subtitle_text = settings.subtitle | default('لكل مزاج تجربة مختلفة هنا تلقى اللي يناسبك') %}
{% set cta_text = settings.cta_text | default('تسوّق حسب مزاجك') %}
{% set cta_url = settings.cta_url | default('#') %}
{% set section_bg_color = settings.section_bg_color | default('#ffffff') %}
{% set text_color = settings.text_color | default('#000000') %}
{% set tag_bg_color = settings.tag_bg_color | default('#F7512B') %}
{% set tag_text_color = settings.tag_text_color | default('#ffffff') %}
{% set cta_border_color = settings.cta_border_color | default('#000000') %}
{% set cta_text_color = settings.cta_text_color | default('#000000') %}
{% set hover_text_color = settings.hover_text_color | default('#ffffff') %}

{%
  set cards = [
    { 'image': settings.card1_image, 'tag': settings.card1_tag | default('شي جديد'), 'title': settings.card1_title | default('قهوة المغامرة'), 'desc': settings.card1_desc | default('اكتشف نكهات جديدة كل مرة'), 'url': settings.card1_url | default('#'), 'fallback': 'https://www.figma.com/api/mcp/asset/IKWpeo2dgGkgnb8o7g4Krc/image/cdb15f9616f8a053fc33b61727490121a5aeaaf8' },
    { 'image': settings.card2_image, 'tag': settings.card2_tag | default('صفاء ذهني'), 'title': settings.card2_title | default('قهوة التركيز'), 'desc': settings.card2_desc | default('مزاج صافي يساعدك تنجز بدون تشتيت'), 'url': settings.card2_url | default('#'), 'fallback': 'https://www.figma.com/api/mcp/asset/IKWpeo2dgGkgnb8o7g4Krc/image/fc2b0c599cb8eefa2bf83ed620e47cb64c5d9e29' },
    { 'image': settings.card3_image, 'tag': settings.card3_tag | default('هدوء بطعم غني'), 'title': settings.card3_title | default('قهوة الروقان'), 'desc': settings.card3_desc | default('لحظة لنفسك بعيد عن الزحمة'), 'url': settings.card3_url | default('#'), 'fallback': 'https://www.figma.com/api/mcp/asset/IKWpeo2dgGkgnb8o7g4Krc/image/13a314ebd614521b8b74181a2aff5d2b5cb4271c' },
    { 'image': settings.card4_image, 'tag': settings.card4_tag | default('بداية يومك'), 'title': settings.card4_title | default('قهوة الصباح'), 'desc': settings.card4_desc | default('بداية خفيفة تضبط يومك من أول كوب'), 'url': settings.card4_url | default('#'), 'fallback': 'https://www.figma.com/api/mcp/asset/IKWpeo2dgGkgnb8o7g4Krc/image/d2c9b177117675e5fce6f9a9de8d971c12bf233a' }
  ]
%}

<section
  section-id="{{ sectionId }}"
  data-no-mb="{{ 'true' if settings.remove_bottom_margin else 'false' }}"
  class="sbm-section"
  style="--mc-bg:{{ section_bg_color }};--mc-text:{{ text_color }};--mc-tag-bg:{{ tag_bg_color }};--mc-tag-text:{{ tag_text_color }};--mc-cta-border:{{ cta_border_color }};--mc-cta-text:{{ cta_text_color }};--mc-hover-text:{{ hover_text_color }};"
>
  {# DESKTOP #}
  <div class="sbm-desktop">
    <div class="sbm-header">
      <div class="sbm-header__right">
        <h2 class="sbm-title">{{ title_text }}</h2>
        <p class="sbm-subtitle">{{ subtitle_text }}</p>
      </div>
      <a
        href="{{ cta_url }}"
        class="sbm-cta"
      >
        <span>{{ cta_text }}</span>
      </a>
    </div>
    <div class="sbm-cards">
      {% for card in cards %}
        <a
          href="{{ card.url }}"
          class="sbm-card"
        >
          <div class="sbm-card__img">
            <img
              src="{{ image_url(card.image, w=800, f='auto') if card.image else card.fallback }}"
              alt="{{ card.title }}"
              loading="lazy"
            />
            {% if card.tag %}<span class="sbm-tag">{{ card.tag }}</span>{% endif %}
          </div>
          <div class="sbm-card__info">
            <h3 class="sbm-card__name">{{ card.title }}</h3>
            <p class="sbm-card__desc">{{ card.desc }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>

  {# MOBILE #}
  <div class="sbm-mobile">
    <div class="sbm-mob-header">
      <h2 class="sbm-mob-title">{{ title_text }}</h2>
      <div class="sbm-mob-sub-row">
        <button
          class="sbm-arrow"
          data-sbm-prev
          aria-label="Previous"
        >
          <svg
            width="5"
            height="10"
            viewBox="0 0 5 10"
            fill="none"
          >
            <path
              d="M1 1L4 5L1 9"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <p class="sbm-mob-subtitle">{{ settings.mobile_subtitle | default('لكل مزاج تجربة مختلفة') }}</p>
        <button
          class="sbm-arrow"
          data-sbm-next
          aria-label="Next"
        >
          <svg
            width="5"
            height="10"
            viewBox="0 0 5 10"
            fill="none"
          >
            <path
              d="M4 1L1 5L4 9"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </div>
    <div
      class="sbm-track"
      data-sbm-track
    >
      {% for card in cards %}
        <a
          href="{{ card.url }}"
          class="sbm-mob-card"
        >
          <div class="sbm-mob-card__img">
            <img
              src="{{ image_url(card.image, w=600, f='auto') if card.image else card.fallback }}"
              alt="{{ card.title }}"
              loading="lazy"
            />
            {% if card.tag %}<span class="sbm-tag">{{ card.tag }}</span>{% endif %}
          </div>
          <div class="sbm-mob-card__info">
            <h3 class="sbm-mob-card__name">{{ card.title }}</h3>
            <p class="sbm-mob-card__desc">{{ card.desc }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
    <div class="sbm-scrollbar">
      <div class="sbm-scrollbar__track">
        <div
          class="sbm-scrollbar__thumb"
          data-sbm-thumb
        ></div>
      </div>
    </div>
    <a
      href="{{ cta_url }}"
      class="sbm-mob-cta"
    >{{ cta_text }}</a>
  </div>
</section>

<style>
  [section-id="{{ sectionId }}"].sbm-section {
    background: var(--mc-bg, #fff);
    overflow: hidden;
  }

  /* DESKTOP */
  [section-id="{{ sectionId }}"] .sbm-desktop {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px 56px 40px;
  }
  [section-id="{{ sectionId }}"] .sbm-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  [section-id="{{ sectionId }}"] .sbm-header__right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 8px;
    width: 327px;
  }
  [section-id="{{ sectionId }}"] .sbm-title {
    margin: 0;
    width: 100%;
    font-size: 30px;
    font-weight: 500;
    line-height: 36px;
    color: var(--mc-text, #000);
    text-align: right;
  }
  [dir="ltr"] [section-id="{{ sectionId }}"] .sbm-title {
    text-align: left;
  }
  [section-id="{{ sectionId }}"] .sbm-subtitle {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: var(--mc-text, #000);
    text-align: right;
  }
   [dir="ltr"] [section-id="{{ sectionId }}"] .sbm-subtitle {
    text-align: left;}

  [section-id="{{ sectionId }}"] .sbm-cta {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 24px;
    border: 1px solid var(--mc-cta-border, #000);
    background: transparent;
    color: var(--mc-cta-text, #000);
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background 0.2s,
      transform 0.2s;
    cursor: pointer;
  }
  [section-id="{{ sectionId }}"] .sbm-cta:hover {
    background: rgba(0, 0, 0, 0.04);
    transform: translateY(-1px);
  }
  [section-id="{{ sectionId }}"] .sbm-cards {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    gap: 16px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  [section-id="{{ sectionId }}"] .sbm-cards::-webkit-scrollbar {
    display: none;
  }
  [section-id="{{ sectionId }}"] .sbm-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1 1 0%;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }
  [section-id="{{ sectionId }}"] .sbm-card__img {
    position: relative;
    width: 100%;
    height: 320px;
    overflow: hidden;
    background: #f0f0f0;
  }
  [section-id="{{ sectionId }}"] .sbm-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  [section-id="{{ sectionId }}"] .sbm-card:hover .sbm-card__img img {
    transform: scale(1.04);
  }
  [section-id="{{ sectionId }}"] .sbm-tag {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 3px 6px;
    background: var(--mc-tag-bg, #f7512b);
    color: var(--mc-tag-text, #fff);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    white-space: nowrap;
    z-index: 2;
  }
  [section-id="{{ sectionId }}"] .sbm-card__info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  [section-id="{{ sectionId }}"] .sbm-card__name {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 28px;
    color: var(--mc-text, #000);
    text-align: right;
    transition: color 0.25s ease;
  }
   [dir="ltr"] [section-id="{{ sectionId }}"] .sbm-card__name {
    text-align: left;
  }
  [section-id="{{ sectionId }}"] .sbm-card__desc {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: var(--mc-text, #000);
    text-align: right;
    transition: color 0.25s ease;
  }
    [dir="ltr"] [section-id="{{ sectionId }}"] .sbm-card__desc {
      text-align: left;
    }
  [section-id="{{ sectionId }}"] .sbm-card:hover .sbm-card__name,
  [section-id="{{ sectionId }}"] .sbm-card:hover .sbm-card__desc {
    color: var(--mc-hover-text, #fff);
  }

  /* Hide mobile on desktop */
  [section-id="{{ sectionId }}"] .sbm-mobile {
    display: none;
  }

  /* MOBILE */
  @media (max-width: 767px) {
    [section-id="{{ sectionId }}"] .sbm-desktop {
      display: none;
    }
    [section-id="{{ sectionId }}"] .sbm-mobile {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      padding: 24px 16px 16px;
    }
    [section-id="{{ sectionId }}"] .sbm-mob-header {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      width: 100%;
    }
    [section-id="{{ sectionId }}"] .sbm-mob-title {
      margin: 0;
      font-size: 24px;
      font-weight: 500;
      line-height: 32px;
      color: var(--mc-text, #000);
      text-align: center;
      width: 100%;
    }
    [section-id="{{ sectionId }}"] .sbm-mob-sub-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }
    [section-id="{{ sectionId }}"] .sbm-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      background: #f5f5f5;
      border: none;
      cursor: pointer;
      flex-shrink: 0;
      padding: 0;
      color: #000;
      transition: opacity 0.2s;
    }
    [section-id="{{ sectionId }}"] .sbm-arrow:hover {
      opacity: 0.7;
    }
    [section-id="{{ sectionId }}"] .sbm-mob-subtitle {
      margin: 0;
      font-size: 16px;
      font-weight: 400;
      line-height: 24px;
      color: var(--mc-text, #000);
      text-align: center;
    }
    [section-id="{{ sectionId }}"] .sbm-track {
      display: flex;
      flex-direction: row;
      gap: 16px;
      width: 100%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x pan-y;
    }
    [section-id="{{ sectionId }}"] .sbm-track::-webkit-scrollbar {
      display: none;
    }
    [section-id="{{ sectionId }}"] .sbm-mob-card {
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex: 0 0 299px;
      width: 299px;
      scroll-snap-align: start;
      text-decoration: none;
      color: inherit;
    }
    [section-id="{{ sectionId }}"] .sbm-mob-card__img {
      position: relative;
      width: 100%;
      height: 299px;
      overflow: hidden;
      background: #f0f0f0;
    }
    [section-id="{{ sectionId }}"] .sbm-mob-card__img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      user-select: none;
      -webkit-user-drag: none;
    }
    [section-id="{{ sectionId }}"] .sbm-mob-card__info {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    [section-id="{{ sectionId }}"] .sbm-mob-card__name {
      margin: 0;
      font-size: 18px;
      font-weight: 500;
      line-height: 28px;
      color: var(--mc-text, #000);
      text-align: center;
    }
    [section-id="{{ sectionId }}"] .sbm-mob-card__desc {
      margin: 0;
      font-size: 14px;
      font-weight: 400;
      line-height: 20px;
      color: var(--mc-text, #000);
      text-align: center;
    }
    [section-id="{{ sectionId }}"] .sbm-scrollbar {
      display: flex;
      justify-content: center;
      margin-top: 0;
    }
    [section-id="{{ sectionId }}"] .sbm-scrollbar__track {
      width: 180px;
      height: 2px;
      background: #e5e5e5;
      position: relative;
      overflow: hidden;
      border-radius: 1px;
    }
    [section-id="{{ sectionId }}"] .sbm-scrollbar__thumb {
      position: absolute;
      top: 0;
      right: 0;
      height: 100%;
      background: #737373;
      border-radius: 1px;
      transition:
        width 0.3s,
        right 0.3s;
    }
    [section-id="{{ sectionId }}"] .sbm-mob-cta {
      display: block;
      text-align: center;
      font-size: 16px;
      font-weight: 500;
      line-height: 24px;
      color: var(--mc-cta-text, #000);
      text-decoration: underline;
      margin-top: 4px;
    }
  }

  /* TABLET */
  @media (min-width: 768px) and (max-width: 1023px) {
    [section-id="{{ sectionId }}"] .sbm-desktop {
      padding: 24px 24px 32px;
    }
    [section-id="{{ sectionId }}"] .sbm-header__right {
      width: auto;
      max-width: 300px;
    }
    [section-id="{{ sectionId }}"] .sbm-card__img {
      height: 240px;
    }
    [section-id="{{ sectionId }}"] .sbm-title {
      font-size: 24px;
      line-height: 32px;
    }
  }
</style>

<script>
  (function () {
    var s = document.querySelector('[section-id="{{ sectionId }}"].sbm-section');
    if (!s) return;
    var track = s.querySelector("[data-sbm-track]"),
      thumb = s.querySelector("[data-sbm-thumb]"),
      prev = s.querySelector("[data-sbm-prev]"),
      next = s.querySelector("[data-sbm-next]");
    if (!track) return;
    var cards = track.querySelectorAll(".sbm-mob-card");
    if (!cards.length) return;
    function updateThumb() {
      if (!thumb) return;
      var max = track.scrollWidth - track.clientWidth;
      if (max <= 0) {
        thumb.style.width = "100%";
        thumb.style.right = "0";
        return;
      }
      var pos = Math.abs(track.scrollLeft),
        ratio = pos / max,
        tw = (track.clientWidth / track.scrollWidth) * 100;
      thumb.style.width = tw + "%";
      thumb.style.right = ratio * (100 - tw) + "%";
    }
    function scroll(dir) {
      var w = cards[0].offsetWidth + 16;
      track.scrollBy({ left: dir === "next" ? -w : w, behavior: "smooth" });
    }
    if (prev)
      prev.addEventListener("click", function () {
        scroll("prev");
      });
    if (next)
      next.addEventListener("click", function () {
        scroll("next");
      });
    track.addEventListener("scroll", updateThumb, { passive: true });
    window.addEventListener("resize", updateThumb);
    setTimeout(updateThumb, 100);
  })();
</script>
