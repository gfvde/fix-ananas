{% set is_lazy = (settings.order | default(3) | int) > 2 %}
{% set title_text = settings.title | default(_('Choose your look')) %}
{% set subtitle_text = settings.subtitle | default(_('A look for every occasion, find what suits you here')) %}
{% set cta_text = settings.cta_text | default(_('Shop by occasion')) %}
{% set cta_url = settings.cta_url | default('#') %}
{% set section_bg_color = settings.section_bg_color | default('transparent', true) %}
{% set text_color = settings.text_color | default('#000000') %}
{% set tag_bg_color = settings.tag_bg_color | default('#6B4A39', true) %}
{% set tag_text_color = settings.tag_text_color | default('#ffffff') %}
{% set cta_border_color = settings.cta_border_color | default('#000000') %}
{% set cta_text_color = settings.cta_text_color | default('#000000') %}
{% set hover_text_color = settings.hover_text_color | default('#6B4A39', true) %}

{%
  set cards = [
    { 'image': settings.card1_image, 'tag': settings.card1_tag | default(_('Your everyday')), 'title': settings.card1_title | default(_('Everyday abayas')), 'desc': settings.card1_desc | default(_('A light look for your day')), 'url': settings.card1_url | default('#') },
    { 'image': settings.card2_image, 'tag': settings.card2_tag | default(_('Wide, calm cuts')), 'title': settings.card2_title | default(_('Comfortable fashion')), 'desc': settings.card2_desc | default(_('Comfortable cuts for calm moments')), 'url': settings.card2_url | default('#') },
    { 'image': settings.card3_image, 'tag': settings.card3_tag | default(_('Work elegance')), 'title': settings.card3_title | default(_('Work looks')), 'desc': settings.card3_desc | default(_('Simple looks for the work day')), 'url': settings.card3_url | default('#') },
    { 'image': settings.card4_image, 'tag': settings.card4_tag | default(_('Your occasions')), 'title': settings.card4_title | default(_('Occasion abayas')), 'desc': settings.card4_desc | default(_('Discover new details for every occasion')), 'url': settings.card4_url | default('#') }
  ]
%}

<link rel="stylesheet" href="{{ 'css/sections/about-shop-by-mood.css' | asset_url }}">
<section
  section-id="{{ sectionId }}" data-section="about-shop-by-mood"
  data-no-mb="{{ 'true' if settings.remove_bottom_margin else 'false' }}"
  class="sbm-section"
  style="--mc-bg:{{ section_bg_color }};--mc-text:{{ text_color }};--mc-tag-bg:{{ tag_bg_color }};--mc-tag-text:{{ tag_text_color }};--mc-cta-border:{{ cta_border_color }};--mc-cta-text:{{ cta_text_color }};--mc-hover-text:{{ hover_text_color }};"
>
  {# DESKTOP #}
  <div class="sbm-desktop">
    <div class="sbm-header">
      <div class="sbm-header__right">
        <h2 class="sbm-title">{{ title_text }}</h2>
        <p class="sbm-subtitle">{{ subtitle_text }}</p>
      </div>
      <a
        href="{{ cta_url }}"
        class="sbm-cta"
      >
        <span>{{ cta_text }}</span>
      </a>
    </div>
    <div class="sbm-cards">
      {% for card in cards %}
        <a
          href="{{ card.url }}"
          class="sbm-card"
        >
          <div class="sbm-card__img">
            {% if card.image %}
            <img
              src="{{ image_url(card.image, w=800, f='auto') }}"
              alt="{{ card.title }}"
              width="800"
              height="640"
              {% if is_lazy %}loading="lazy" {% endif %}decoding="async"
            />
            {% endif %}
            {% if card.tag %}<span class="sbm-tag">{{ card.tag }}</span>{% endif %}
          </div>
          <div class="sbm-card__info">
            <h3 class="sbm-card__name">{{ card.title }}</h3>
            <p class="sbm-card__desc">{{ card.desc }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>

  {# MOBILE #}
  <div class="sbm-mobile">
    <div class="sbm-mob-header">
      <h2 class="sbm-mob-title">{{ title_text }}</h2>
      <div class="sbm-mob-sub-row">
        <button
          class="sbm-arrow"
          data-sbm-prev
          aria-label="{{ _('Previous') }}"
        >
          <svg
            width="5"
            height="10"
            viewBox="0 0 5 10"
            fill="none"
          >
            <path
              d="M1 1L4 5L1 9"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <p class="sbm-mob-subtitle">{{ settings.mobile_subtitle | default(_('A look for every occasion')) }}</p>
        <button
          class="sbm-arrow"
          data-sbm-next
          aria-label="{{ _('Next') }}"
        >
          <svg
            width="5"
            height="10"
            viewBox="0 0 5 10"
            fill="none"
          >
            <path
              d="M4 1L1 5L4 9"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </div>
    <div
      class="sbm-track"
      data-sbm-track
    >
      {% for card in cards %}
        <a
          href="{{ card.url }}"
          class="sbm-mob-card"
        >
          <div class="sbm-mob-card__img">
            {% if card.image %}
            <img
              src="{{ image_url(card.image, w=600, f='auto') }}"
              alt="{{ card.title }}"
              width="600"
              height="598"
              {% if is_lazy %}loading="lazy" {% endif %}decoding="async"
            />
            {% endif %}
            {% if card.tag %}<span class="sbm-tag">{{ card.tag }}</span>{% endif %}
          </div>
          <div class="sbm-mob-card__info">
            <h3 class="sbm-mob-card__name">{{ card.title }}</h3>
            <p class="sbm-mob-card__desc">{{ card.desc }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
    <div class="sbm-scrollbar">
      <div class="sbm-scrollbar__track">
        <div
          class="sbm-scrollbar__thumb"
          data-sbm-thumb
        ></div>
      </div>
    </div>
    <a
      href="{{ cta_url }}"
      class="sbm-mob-cta"
    >{{ cta_text }}</a>
  </div>
</section>


<script defer src="{{ 'js/sections/about-shop-by-mood.js' | asset_url }}"></script>
