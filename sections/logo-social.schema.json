      }
    },
    {
      "id": "logo_logo_mobile",
      "type": "image",
      "label": {
        "ar": "الشعار (الجوال)",
        "en": "Logo (Mobile)"
      },
      "info": {
        "ar": "اتركه فارغًا لاستخدام شعار سطح المكتب",
        "en": "Leave empty to use the desktop logo"
      }
