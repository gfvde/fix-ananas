{
  "template": "sections/ananas-banner.jinja",
  "name": {
    "ar": "بانر الهوم (فيجما)",
    "en": "Home Banner (Figma)"
  },
  "icon": "image-line",
  "meta": { "type": "slider" },
  "settings": [
    {
      "id": "background_image",
      "type": "image",
      "label": {
        "ar": "صورة الخلفية (سطح المكتب)",
        "en": "Background Image (Desktop)"
      }
    },
    {
      "id": "background_image_mobile",
      "type": "image",
      "label": {
        "ar": "صورة الخلفية (موبايل)",
        "en": "Background Image (Mobile)"
      }
    },
    {
      "id": "overlay_opacity",
      "type": "range",
      "label": {
        "ar": "شفافية الطبقة",
        "en": "Overlay Opacity"
      },
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "id": "heading",
      "type": "text",
      "label": {
        "ar": "العنوان الرئيسي",
        "en": "Heading"
      },
      "default": "قهوة تضبط يومك"
    },
    {
      "id": "description",
      "type": "textarea",
      "label": {
        "ar": "الوصف",
        "en": "Description"
      },
      "default": "تجربة جريئة محمصة بعناية لتجربة تفهم جوك"
    },
    {
      "id": "rating_value",
      "type": "text",
      "label": {
        "ar": "قيمة التقييم",
        "en": "Rating Value"
      },
      "default": "4.8"
    },
    {
      "id": "rating_stars",
      "type": "range",
      "label": {
        "ar": "النجوم",
        "en": "Stars"
      },
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "id": "avatars",
      "type": "list",
      "label": {
        "ar": "صور المستخدمين",
        "en": "User Avatars"
      },
      "max_items": 4,
      "settings": [
        {
          "id": "image",
          "type": "image",
          "label": {
            "ar": "الصورة",
            "en": "Image"
          }
        }
      ],
      "default": []
    },
    {
      "id": "button_text",
      "type": "text",
      "label": {
        "ar": "نص الزر",
        "en": "Button Text"
      },
      "default": "تسوّق قهوتك الآن"
    },
    {
      "id": "button_url",
      "type": "url",
      "label": {
        "ar": "رابط الزر",
        "en": "Button URL"
      },
      "default": ""
    },
    {
      "id": "background_color",
      "type": "color",
      "label": {
        "ar": "لون الخلفية",
        "en": "Background Color"
      },
      "default": "transparent"
    },
    {
      "id": "remove_bottom_margin",
      "type": "checkbox",
      "label": {
        "ar": "إزالة المسافة السفلية",
        "en": "Remove Bottom Margin"
      },
      "default": false
    }
  ]
}