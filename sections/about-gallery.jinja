<link rel="stylesheet" href="{{ 'css/sections/about-gallery.css' | asset_url }}">
<section section-id="{{ sectionId }}" data-section="about-gallery"
  data-no-mb="{{ 'true' if settings.remove_bottom_margin else 'false' }}" 
  class="py-6 px-4 md:py-10 md:px-14" 
  style="background-color: {{ settings.background_color | default('#ffffff') }};"
  data-carousel>
  
  {% set border_radius = settings.border_radius | default(8) %}
  {% set title_color = settings.title_color | default('#000000') %}
  {% set subtitle_color = settings.subtitle_color | default('#000000') %}

  {# Desktop Header #}
  <div class="hidden md:flex flex-col gap-2 items-center text-center mb-6">
    <h2 class="text-3xl font-medium" style="color: {{ title_color }};">{{ settings.title | default(_('Moments from the world of Ananas')) }}</h2>
    <p class="text-base" style="color: {{ subtitle_color }};">{{ settings.subtitle | default(_('Coffee is not just for drinking… it is for living')) }}</p>
  </div>

  {# Mobile Header with Arrows #}
  <div class="flex flex-col gap-2 items-center text-center mb-4 md:hidden">
    <h2 class="text-2xl font-medium" style="color: {{ title_color }};">{{ settings.title | default(_('Moments from the world of Ananas')) }}</h2>
    <div class="flex items-center gap-4">
      <button data-carousel-prev class="w-6 h-6 flex items-center justify-center bg-[#f5f5f5]  flex-shrink-0 transition-opacity hover:opacity-80" aria-label="{{ _('Previous') }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rotate-180"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <p class="text-sm" style="color: {{ subtitle_color }};">{{ settings.subtitle | default(_('Coffee is not just for drinking… it is for living')) }}</p>
      <button data-carousel-next class="w-6 h-6 flex items-center justify-center bg-[#f5f5f5]  flex-shrink-0 transition-opacity hover:opacity-80" aria-label="{{ _('Next') }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
    </div>
  </div>

  {% set items_list = safeget(settings, "media_items", []) | select | list %}

  {# Desktop Grid: 10 items max #}
  <div class="hidden md:grid grid-cols-5 gap-2.5">
    {% for i in range(10) %}
      {% if items_list | length > i %}
        {% set item = items_list[i] %}
        <div class="relative w-full aspect-square overflow-hidden ag-media-cell" style="border-radius: {{ border_radius }}px;">
          {% if item.video %}
            <video src="{{ item.video }}" playsinline class="w-full h-full object-cover ag-video"></video>
            <button class="ag-play-btn" aria-label="{{ _('Play video') }}">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" width="44" height="44">
                <circle cx="28" cy="28" r="28" fill="rgba(0,0,0,0.45)"/>
                <path d="M23 18L38 28L23 38V18Z" fill="white"/>
              </svg>
            </button>
          {% elif item.image %}
            <img src="{{ image_url(item.image, w=400, f='auto') }}" class="w-full h-full object-cover" alt="" width="400" height="400" loading="lazy" decoding="async" />
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {# Mobile Slider: 2 slides of 4 items max #}
  <div class="md:hidden">
    <div class="overflow-hidden" data-carousel-viewport>
      <div class="flex">
        {% for slide_idx in range(2) %}
          {% set start_idx = slide_idx * 4 %}
          {% if items_list | length > start_idx %}
            <div class="embla__slide flex-none w-full min-w-0">
              <div class="grid grid-cols-2 gap-2">
                {% for i in range(start_idx, start_idx + 4) %}
                  {% if items_list | length > i %}
                    {% set item = items_list[i] %}
                    <div class="relative w-full aspect-square overflow-hidden ag-media-cell" style="border-radius: {{ border_radius }}px;">
                      {% if item.video %}
                        <video src="{{ item.video }}" playsinline class="w-full h-full object-cover ag-video"></video>
                        <button class="ag-play-btn" aria-label="{{ _('Play video') }}">
                          <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" width="44" height="44">
                            <circle cx="28" cy="28" r="28" fill="rgba(0,0,0,0.45)"/>
                            <path d="M23 18L38 28L23 38V18Z" fill="white"/>
                          </svg>
                        </button>
                      {% elif item.image %}
                        <img src="{{ image_url(item.image, w=400, f='auto') }}" class="w-full h-full object-cover" alt="" width="400" height="400" loading="lazy" decoding="async" />
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    
    {# Pagination Scrollbar #}
    <div class="flex justify-center mt-4">
       <div class="w-[180px] h-[2px] bg-[#E5E5E5] relative overflow-hidden rounded-full flex flex-row-reverse">
         <div class="h-full bg-[#737373] transition-all duration-300" data-carousel-progress style="width: 50%;"></div>
       </div>
    </div>
  </div>



<script defer src="{{ 'js/sections/about-gallery.js' | asset_url }}"></script>

</section>
