{% set products_source = settings.products_source | default('tabs', true) %}
{% set single_products = settings.products.results if settings.products and settings.products.results else [] %}
{% set tab_1_products = settings.tab_1_products.results if settings.tab_1_products and settings.tab_1_products.results else [] %}
{% set tab_2_products = settings.tab_2_products.results if settings.tab_2_products and settings.tab_2_products.results else [] %}

{% if (products_source == 'products' and single_products) or (products_source != 'products' and (tab_1_products or tab_2_products)) %}
  {% set layout = settings.layout | default('carousel') %}
  {% set single_products_url = settings.products.url if settings.products and settings.products.url else '' %}
  {% set tab_1_url = settings.tab_1_products.url if settings.tab_1_products and settings.tab_1_products.url else '' %}
  {% set tab_2_url = settings.tab_2_products.url if settings.tab_2_products and settings.tab_2_products.url else '' %}
  {% set more_fallback_url = single_products_url or tab_2_url or tab_1_url or url_for('list_products') %}
  {% set more_url = settings.more_url | default(more_fallback_url, true) %}
  {% set more_text = settings.more_text | default(_('View all'), true) %}
  {% set title = settings.title | default(_('What we recommend for you'), true) %}
  {% set subtitle = settings.subtitle | default(_('A variety of flavors to suit your taste'), true) %}
  {% set explore_text = settings.explore_text | default(_('Explore your flavor'), true) %}
  {% set explore_url = settings.explore_url | default(more_url, true) %}
  {% set tab_1_text = settings.tab_1_text | default(_('Our newest'), true) %}
  {% set tab_2_text = settings.tab_2_text | default(_('Best selling'), true) %}
  {% set active_tab = settings.active_tab | default('tab_2', true) %}
  {% set mobile_tabs_layout = settings.mobile_tabs_layout | default('arrows', true) %}
  {% set use_single_products = products_source == 'products' %}
  {% set products_limit = settings.products_limit | default(12, true) | int %}
  {% if use_single_products %}
    {% set active_tab = 'products' %}
    {% set tabs = [{'id': 'products', 'label': title, 'products': single_products[:products_limit]}] %}
  {% else %}
    {# Tabs without products are dropped; the active tab falls back to the first one left #}
    {% set tabs = [] %}
    {% if tab_1_products %}{% set tabs = tabs + [{'id': 'tab_1', 'label': tab_1_text, 'products': tab_1_products[:products_limit]}] %}{% endif %}
    {% if tab_2_products %}{% set tabs = tabs + [{'id': 'tab_2', 'label': tab_2_text, 'products': tab_2_products[:products_limit]}] %}{% endif %}
    {% if active_tab not in tabs | map(attribute='id') | list %}
      {% set active_tab = tabs[0].id %}
    {% endif %}
  {% endif %}

  <link rel="stylesheet" href="{{ 'css/sections/products.css' | asset_url }}">
  <section
    section-id="{{ sectionId }}" data-section="products"
  data-no-mb="{{ 'true' if settings.remove_bottom_margin else 'false' }}"
    class="section-products fp-section fp-section--{{ layout }} fp-mobile-tabs--{{ mobile_tabs_layout }} {% if use_single_products %}fp-section--single-source{% endif %}"
    style="
      --fp-bg: {{ settings.background_color | default('#FCFAF7', true) }};
      --fp-text: {{ settings.text_color | default('#000000', true) }};
      --fp-muted: {{ settings.muted_color | default('#737373', true) }};
      --fp-chip-bg: {{ settings.chip_bg_color | default('#F0F0F0', true) }};
      --fp-tab-bg: {{ settings.tab_bg_color | default('#FCFAF7', true) }};
      --fp-active-tab-bg: {{ settings.active_tab_bg_color | default('#262626', true) }};
      --fp-active-tab-text: {{ settings.active_tab_text_color | default('#FFFFFF', true) }};
      --fp-border: {{ settings.border_color | default('#000000', true) }};
      --fp-badge-bg: {{ settings.badge_bg_color | default('#F7512B', true) }};
      --fp-badge-text: {{ settings.badge_text_color | default('#FFFFFF', true) }};
      --fp-button-bg: {{ settings.button_bg_color | default('transparent', true) }};
      --fp-button-text: {{ settings.button_text_color | default('#000000', true) }};
      --fp-progress-bg: {{ settings.progress_bg_color | default('#E5E5E5', true) }};
      --fp-progress-fill: {{ settings.progress_fill_color | default('#737373', true) }};
    "
    data-fp-section
  >
    <div class="fp-inner">
      <div class="fp-header fp-header--desktop">
        <div class="fp-header__top">
          {% if settings.display_more and more_text %}
            <a
              href="{{ more_url }}"
              class="fp-cta"
            >{{ more_text }}</a
            >
          {% endif %}
          <div class="fp-title-wrap">
            <h2 class="fp-title">{{ title }}</h2>
            {% if subtitle %}
              <p class="fp-subtitle fp-subtitle--desktop">{{ subtitle }}</p>
            {% endif %}
          </div>
        </div>
        {% if not use_single_products %}
          <div class="fp-tabs">
            {% for tab in tabs %}
              <button
                type="button"
                class="fp-tab {% if active_tab == tab.id %}is-active{% endif %}"
                data-fp-tab="{{ tab.id }}"
                aria-selected="{{ 'true' if active_tab == tab.id else 'false' }}"
              >
                {{ tab.label }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {% if layout == 'grid' %}
        <div class="fp-header fp-header--mobile-grid">
          <div class="fp-mobile-copy">
            <h2 class="fp-title">{{ title }}</h2>
            {% if subtitle %}
              <p class="fp-subtitle">{{ subtitle }}</p>
            {% endif %}
          </div>
          {% if not use_single_products %}
            <div class="fp-tabs fp-tabs--mobile">
              {% for tab in tabs %}
                <button
                  type="button"
                  class="fp-tab {% if active_tab == tab.id %}is-active{% endif %}"
                  data-fp-tab="{{ tab.id }}"
                  aria-selected="{{ 'true' if active_tab == tab.id else 'false' }}"
                >
                  {{ tab.label }}
                </button>
              {% endfor %}
            </div>
            <div class="fp-mobile-link-row">
              <button
                type="button"
                class="fp-mobile-arrow"
                aria-label="{{ _('Previous') }}"
                data-fp-mobile-prev
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M15.2 18.1 9.1 12l6.1-6.1-1.4-1.4L6.3 12l7.5 7.5 1.4-1.4Z" />
                </svg>
              </button>
              <button
                type="button"
                class="fp-explore"
                data-fp-mobile-tab-label
              >
                {% for tab in tabs %}
                  {% if active_tab == tab.id %}{{ tab.label }}{% endif %}
                {% endfor %}
              </button>
              <button
                type="button"
                class="fp-mobile-arrow"
                aria-label="{{ _('Next') }}"
                data-fp-mobile-next
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="m8.8 18.1 6.1-6.1-6.1-6.1 1.4-1.4 7.5 7.5-7.5 7.5-1.4-1.4Z" />
                </svg>
              </button>
            </div>
          {% endif %}
        </div>
      {% else %}
        <div class="fp-header fp-header--mobile-carousel">
          <div class="fp-mobile-copy">
            <h2 class="fp-title">{{ title }}</h2>
            {% if subtitle %}
              <p class="fp-subtitle">{{ subtitle }}</p>
            {% endif %}
          </div>
          {% if not use_single_products %}
            <div class="fp-tabs fp-tabs--mobile">
              {% for tab in tabs %}
                <button
                  type="button"
                  class="fp-tab {% if active_tab == tab.id %}is-active{% endif %}"
                  data-fp-tab="{{ tab.id }}"
                  aria-selected="{{ 'true' if active_tab == tab.id else 'false' }}"
                >
                  {{ tab.label }}
                </button>
              {% endfor %}
            </div>
            <div class="fp-mobile-link-row">
              <button
                type="button"
                class="fp-mobile-arrow"
                aria-label="{{ _('Previous') }}"
                data-fp-mobile-prev
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M15.2 18.1 9.1 12l6.1-6.1-1.4-1.4L6.3 12l7.5 7.5 1.4-1.4Z" />
                </svg>
              </button>
              <button
                type="button"
                class="fp-explore"
                data-fp-mobile-tab-label
              >
                {% for tab in tabs %}
                  {% if active_tab == tab.id %}{{ tab.label }}{% endif %}
                {% endfor %}
              </button>
              <button
                type="button"
                class="fp-mobile-arrow"
                aria-label="{{ _('Next') }}"
                data-fp-mobile-next
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="m8.8 18.1 6.1-6.1-6.1-6.1 1.4-1.4 7.5 7.5-7.5 7.5-1.4-1.4Z" />
                </svg>
              </button>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if layout == 'grid' %}
        {% for tab in tabs %}
          <div
            class="fp-panel {% if active_tab != tab.id %}is-hidden{% endif %}"
            data-fp-panel="{{ tab.id }}"
          >
            <div
              class="fp-grid"
              data-grid-root="true"
              data-grid="grid"
            >
              {% for product in tab.products %}
                {% with index=loop.index0, product_card_variant='pc-card--figma-products pc-card--figma-grid', is_priority=(loop.first and (settings.order | default(3) | int) <= 2), show_static_cta=false %}
                  {% include 'components/products/product-card.jinja' %}
                {% endwith %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
        <div class="fp-progress">
          <div class="fp-progress__bar"></div>
        </div>
      {% else %}
        {% for tab in tabs %}
          <div
            class="fp-panel {% if active_tab != tab.id %}is-hidden{% endif %}"
            data-fp-panel="{{ tab.id }}"
          >
            <div class="fp-carousel">
              <div class="fp-carousel__viewport">
                <div class="fp-carousel__container">
                  {% for product in tab.products %}
                    <div class="fp-carousel__slide">
                      {% with index=loop.index0, product_card_variant='pc-card--figma-products pc-card--figma-carousel', is_priority=(loop.first and (settings.order | default(3) | int) <= 2), show_static_cta=false %}
                        {% include 'components/products/product-card.jinja' %}
                      {% endwith %}
                    </div>
                  {% endfor %}
                </div>
              </div>
              <div class="fp-progress">
                <div class="fp-progress__bar"></div>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}

      {% if settings.display_more and explore_text %}
        <a href="{{ explore_url }}" class="fp-explore fp-explore--mobile">{{ explore_text }}</a>
      {% endif %}
    </div>
  </section>


  <script defer src="{{ 'js/sections/products.js' | asset_url }}"></script>
{% endif %}
