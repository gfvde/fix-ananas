{% set is_lazy = (settings.order | default(3) | int) > 2 %}
{% set section_bg_color = settings.section_bg_color | default('#ffffff') %}
{% set title_color = settings.title_color | default('#000000') %}
{% set card_text_color = settings.card_text_color | default('#ffffff') %}
{% set hover_text = settings.hover_text | default(_('View the collection')) %}
{% set hover_text_color = settings.hover_text_color | default('#ffffff') %}
{% set mobile_text_color = settings.mobile_text_color | default('#000000') %}
{% set overlay_color = settings.overlay_color | default('#000000') %}
{% set overlay_opacity = settings.overlay_opacity | default(22) %}
{% set mobile_overlay_bg_color = settings.mobile_overlay_bg_color | default('#ffffff') %}
{% set mobile_layout = settings.mobile_layout | default('caption') %}
{% set scroll_effect_enabled = settings.scroll_effect_enabled | default(false) %}
{% set scroll_effect_strength = settings.scroll_effect_strength | default(18) %}
{% set mobile_image_height = settings.mobile_image_height | default(150) %}

<link rel="stylesheet" href="{{ 'css/sections/about-shop-by-category.css' | asset_url }}">
<section
  section-id="{{ sectionId }}" data-section="about-shop-by-category"
  data-no-mb="{{ 'true' if settings.remove_bottom_margin else 'false' }}"
  class="shop-by-category"
  data-mobile-layout="{{ mobile_layout }}"
  data-scroll-effect="{{ 'true' if scroll_effect_enabled else 'false' }}"
  data-scroll-strength="{{ scroll_effect_strength }}"
  style="
    --sbc-bg: {{ section_bg_color }};
    --sbc-mobile-image-height: {{ mobile_image_height }}px;
    --sbc-title-color: {{ title_color }};
    --sbc-card-text: {{ card_text_color }};
    --sbc-hover-text: {{ hover_text_color }};
    --sbc-mobile-text: {{ mobile_text_color }};
    --sbc-overlay: {{ overlay_color }};
    --sbc-overlay-opacity: {{ overlay_opacity / 100 }};
    --sbc-mobile-overlay-bg: {{ mobile_overlay_bg_color }};
  "
>
  <h2 class="shop-by-category__title">{{ settings.title | default(_('Shop by your choice')) }}</h2>
  <div class="sbc-grid">

    {% set cats = [
      { 'name': settings.cat1_name | default(_('Coffee drip bags')),   'url': settings.cat1_url | default('', true), 'img': settings.cat1_img, 'text_color': settings.cat1_text_color | default(card_text_color) },
      { 'name': settings.cat2_name | default(_('Coffee harvests')), 'url': settings.cat2_url | default('', true), 'img': settings.cat2_img, 'text_color': settings.cat2_text_color | default(card_text_color) },
      { 'name': settings.cat3_name | default(_('Bundles')),     'url': settings.cat3_url | default('', true), 'img': settings.cat3_img, 'text_color': settings.cat3_text_color | default(card_text_color) },
      { 'name': settings.cat4_name | default(_('Spring offers')),   'url': settings.cat4_url | default('', true), 'img': settings.cat4_img, 'text_color': settings.cat4_text_color | default(card_text_color) },
      { 'name': settings.cat5_name | default(_('Ananas products')), 'url': settings.cat5_url | default('', true), 'img': settings.cat5_img, 'text_color': settings.cat5_text_color | default(card_text_color) },
      { 'name': settings.cat6_name | default(_('Coffee tools')),  'url': settings.cat6_url | default('', true), 'img': settings.cat6_img, 'text_color': settings.cat6_text_color | default(card_text_color) }
    ] %}

    {% for cat in cats if cat.img %}
      {% set card_tag = 'a' if cat.url else 'div' %}
      <div class="category-card" style="--sbc-item-text: {{ cat.text_color }};">
        <{{ card_tag }} {% if cat.url %}href="{{ cat.url }}" aria-label="{{ cat.name }}" {% endif %}class="category-card__media" data-sbc-parallax-card>
          <img
            src="{{ image_url(cat.img, w=900, f='auto') }}"
            alt="{{ cat.name }}"
            width="900"
            height="1044"
            {% if is_lazy %}loading="lazy" {% endif %}decoding="async"
            data-sbc-parallax-img
          />
          <span class="category-card__name">{{ cat.name }}</span>
          {% if hover_text %}
            <span class="category-card__hover-cta">
              <span>{{ hover_text }}</span>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          {% endif %}
        </{{ card_tag }}>
        <{{ card_tag }} {% if cat.url %}href="{{ cat.url }}" {% endif %}class="category-card__mobile-name">{{ cat.name }}</{{ card_tag }}>
      </div>
    {% endfor %}

  </div>
</section>


<script defer src="{{ 'js/sections/about-shop-by-category.js' | asset_url }}"></script>
