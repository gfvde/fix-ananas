{
  "template": "sections/categories.jinja",
  "name": {
    "ar": "التصنيفات",
    "en": "Categories"
  },
  "icon": "grid-line",
  "meta": { "type": "categories" },
  "settings": [
    {
      "id": "title",
      "type": "text",
      "label": {
        "ar": "العنوان",
        "en": "Title"
      },
      "default": "Discover our signature collections"
    },
    {
      "id": "categories",
      "type": "list",
      "label": {
        "ar": "التصنيفات",
        "en": "Categories"
      },
      "max_items": 12,
      "settings": [
        {
          "id": "category",
          "type": "category",
          "label": {
            "ar": "اختر التصنيف",
            "en": "Select category"
          }
        }
      ],
      "default": []
    },
    {
      "id": "more_text",
      "type": "text",
      "label": {
        "ar": "نص زر جميع التصنيفات",
        "en": "View all button text"
      },
      "default": "View all"
    },
    {
      "id": "display_more",
      "type": "checkbox",
      "label": {
        "ar": "عرض زر جميع التصنيفات",
        "en": "Display view all button"
      },
      "default": false
    },
    {
      "id": "background_color",
      "type": "color",
      "label": {
        "ar": "لون الخلفية",
        "en": "Background Color"
      },
      "default": "transparent"
    },
    {
      "id": "remove_bottom_margin",
      "type": "checkbox",
      "label": {
        "ar": "إزالة المسافة السفلية",
        "en": "Remove Bottom Margin"
      },
      "default": false
    }
  ]
}