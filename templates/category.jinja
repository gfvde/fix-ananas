{% extends "layout.jinja" %}

{% block title %}{{ store.name }} – {{ category.name }}{% endblock %}

{% block content %}
  {% set category_page_settings = settings.category_page if settings.category_page is defined and settings.category_page else {} %}
  {% if category_page_settings.enabled is defined %}
    {% set category_page_enabled = category_page_settings.enabled %}
  {% elif settings.enabled is defined %}
    {% set category_page_enabled = settings.enabled %}
  {% elif settings.category_page_enabled is defined %}
    {% set category_page_enabled = settings.category_page_enabled %}
  {% elif settings.category_page_category_page_enabled is defined %}
    {% set category_page_enabled = settings.category_page_category_page_enabled %}
  {% else %}
    {% set category_page_enabled = false %}
  {% endif %}
  {% set category_page_enabled_value = category_page_enabled|string|lower|trim %}
  {% if category_page_settings.filter_layout is defined %}
    {% set category_filter_layout = category_page_settings.filter_layout %}
  {% elif settings.filter_layout is defined %}
    {% set category_filter_layout = settings.filter_layout %}
  {% elif settings.category_page_filter_layout is defined %}
    {% set category_filter_layout = settings.category_page_filter_layout %}
  {% elif settings.category_page_category_page_filter_layout is defined %}
    {% set category_filter_layout = settings.category_page_category_page_filter_layout %}
  {% else %}
    {% set category_filter_layout = 'drawer' %}
  {% endif %}
  {% set category_filters_sidebar = category_filter_layout == 'sidebar' %}
  {% set category_infinite_scroll_enabled_bool = true %}
  {% set category_products_shell_class = 'products-with-sidebar products-with-sidebar--ready' if category_filters_sidebar else 'flex items-center gap-2' %}

  {% if category_page_enabled_value in ['true', '1', 'on', 'yes'] %}
    {% include 'components/categories/category-page-banner.jinja' %}
  {% endif %}

  {# Products Section #}
  <section class="px-4  pb-8 md:px-16 md:py-6">
    <div class="theme-container">
      <div
        id="products-content"
        class="flex flex-col gap-3 md:gap-6 transition-opacity duration-200"
      >
        <div
          class="{{ category_products_shell_class }}"
          {% if category_filters_sidebar %}dir="ltr"{% endif %}
        >
          {% if category_filters_sidebar %}
            {% include 'components/products/filters/sidebar-topbar.jinja' %}
          {% endif %}
          <div
            class="min-w-0"
            {% if category_filters_sidebar %}dir="rtl"{% endif %}
          >
            {# Products Header with Filters #}
            {% include 'components/products/products-header.jinja' %}

            {# Products Grid #}
            {% if products and products.results and products.results|length > 0 %}
              <div
                data-grid-root="true"
                data-grid="four"
                class="group/grid grid gap-x-3 gap-y-4 md:gap-x-4 md:gap-y-10"
              >
                {% for product in products.results %}
                  {% include 'components/products/product-card.jinja' %}
                {% endfor %}
              </div>

              {% set totalPages = ((products.count / (session.query_params.get('page_size') or 24)|int) | round(0, 'ceil')) | int %}
              {% set currentPage = products.page %}
              {% if category_infinite_scroll_enabled_bool %}
                {% include 'components/products/infinite-scroll.jinja' %}
              {% else %}
                {% include 'components/products/pagination.jinja' %}
              {% endif %}
            {% else %}
              <div class="bg-secondary flex flex-col items-center justify-center rounded-lg py-16">
                <p class="text-muted text-sm">{{ _("No products found in this category") }}</p>
              </div>
            {% endif %}
          </div>
          {% if category_filters_sidebar %}
            {% include 'components/products/filters/sidebar-filters.jinja' %}
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {# Quick View Modal #}
  {% include 'components/products/quick-view-modal.jinja' %}
  {% if category_filters_sidebar %}
    {% include 'components/products/filters/sidebar-layout-ready.jinja' %}
  {% endif %}

  <script>
    (function () {
      // Track grid mode separately for desktop and mobile
      let desktopGridMode = "four";
      let mobileGridMode = "{{ card_columns_mobile | default('1') }}" === "1" ? "one" : "four";

      function isMobile() {
        return window.matchMedia("(max-width: 767px)").matches;
      }

      function getCurrentMode() {
        return isMobile() ? mobileGridMode : desktopGridMode;
      }

      function initGridControls() {
        const gridRoot = document.querySelector("[data-grid-root]");

        if (!gridRoot) return;

        // Apply current mode to grid root
        gridRoot.setAttribute("data-grid", getCurrentMode());

        // Update button checked states
        const allButtons = document.querySelectorAll("[data-grid-btn]");
        allButtons.forEach((btn) => {
          const mode = btn.dataset.gridBtn;
          const isDesktopBtn = mode === "four";
          const isMobileBtn = mode === "one";
          const isListBtn = mode === "list";

          let shouldCheck = false;
          if (isDesktopBtn) {
            shouldCheck = mode === desktopGridMode;
          } else if (isMobileBtn) {
            shouldCheck = mobileGridMode === "one";
          } else if (isListBtn) {
            // List button appears on both - check based on current context
            shouldCheck = (isMobile() && mobileGridMode === "list") || (!isMobile() && desktopGridMode === "list");
          }

          btn.checked = shouldCheck;
        });
      }

      function setGrid(mode) {
        const gridRoot = document.querySelector("[data-grid-root]");

        // Update the appropriate mode based on button type
        if (mode === "one") {
          mobileGridMode = mode;
        } else if (mode === "four") {
          desktopGridMode = mode;
        } else if (mode === "list") {
          // List mode updates based on current viewport
          if (isMobile()) {
            mobileGridMode = mode;
          } else {
            desktopGridMode = mode;
          }
        }

        if (gridRoot) {
          gridRoot.setAttribute("data-grid", mode);
        }

        // Update all button states
        initGridControls();
      }

      // Event delegation for grid buttons (works after AJAX swap)
      document.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-grid-btn]");
        if (btn) {
          setGrid(btn.dataset.gridBtn);
        }
      });

      // Handle viewport changes
      const mediaQuery = window.matchMedia("(max-width: 767px)");
      mediaQuery.addEventListener("change", () => {
        const gridRoot = document.querySelector("[data-grid-root]");
        if (gridRoot) {
          gridRoot.setAttribute("data-grid", getCurrentMode());
        }
        initGridControls();
      });

      // Re-initialize after AJAX swap
      window.addEventListener("products-updated", initGridControls);

      // Initial setup
      initGridControls();
    })();
  </script>
{% endblock %}
