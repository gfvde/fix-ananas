            <path d="M26.6451 7.02734C27.2035 7.20741 27.7353 7.48273 28.2377 7.80656C26.8729 9.27479 25.832 11.1157 25.2542 13.1314C24.802 14.6826 24.6045 16.3212 24.6193 17.9501C24.6058 19.184 24.763 20.4114 24.7401 21.646C24.7466 24.3093 24.0499 26.9704 22.7315 29.1938C22.1208 30.221 21.3986 31.1713 20.5671 31.9857C20.4434 32.1119 20.3245 32.2431 20.2084 32.3775C19.6606 32.2165 19.1369 31.9652 18.6406 31.6615C18.8134 31.3819 19.0425 31.1562 19.2352 30.8956C19.5826 30.4417 19.9149 29.9719 20.202 29.4676C21.5349 27.2249 22.164 24.5202 22.1988 21.8451C22.1959 20.9649 22.1656 20.0832 22.1066 19.2052C22.0073 17.1622 22.1443 15.0733 22.7763 13.1378C23.4714 10.9306 24.7079 8.95167 26.2851 7.41444C26.4169 7.29978 26.5361 7.1686 26.6451 7.02734Z" fill="#39170C"/>
            <path d="M28.2399 7.80664C28.7275 8.16031 29.2005 8.54632 29.6072 9.01213C30.2469 9.75828 30.7758 10.622 31.1709 11.5557C31.7294 12.8748 32.0336 14.3157 32.1518 15.7649C32.2904 17.3754 32.1464 18.9982 31.8956 20.5865C31.4864 22.9878 30.7278 25.3355 29.5309 27.3921C28.5979 29.0159 27.372 30.4583 25.8757 31.442C24.9663 32.0484 23.9492 32.4642 22.8957 32.6058C21.9976 32.7187 21.0817 32.6493 20.2109 32.3776C20.327 32.2428 20.4459 32.1116 20.5696 31.9858C21.4007 31.1717 22.1233 30.2214 22.734 29.1939C24.052 26.9701 24.7491 24.309 24.7426 21.6461C24.7658 20.4115 24.6083 19.184 24.6218 17.9502C24.607 16.3209 24.8045 14.6827 25.2567 13.1314C25.8345 11.1158 26.8751 9.27487 28.2399 7.80664Z" fill="#67341F"/>
            <path d="M17.7844 11.3175C18.143 10.7428 18.551 10.2084 18.9925 9.71094C19.1566 9.98086 19.2813 10.2763 19.3896 10.5786C20.1675 12.5813 20.6261 14.7324 20.7995 16.904C20.9403 18.0818 20.881 19.274 20.8794 20.4594C20.7444 22.4818 20.4308 24.5089 19.7637 26.4031C19.3857 27.6305 18.8372 28.7864 18.1901 29.8625C17.9864 30.187 17.7521 30.4861 17.543 30.8059C17.0941 30.3987 16.7051 29.9185 16.3516 29.4096C16.9084 28.6746 17.3567 27.844 17.7425 26.986C18.7837 24.5262 19.2004 21.782 19.1717 19.0745C19.1166 16.4274 18.7025 13.7681 17.7844 11.3175Z" fill="#572B18"/>
          </svg>
        </div>

        {% for step in ap_journey %}
        <div class="timeline-item">
          <div class="timeline-content">
            <h4>
              {%- if step.title_mobile and step.title_mobile != step.title %}
              <span class="timeline-desktop-copy">{{ step.title }}</span>
              <span class="timeline-mobile-copy">{{ step.title_mobile }}</span>
              {%- else %}{{ step.title }}{% endif -%}
            </h4>
            <p>
              {% if step.text_mobile and step.text_mobile != step.text %}
              <span class="timeline-desktop-copy">{{ step.text }}</span>
              <span class="timeline-mobile-copy">{{ step.text_mobile }}</span>
              {% else %}{{ step.text }}{% endif %}
            </p>
          </div>
          {% if step.image or step.asset %}
          <div class="timeline-image">
            <img src="{{ ap_img(step.image, step.asset, 800) | trim }}" alt="{{ step.title }}" loading="lazy">
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# Principles Section #}
  {% if ap_on(settings.about_page_show_principles) | trim %}
  {% set ap_principles = settings.about_page_principles if settings.about_page_principles else [
    {'title': _('Quality First'), 'text': _('We commit to precise standards in selecting and roasting coffee, to ensure a balanced and consistent experience'), 'asset': 'images/about-us/figma-bdbbc05e-1b36-4510-bef0-637a426b6c26.webp'},
    {'title': _('An Experience That Matters'), 'text': _('We design every detail with care, from product selection to the moment of enjoyment'), 'asset': 'images/about-us/figma-8ce8b929-6242-4b06-9672-81b3f0da878d.webp'},
    {'title': _('Passion for Coffee'), 'text': _('We work with genuine passion that reflects in every small detail'), 'asset': 'images/about-us/figma-6d154614-974e-4214-8bcc-f6495031cef0.webp'},
    {'title': _('A Lasting Relationship'), 'text': _('We build long-term trust with our customers and partners through quality and care'), 'asset': 'images/about-us/figma-c7d1bb43-764a-4ab3-a023-00034d7a9c25.webp'}
  ] %}
  <section class="principles-section">
    <div class="theme-container">
      <h2 class="section-title">{{ settings.about_page_principles_title or _('Our Principles in Every Cup') }}</h2>
      <div class="principles-carousel-wrapper">
        <div class="principles-carousel" data-principles-carousel>
          {% for card in ap_principles %}
          <div class="principle-card">
            {% if card.image or card.asset %}
            <img src="{{ ap_img(card.image, card.asset, 600) | trim }}" alt="{{ card.title }}" loading="lazy">
            {% endif %}
            <h5>{{ card.title }}</h5>
            <p>{{ card.text }}</p>
          </div>
          {% endfor %}
        </div>
        <div class="principles-mobile-progress" aria-hidden="true">
          <span class="principles-mobile-progress__fill" data-principles-progress></span>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  {# Why Ananas Section #}
  {% if ap_on(settings.about_page_show_why) | trim %}
  {% set ap_why = settings.about_page_why_items if settings.about_page_why_items else [
    {'text': _('Consistent quality in every cup'), 'asset': 'images/about-us/figma-601ecff7-d00f-4881-ba16-d13f751435eb.svg'},
    {'text': _('Technology that ensures the best results'), 'asset': 'images/about-us/figma-d088e391-64f0-40bb-a62f-6ccc6a75b620.svg'},
    {'text': _('Flavors to suit every taste'), 'asset': 'images/about-us/figma-91044b95-765f-446f-9f86-4e752f645f84.svg'},
    {'text': _('Seamless experience from order to delivery'), 'asset': 'images/about-us/figma-3f6cf1bd-52c1-41ce-ad9e-0459d04dca8d.svg'}
  ] %}
  {% set ap_why_half = ((ap_why | length) / 2) | round(0, 'ceil') | int %}
  {# Mobile keeps the original Figma order (3rd item first) when there are exactly 4 items #}
  {% set ap_why_mobile = [ap_why[2], ap_why[0], ap_why[1], ap_why[3]] if ap_why | length == 4 else ap_why %}
  {% set ap_cup = ap_img(settings.about_page_why_cup_image, 'images/about-us/figma-342b0340-e6f6-47cf-ae3a-e6ccab774d3b.webp', 1200) | trim %}
  {% set ap_cup_alt = settings.about_page_why_title or _('Ananas Coffee Cup') %}
