  {# Animation Script #}
  <script>
    (function() {
      // --- Scrolling Bean Animation ---
      const wrapper = document.querySelector('.timeline-wrapper');
      const bean = document.querySelector('.scrolling-bean');
      
      function updateAnimations() {
        if (wrapper && bean) {
          const wrapperRect = wrapper.getBoundingClientRect();
          const vh = window.innerHeight;
          
          // Bean Progress: 0 when top enters middle of screen, 1 when bottom leaves middle
          let progress = (vh / 2 - wrapperRect.top) / wrapperRect.height;
          progress = Math.max(0, Math.min(1, progress));
          
          bean.style.top = (progress * 100) + '%';
        }

        // Cup Fill Logic
        ['cup-center', 'cup-mobile'].forEach(id => {
          const cupContainer = document.getElementById(id);
          if (!cupContainer) return;
          const rect = cupContainer.getBoundingClientRect();
          const vh = window.innerHeight;
          
          // Fill progress: 0 when cup bottom enters view, 1 when cup top passes middle
          let fillProgress = (vh - rect.top) / (vh / 1.5);
          fillProgress = Math.max(0, Math.min(1, fillProgress));
          
          // Map 0 -> 100% inset (empty), 1 -> 0% inset (full)
          let insetPercent = (1 - fillProgress) * 100;
          
          const fillLayer = cupContainer.querySelector('.cup-fill');
          if (fillLayer) {
            fillLayer.style.setProperty('--cup-fill-percent', insetPercent + '%');
          }
        });
      }

      window.addEventListener('scroll', () => {
        requestAnimationFrame(updateAnimations);
      }, { passive: true });

      // Apply initial state
      updateAnimations();

      const principlesCarousel = document.querySelector('[data-principles-carousel]');
      const principlesProgress = document.querySelector('[data-principles-progress]');



      function updatePrinciplesProgress() {
        if (!principlesCarousel || !principlesProgress) return;
        
        const el = principlesCarousel;
        const max = el.scrollWidth - el.clientWidth;
        if (max <= 0) return;

        // Standardize scrollLeft for RTL (0 is right, max is left)
        const scrollLeft = Math.abs(el.scrollLeft);
        const ratio = Math.min(1, scrollLeft / max);
        
        // Dynamic offset calculation
        const barWidth = principlesProgress.parentElement.clientWidth;
        const fillWidth = principlesProgress.clientWidth;
        const maxOffset = barWidth - fillWidth;
        
        // Since it's RTL and right: 0, a negative translateX moves it LEFT
        principlesProgress.style.setProperty('--principles-progress-offset', (maxOffset * ratio * -1) + 'px');
      }

      if (principlesCarousel && principlesProgress) {
        principlesCarousel.addEventListener('scroll', () => {
          requestAnimationFrame(updatePrinciplesProgress);
        }, { passive: true });
        window.addEventListener('resize', updatePrinciplesProgress, { passive: true });
        // Initial call
        updatePrinciplesProgress();
      }
    })();
  </script>

  <style>
    /* CSS additions for the JS animation variables */
    /* Removed the old scaleY logic as we moved to layered clip-path */
  </style>

