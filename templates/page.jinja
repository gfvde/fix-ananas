  </style>

  {# ── About page content: every text/image comes from Theme settings → "About Us Page"
       (layout.schema.json group about_page). Empty fields fall back to the translated defaults. ── #}
  {% macro ap_on(raw) %}{% if raw is not defined or raw is none or (raw|string|lower|trim) not in ['false', '0', 'off'] %}1{% endif %}{% endmacro %}
  {% macro ap_img(value, asset, w) %}{% if value %}{{ image_url(value, w=w, f='auto') }}{% else %}{{ asset | asset_url }}{% endif %}{% endmacro %}
  {% macro ap_text(value) %}{{ (value or '') | replace('\r', '') | replace('\n', '<br>' | safe) }}{% endmacro %}

  {% set ap_intro_title = settings.about_page_intro_title or _('About Ananas') %}

  {# About Content Section #}
  {% if ap_on(settings.about_page_show_intro) | trim %}
  <section class="about-ananas-section">
    <div class="theme-container" style="max-width: 800px; text-align: center;">
      <h3 class="ananas-title" style="color: #F85A3E; font-weight: 900; font-size: 2.5rem; margin-bottom: 1.5rem;">{{ ap_intro_title }}</h3>
      <p class="ananas-subtitle" style="color: #222222; font-weight: 700; font-size: 1.4rem; line-height: 1.8; margin-bottom: 4rem;">
        <span class="ananas-subtitle__lead">{{ settings.about_page_intro_lead or _('Ananas... More Than Just Coffee') }}</span>
        <span class="ananas-subtitle__body">{{ settings.about_page_intro_body or _('We are a Saudi roastery that believes great coffee starts with a careful selection and ends with an experience worth repeating. Everything we offer is built on genuine passion and uncompromising quality.') }}</span>
      </p>
    </div>
    <div class="ananas-img-wrapper w-full">
      <img src="{{ ap_img(settings.about_page_intro_image, 'images/about-us/figma-d3380972-304b-40b5-8515-a02c0b0bb090.jpg', 1920) | trim }}" alt="{{ ap_intro_title }}" style="object-fit: cover; max-height: 50vh; width: 100%;" />
    </div>
  </section>
  {% endif %}

  {# Coffee Journey #}
  {% if ap_on(settings.about_page_show_journey) | trim %}
  {% set ap_journey = settings.about_page_journey_steps if settings.about_page_journey_steps else [
    {'title': _('From the Farm... The Beginning'), 'text': _('We carefully select our crops from the finest coffee-growing regions around the world'), 'text_mobile': _('We source from farms we trust, because the beginning is the foundation'), 'asset': 'images/about-us/figma-f0765ba7-3de1-4097-b091-f7840ab8af2e.webp'},
    {'title': _('Precise Selection'), 'text': _('Every crop passes through meticulous selection stages to ensure the highest quality'), 'text_mobile': _('Every bean goes through careful inspection, because quality has no shortcuts'), 'asset': 'images/about-us/figma-d99f4eee-c9ca-4540-b485-5a8b3cc67e96.webp'},
    {'title': _('Precise Roasting'), 'title_mobile': _('Calibrated Roasting'), 'text': _('We roast every batch to precise standards to ensure consistent flavor'), 'text_mobile': _('We roast with precision so every cup gives you the same feeling every time'), 'asset': 'images/about-us/figma-3a6dd3ed-f70e-4758-8118-73d6e2190f64.webp'},
    {'title': _('An Experience Made for You'), 'title_mobile': _('For Every Taste'), 'text': _('We offer multiple options to suit different tastes and moods'), 'text_mobile': _('We make sure to offer you a coffee that suits you'), 'asset': 'images/about-us/figma-49db7e91-046a-4eab-ae53-0a912a7e5b27.webp'}
  ] %}
  <section class="coffee-journey-section">
    <div class="theme-container">
      <h2 class="journey-title">{{ settings.about_page_journey_title or _('Coffee Journey from Source to Your Cup') }}</h2>
      <div class="timeline-wrapper">
        <div class="timeline-line"></div>
        <div class="scrolling-bean">
          <svg width="33" height="37" viewBox="0 0 33 37" fill="none" xmlns="http://www.w3.org/2000/svg">
