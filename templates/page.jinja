            <path d="M7.41008 4.52191C7.80131 4.3918 8.19802 4.26133 8.60762 4.23438C7.18191 7.0975 6.62923 10.5034 7.13551 13.7349C7.3366 14.9871 7.68529 16.2052 8.14903 17.3668C8.57797 18.4979 9.08908 19.5866 9.52769 20.713C10.0146 22.0062 10.392 23.3562 10.576 24.746C10.9511 27.3993 10.5992 30.1592 9.64306 32.6187C8.39299 32.452 7.189 31.9344 6.14841 31.148C4.4085 29.8329 3.13039 27.868 2.29443 25.7388C1.2548 23.0413 0.767861 20.0905 0.793964 17.1594C0.789775 15.6581 0.956708 14.1565 1.2851 12.7016C1.68084 11.0335 2.32118 9.4269 3.23384 8.02984C4.27927 6.44228 5.71818 5.13508 7.41008 4.52191Z" fill="#884C2E"/>
