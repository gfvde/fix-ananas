{% extends "layout.jinja" %}

{% block title %}{{ page.title }} – {{ store.name }}{% endblock %}

{% block content %}
  {% set about_page_enabled = settings.about_page_enabled is not defined or settings.about_page_enabled is none or (settings.about_page_enabled|string|lower|trim) not in ['false', '0', 'off'] %}
  {% if page.slug == 'about-us' and about_page_enabled %}
  <style>
    /* ── Reviews Section ─────────────────────────────── */
    .reviews-section {
      background: #ffffff;
      padding: 40px 56px 24px;
    }
    .reviews-section__title {
      font-size: 30px;
      font-weight: 500;
      color: #000000;
      line-height: 36px;
      text-align: center;
      margin-bottom: 24px;
    }
    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      align-items: stretch;
    }
    .reviews-col {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    /* ── Base card ── */
    .review-card {
      flex: 1;
      border-radius: 4px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 40px;
    }
    .review-card--dark  { background: #171717; }
    .review-card--light { background: #EEEEEE; }
    .review-card--light2 { background: #EEEEEE; gap: 56px; }
    /* ── Stars ── */
    .review-stars { display: flex; align-items: center; gap: 4px; }
    /* ── Review text ── */
    .review-body { display: flex; flex-direction: column; gap: 8px; }
    .review-text {
      font-size: 16px;
      font-weight: 500;
      line-height: 24px;
    }
    .review-text--white { color: #ffffff; }
    .review-text--black { color: #000000; }
    /* ── Author ── */
    .review-author {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .review-author__avatar {
      width: 46px;
      height: 46px;
      border-radius: 4px;
      object-fit: cover;
      flex-shrink: 0;
    }
    .review-author__info { display: flex; flex-direction: column; gap: 0; }
    .review-author__name {
      font-size: 16px;
      font-weight: 500;
      line-height: 24px;
    }
    .review-author__name--white { color: #ffffff; }
    .review-author__name--black { color: #000000; }
    /* ── Verified badge ── */
    .verified-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 14px;
      font-weight: 500;
      color: #25A562;
      line-height: 20px;
    }
    .verified-badge--sm {
      font-size: 12px;
      line-height: 16px;
    }
    /* ── Image card ── */
    .review-card--image {
      position: relative;
      overflow: hidden;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }
    .review-card--image .review-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }
    .review-card--image::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top,
        rgba(0,0,0,1.00) 0%,
        rgba(0,0,0,0.42) 76%,
        rgba(102,102,102,0) 100%);
      z-index: 1;
    }
    .review-card--image .review-card__content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    /* ── Mobile overrides ── */
    @media (max-width: 767px) {
      .reviews-section {
        padding: 24px 16px;
      }
      .reviews-section__title {
        font-size: 24px;
        line-height: 32px;
        margin-bottom: 16px;
      }
      .reviews-grid {
        grid-template-columns: 1fr;
        gap: 10px;
      }
      .reviews-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }
      .review-card {
        padding: 12px;
        gap: 24px;
      }
      .review-card--light2 { gap: 24px; }
      .review-text {
        font-size: 14px;
        font-weight: 400;
        line-height: 20px;
      }
      .review-author__avatar {
        width: 32px;
        height: 32px;
      }
      .review-author__name {
        font-size: 12px;
        line-height: 16px;
      }
      .verified-badge {
        font-size: 12px;
        line-height: 16px;
      }
      .review-card--image {
        aspect-ratio: 1 / 1;
      }
      .review-card--image .review-card__content {
        gap: 24px;
      }
    }

    .about-ananas-section {
      padding-top: 5rem;
      padding-bottom: 3rem;
      background-color: #ffffff;
    }

    /* Journey Section */
    .coffee-journey-section {
      background-color: #FFF0EC;
      padding: 6rem 0;
      overflow: clip;
    }
    .journey-title {
      color: #F7512B;
      font-weight: 700;
      font-size: 30px;
      margin-bottom: 4rem;
      text-align: center;
    }
    .timeline-wrapper {
      position: relative;
      max-width: 493px;
      margin: 0 auto;
      padding: 0;
      direction: ltr;
    }
    .timeline-line {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 0;
      border-left: 2px dashed #895B2E;
      transform: translateX(-50%);
      z-index: 1;
      pointer-events: none;
    }
    .scrolling-bean {
      position: absolute;
      left: 50%;
      top: 0;
      transform: translate(-50%, -50%);
      width: 40px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 3;
    }
    .scrolling-bean svg {
      width: 33px;
      height: 37px;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));
    }
    .timeline-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2.5rem;
      position: relative;
      z-index: 2;
      flex-direction: row-reverse;
    }
    .timeline-item:nth-child(even) { flex-direction: row; }
    .timeline-item:last-child { margin-bottom: 0; }
    .timeline-content {
      width: 195px;
    }
    html[dir="rtl"] .timeline-content { text-align: right; }
    html[dir="ltr"] .timeline-content { text-align: left; }
    .timeline-image {
      width: 195px;
      display: flex;
    }
    .timeline-item:nth-child(even) .timeline-image { justify-content: flex-end; }
    .timeline-image img {
      width: 190px;
      height: 154px;
      object-fit: cover;
      border-radius: 0;
    }
    .timeline-content h4 {
      color: #000;
      font-weight: 700;
      font-size: 18px;
      margin-bottom: 0;
      line-height: 28px;
    }
    .timeline-content p {
      color: #000;
      font-weight: 500;
      font-size: 18px;
      line-height: 28px;
      margin: 0;
    }

    /* Principles Section */
    .principles-section {
      padding: 6rem 0;
      background-color: #FFFFFF;
    }
    .section-title {
      color: #F7512B;
      font-weight: 700;
      font-size: 30px;
      margin-bottom: 3rem;
      text-align: center;
    }
    .principles-carousel-wrapper {
      margin: 0 auto;
      max-width: 1328px;
      padding: 0 15px;
    }
    .principles-carousel {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 24px;
      scrollbar-width: thin;
      scrollbar-color: #F7512B #FAF2EC;
    }
    .principle-card {
      flex: 0 0 320px;
      scroll-snap-align: start;
      display: flex;
      flex-direction: column;
    }
    html[dir="rtl"] .principle-card { text-align: right; }
    html[dir="ltr"] .principle-card { text-align: left; }
    .principle-card img {
      width: 320px;
      height: 320px;
      object-fit: cover;
      margin-bottom: 16px;
      background-color: #FAF2EC;
    }
    .principle-card h5 {
      color: #363636;
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 12px;
    }
    .principle-card p {
      color: #363636;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.5;
      margin: 0;
    }

    /* Why Ananas Section */
    .why-ananas-section {
      padding: 5rem 0;
      background-color: #FFFFFF;
    }
    .why-ananas-desktop {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 80px;
      max-width: 900px;
      margin: 0 auto;
      padding: 0 15px;
    }
    .why-side-col {
      display: flex;
      flex-direction: column;
      gap: 68px;
      align-items: center;
      width: 194px;
    }
    .why-icon-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      text-align: center;
      width: 100%;
    }
    .why-icon-item img { width: 100px; height: 100px; object-fit: contain; }
    .why-icon-item p {
      color: #404040;
      font-size: 16px;
      font-weight: 700;
      line-height: 24px;
      margin: 0;
    }
    .why-cup-center {
      width: 251px;
      height: 426px;
      flex-shrink: 0;
      overflow: hidden;
      position: relative;
    }
    .why-cup-center img, .why-cup-mobile img {
      position: absolute;
      width: 198%;
      height: 117%;
      top: -8.76%;
      object-fit: cover;
    }
    /* Empty glass layer - desaturated and lightened */
    .cup-bg {
      z-index: 1;
      filter: grayscale(1) brightness(1.7) opacity(0.5);
    }
    /* Liquid fill layer - full color, revealed via clip-path */
    .cup-fill {
      z-index: 2;
      clip-path: inset(var(--cup-fill-percent, 100%) 0 0 0);
      transition: none !important;
    }
    .why-ananas-mobile { display: none; }
    .why-ananas-mobile-text {
      text-align: center;
      color: #363636;
      font-size: 16px;
      line-height: 24px;
      font-weight: 400;
    }
    .why-ananas-mobile-text p { margin-bottom: 0; }
    .why-cup-mobile {
      width: 250px;
      height: 363px;
      overflow: hidden;
      position: relative;
      margin: 0 auto;
    }
    .why-cup-mobile img {
      position: absolute;
      width: 198%;
      height: 136%;
      top: -14.36%;

      object-fit: cover;
    }

    /* Partners Section */
    .partners-section {
      padding: 40px 0;
      background: #fff;
    }
    .partners-inner {
      display: flex;
      flex-direction: row;
      gap: 12px;
      max-width: 1328px;
      margin: 0 auto;
      padding: 0 15px;
    }
    .partner-card-new {
      flex: 1;
      background-color: rgba(211, 219, 111, 0.15);
      display: flex;
      align-items: center;
      gap: 16px;
      min-height: 260px;
    }
    html[dir="rtl"] .partner-card-new { flex-direction: row-reverse; }
    html[dir="ltr"] .partner-card-new { flex-direction: row; }
    .partner-card-new .card-img {
      flex: 1;
      min-width: 0;
      height: 100%;
      min-height: 260px;
      position: relative;
      overflow: hidden;
    }
    .partner-card-new .card-img img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .partner-card-new .card-text {
      flex: 1;
      min-width: 0;
      padding: 16px;
    }
    html[dir="rtl"] .partner-card-new .card-text { text-align: right; }
    html[dir="ltr"] .partner-card-new .card-text { text-align: left; }
    .partner-card-new .card-text h4 {
      color: #F7512B;
      font-weight: 700;
      font-size: 24px;
      line-height: 32px;
      margin-bottom: 12px;
      white-space: nowrap;
    }
    .partner-card-new .card-text p {
      color: #363636;
      font-size: 18px;
      font-weight: 700;
      line-height: 28px;
      margin: 0;
    }

    /* Grow Together */
    .grow-together-section {
      padding: 5rem 15px;
      text-align: center;
    }
    .grow-together-section h2 {
      color: #F7512B;
      font-weight: 700;
      font-size: 36px;
      margin-bottom: 1.5rem;
    }
    .grow-together-section p {
      color: #000;
      font-size: 20px;
      font-weight: 500;
      max-width: 620px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Mobile */
    @media (max-width: 768px) {
      .why-ananas-desktop { display: none; }
      .why-ananas-mobile { display: flex; flex-direction: column; align-items: center; gap: 24px; padding: 0 16px; }
      .principles-carousel { gap: 12px; }
      .principle-card { flex: 0 0 280px; }
      .principle-card img { width: 280px; height: 280px; }
      .partners-inner { flex-direction: column; }
      .partner-card-new,
      html[dir="rtl"] .partner-card-new,
      html[dir="ltr"] .partner-card-new { flex-direction: column; }
      .partner-card-new .card-img { width: 100%; min-height: 280px; height: 280px; flex: none; }
      .partner-card-new .card-text,
      html[dir="rtl"] .partner-card-new .card-text,
      html[dir="ltr"] .partner-card-new .card-text { text-align: center; }
      .partner-card-new .card-text p { font-size: 15px; line-height: 24px; font-weight: 400; }
      .grow-together-section h2 { font-size: 24px; }
      .grow-together-section p { font-size: 18px;margin-bottom: 20px;}
    }

    /* ── UGC Video Section ── */
    .ugc-section {
      background: #ffffff;
      padding: 24px 56px 48px;
    }
    .ugc-section__header {
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: center;
      text-align: center;
      margin-bottom: 16px;
    }
    html[dir="rtl"] .ugc-section__header { align-items: flex-end; text-align: right; }
    .ugc-section__title {
      font-size: 30px;
      font-weight: 500;
      line-height: 36px;
      color: #000;
    }
    .ugc-section__subtitle {
      font-size: 16px;
      font-weight: 400;
      line-height: 24px;
      color: #000;
    }
    .ugc-videos {
      display: flex;
      gap: 16px;
    }
    .ugc-video {
      flex: 1;
      aspect-ratio: 309 / 522;
      overflow: hidden;
      border-radius: 8px;
      position: relative;
      min-width: 0;
    }
    .ugc-video img.video-thumb {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 8px;
    }
    .ugc-play-btn {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 40px;
      height: 40px;
      background: rgba(65, 65, 65, 0.4);
      backdrop-filter: blur(2px);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }

    /* ── Photo Gallery Section ── */
    .gallery-section {
      background: #ffffff;
      padding: 40px 56px;
    }
    .gallery-section__header {
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: center;
      text-align: center;
      margin-bottom: 16px;
    }
    .gallery-section__title {
      font-size: 30px;
      font-weight: 500;
      line-height: 36px;
      color: #000;
    }
    .gallery-section__subtitle {
      font-size: 16px;
      font-weight: 400;
      line-height: 24px;
      color: #000;
    }
    .gallery-grid {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .gallery-row {
      display: flex;
      gap: 10px;
      height: 257px;
    }
    .gallery-item {
      flex: 1;
      overflow: hidden;
      position: relative;
      min-width: 0;
    }
    .gallery-item img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .gallery-desktop { display: block; }
    .gallery-mobile  { display: none; }

    /* ── Pagination indicator ── */
    .section-pagination {
      display: flex;
      justify-content: center;
      margin-top: 16px;
    }
    .pagination-track {
      width: 180px;
      height: 2px;
      background: #e5e5e5;
      overflow: hidden;
      position: relative;
    }
    .pagination-fill {
      position: absolute;
      right: -1px;
      top: 0;
      width: 78px;
      height: 2px;
      background: #737373;
    }

    /* ── Mobile UGC / Gallery overrides ── */
    @media (max-width: 767px) {
      /* reviews title */
      .reviews-section__title { text-align: right; }

      /* ugc */
      .ugc-section { padding: 16px 16px 24px; }
      .ugc-section__header { align-items: center; text-align: center; }
      .ugc-section__title { font-size: 24px; line-height: 32px; text-align: center; }
      .ugc-section__subtitle { text-align: center; max-width: 277px; }
      .ugc-videos {
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      .ugc-videos::-webkit-scrollbar { display: none; }
      .ugc-video {
        flex: 0 0 193px;
        height: 326px;
        aspect-ratio: unset;
        scroll-snap-align: start;
      }

      /* gallery */
      .gallery-section { padding: 16px 16px 24px; }
      .gallery-section__title { font-size: 24px; line-height: 32px; }
      .gallery-row { gap: 8px; height: 175px; }
      .gallery-grid { gap: 8px; }
      .gallery-desktop { display: none; }
      .gallery-mobile  { display: block; }

      /* gallery mobile nav row */
      .gallery-mobile-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        margin-bottom: 8px;
      }
      .gallery-nav-btn {
        width: 24px;
        height: 24px;
        background: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
      }
    }
    @media (min-width: 768px) {
      .reviews-section__title { text-align: right; }
    }

    /* About us page spacing aligned with Figma frame 364:25751 / 364:20762 */
    .about-ananas-section {
      padding: 32px 56px 0;
      background: #FCFAF7;
    }
    .about-ananas-section > .theme-container {
      width: 100%;
      max-width: none !important;
      margin: 0 0 24px !important;
      padding: 0 !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      text-align: center;
    }
    .about-ananas-section .ananas-title {
      margin: 0 !important;
      color: #F7512B !important;
      font-size: 30px !important;
      line-height: 36px !important;
      font-weight: 700 !important;
    }
    .about-ananas-section .ananas-subtitle {
      margin: 0 !important;
      color: #000 !important;
      font-size: 20px !important;
      line-height: 32px !important;
      font-weight: 500 !important;
    }
    .about-ananas-section .ananas-subtitle__lead,
    .about-ananas-section .ananas-subtitle__body {
      display: block;
    }
    .about-mobile-break {
      display: none;
    }
    .about-ananas-section .ananas-img-wrapper img {
      width: 100% !important;
      height: 391px !important;
      max-height: none !important;
      object-fit: cover !important;
      display: block;
    }

    .coffee-journey-section {
      padding: 40px 56px;
      background: #FFF0EC;
    }
    .coffee-journey-section > .theme-container {
      width: 100%;
      max-width: none;
      padding: 0;
    }
    .journey-title {
      margin: 0 0 24px;
      font-size: 30px;
      line-height: 36px;
      font-weight: 700;
    }
    .timeline-wrapper {
      width: 493px;
      max-width: 100%;
    }
    .timeline-item {
      min-height: 170px;
      margin-bottom: 32px;
    }
    .timeline-content {
      width: 190px;
    }
    .timeline-image {
      width: 190px;
    }
    .timeline-image img {
      width: 190px;
      height: 170px;
    }
    .timeline-content h4,
    .timeline-content p {
      font-size: 18px;
      line-height: 28px;
    }
    .timeline-content h4 {
      font-weight: 400;
    }
    .timeline-content p {
      font-weight: 400;
    }
    .timeline-mobile-copy {
      display: none;
    }

    .principles-section {
      padding: 40px 56px;
      background: #FCFAF7;
    }
    .principles-section > .theme-container {
      width: 100%;
      max-width: none;
      padding: 0;
    }
    .section-title {
      margin: 0 0 24px;
      color: #F7512B;
      font-size: 30px;
      line-height: 36px;
      font-weight: 700;
      text-align: center;
    }
    .principles-carousel-wrapper {
      max-width: none;
      padding: 0;
    }
    .principles-carousel {
      gap: 16px;
      padding-bottom: 0;
      overflow: visible;
      scrollbar-width: none;
    }
    .principles-carousel::-webkit-scrollbar {
      display: none;
    }
    .principle-card {
      flex: 1 1 0;
      min-width: 0;
      align-items: center;
      text-align: center;
      gap: 12px;
    }
    .principle-card img {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
      margin-bottom: 0;
    }
    .principle-card h5 {
      margin: 0;
      font-size: 20px;
      line-height: 28px;
      color: #000;
      text-align: center;
    }
    .principle-card p {
      font-size: 16px;
      line-height: 24px;
      color: #404040;
      text-align: center;
    }
    .principles-mobile-progress {
      display: none;
    }

    .why-ananas-section {
      padding: 32px 0 48px;
      background: #FCFAF7;
    }
    .why-ananas-section > .theme-container {
      padding: 0;
    }
    .why-ananas-desktop {
      height: 427px;
      max-width: none;
      gap: 80px;
      padding: 0;
    }
    .why-side-col {
