      .partner-card-new .card-text h4 {
        margin-bottom: 12px;
        font-size: 24px;
        line-height: 32px;
        font-weight: 500;
        text-align: center;
      }
      .partner-card-new .card-text p {
        font-size: 16px;
        line-height: 24px;
        font-weight: 400;
        text-align: center;
