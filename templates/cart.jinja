{% extends "layout.jinja" %}

{% block title %}{{ store.name }} – {{ _('Cart') }}{% endblock %}

{% block content %}
  <link rel="stylesheet" type="text/css" href="{{ 'css/cart-page.css' | asset_url }}" />
  <link rel="stylesheet" type="text/css" href="{{ 'css/dara/cart-page.css' | asset_url }}" />
  {% set cart_cta_bg = safeget(settings, 'cart_page_checkout_button_color', '#6B4A39') or '#6B4A39' %}
  {% set cart_cta_text = safeget(settings, 'cart_page_checkout_button_text_color', '#FFFFFF') or '#FFFFFF' %}
  {% set cart_show_breadcrumb = safeget(settings, 'cart_page_show_breadcrumb', false) %}
  {% if cart_show_breadcrumb and (cart_show_breadcrumb | string | lower) not in ['false', '0', 'off'] %}
  <section class="pc-breadcrumb-section cart-page-bg cart-page-breadcrumb-section">
    <div class="theme-container">
      {%
        with
        items=[
          {'href': url_for('home'), 'label': _("Home")},
          {'label': _("Cart")}
        ]
      %}
        {% include 'components/ui/breadcrumb.jinja' %}
      {% endwith %}
    </div>
  </section>
  {% endif %}

  <section class="cart-page-bg cart-page-main-section">
    <div class="theme-container">
      {% set gift_order_enabled = safeget(store, 'settings.checkout.gift_order_settings.is_gift_order_enabled', false) == '1' %}
      {% if cart.products_count > 0 %}
        <div
          class="cart-with-products"
          style="--cart-cta-bg: {{ cart_cta_bg }}; --cart-cta-text: {{ cart_cta_text }};"
        >
          <div class="cart-page-header">
            <h1 class="cart-page-header__title">{{ _('Shopping cart') }}</h1>
            <p class="cart-page-header__count">( {{ _('%(count)s products') | format(count=(cart.products_count | default(0))) }} )</p>
          </div>

          {# MOBILE: header + summary shown above products #}
          <div class="cart-mobile-top cart-mobile-only">
            {% include 'components/cart/mobile-header.jinja' %}
            {% include 'components/cart/cart-summary.jinja' %}
          </div>

          {# DESKTOP sidebar + MOBILE products — flex layout on desktop #}
          <div class="cart-page-layout">
            <div class="cart-page-layout__sidebar">
              {% include 'components/cart/cart-sidebar.jinja' %}
            </div>

            <div class="cart-page-layout__products">
              {% include 'vitrin:cart/progressive_discount.jinja' %}

              <div data-cart-products-list>
                {% include 'components/cart/products-list.jinja' %}
                {% if gift_order_enabled and not safeget(cart, 'gift_card_details.card_product_id') and not safeget(cart, 'gift_card_details.card_design') %}
                  <div class="mt-4">{% include 'components/cart/gift-card-display.jinja' %}</div>
                {% endif %}
              </div>

              <a
                href="{{ url_for('home') }}"
                class="cart-continue-shopping text-foreground mt-6 inline-flex items-center gap-2 rounded py-2.5 text-sm transition-opacity hover:opacity-70"
              >
                <svg
                  class="size-4 rtl:rotate-180"
                  viewBox="0 0 16 16"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M10 12L6 8L10 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
                {{ _("Continue shopping") }}
              </a>
            </div>
          </div>

          {# Gift dialog: included once per page (cart-summary renders twice: mobile + desktop) #}
          {% if gift_order_enabled %}
            {% include 'vitrin:cart/gift-card.jinja' %}
          {% endif %}

          {# MOBILE benefits (loyalty + UVPs + payments) below products #}
          <div class="cart-mobile-only">
            {% include 'components/cart/cart-mobile-benefits.jinja' %}
          </div>

          {# MOBILE FIXED CHECKOUT BUTTON #}
          {% set store_closed = safeget(store, 'settings.general.availability.closed_now') %}
          {% set mobile_checkout_inner %}
            <span class="cart-mobile-checkout-btn__prices">
              <span class="cart-mobile-checkout-btn__compare" data-cart-mobile-compare></span>
              <span class="cart-mobile-checkout-btn__total" data-cart-mobile-total>
                {%- for t in cart.totals if t.code == 'total' -%}{{ t.value_string }}{%- endfor -%}
              </span>
            </span>
            <span class="cart-mobile-checkout-btn__label">{{ _('Store is closed') if store_closed else _('Complete your order') }}</span>
          {% endset %}
          <div class="cart-mobile-checkout-bar cart-mobile-only">
            {% if store_closed %}
              <button
                type="button"
                class="cart-mobile-checkout-btn"
                disabled
                data-cart-mobile-checkout
              >{{ mobile_checkout_inner }}</button>
            {% else %}
              <a
                href="/checkout"
                class="cart-mobile-checkout-btn"
                data-cart-mobile-checkout
              >{{ mobile_checkout_inner }}</a>
            {% endif %}
          </div>
        </div>
      {% else %}
        {% include 'components/cart/empty-state.jinja' %}
      {% endif %}
    </div>
  </section>
{% endblock %}

{% block footer_scripts %}
  {# Cart Controller - Modular cart page functionality #}
  <script
    src="{{ 'dist/cart-controller.js' | asset_url }}"
    defer
  ></script>
  <!-- prettier-ignore-start -->
  <script>
    // Initialize CartPage module after DOM is ready
    document.addEventListener("DOMContentLoaded", function () {
    // This must happen BEFORE any cart operations to prevent default HTML replacement
    (function registerHandler() {
      if (window.ZidCart && window.ZidCart.registerCustomHandler) {
        window.ZidCart.registerCustomHandler();
      } else {
        // If ZidCart isn't ready yet, try again on next tick
        setTimeout(registerHandler, 10);
      }
    })();
      CartPage.init({
        cart: {{ cart | tojson }},
        loyaltyEnabled: {{ (store.settings.checkout.is_loyalty_enabled | default(false)) | tojson }},
        cartTotalValue: {{ cart.total_value | default(0) }},
        storeCurrencyCode: "{{ session.currency.code }}",
        cartCurrencyCode: "{{ cart.currency.cart_currency.code if cart.currency else session.currency.code }}",
        translations: {
          forPointsGetDiscount: "{{ _('For %(points)s points get %(discount)s discount') }}",
          itemsCount: "{{ _('%(count)s items') }}",
          freeShippingApplied: "{{ _('Congrats! Your order qualifies for free shipping') }}",
          addMoreForFreeShipping: "{{ _('Add %(total)s more to get free shipping') }}",
          discount: "{{ _('Discount') }}",
          loyalty: "{{ _('Loyalty') }}",
          options: "{{ _('Options') }}",
          discountTemplate: "{{ _('Special offer') }}"
        }
      });
    });
  </script>
  <!-- prettier-ignore-end -->
{% endblock %}
