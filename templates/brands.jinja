{% extends "layout.jinja" %}

{% block title %}{{ store.name }} – {{ _('All Brands') }}{% endblock %}

{% block content %}
  {% set brand_src = brands if brands is defined and brands else none %}
  {% set brand_list = brand_src.results if brand_src and brand_src.results else [] %}
  {% set brand_count = brand_src.count if brand_src and brand_src.count is not none else brand_list | length %}
  {% set brands_page_size = ((session.query_params.get('page_size') if session and session.query_params else none) or 24) | int %}
  {% set brands_page_size = brands_page_size if brands_page_size > 0 else 24 %}

  {# Breadcrumb #}
  <section class="pc-breadcrumb-section px-4 py-6 md:px-16">
    <div class="theme-container">
      {%
        with
        items=[
          {'href': url_for('home'), 'label': _("Home")},
          {'label': _("All Brands")}
        ]
      %}
        {% include 'components/ui/breadcrumb.jinja' %}
      {% endwith %}
    </div>
  </section>

  {# Brands Grid #}
  <section class="px-4 pb-16 md:px-16">
    <div class="theme-container">
      <div id="products-content" class="flex flex-col gap-6 transition-opacity duration-200">
        <h1 class="text-foreground text-xl md:text-2xl font-semibold tracking-tight">
          {{ _("Brands") }}
          {% if brand_count %}<span class="text-muted text-base font-normal">({{ brand_count }})</span>{% endif %}
        </h1>

        {% if brand_list | length > 0 %}
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
            {% for brand in brand_list %}
              {% with brand=brand, index=loop.index0 %}
                {% include 'components/brands/brand-card.jinja' %}
              {% endwith %}
            {% endfor %}
          </div>

          {% set totalPages = ((brand_count / brands_page_size) | round(0, 'ceil')) | int %}
          {% set currentPage = (brand_src.page | default(1, true)) | int %}
          {% if totalPages > 1 %}
            {% include 'components/products/pagination.jinja' %}
          {% endif %}
        {% else %}
          <div class="bg-secondary flex flex-col items-center justify-center rounded-lg py-16">
            <p class="text-muted text-sm">{{ _("No brands found") }}</p>
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endblock %}
