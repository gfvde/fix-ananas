{% extends "layout.jinja" %}

{% block title %}{{ _("Wishlist") }} – {{ store.name }}{% endblock %}

{% block content %}
  <section class="wishlist-page">
    <div class="theme-container wishlist-page__inner">
      {% set wishlist_style_seed_product = {
        'id': '__wishlist_style_seed__',
        'slug': '__wishlist-style-seed__',
        'name': 'Wishlist style seed',
        'in_stock': true,
        'is_infinite': true,
        'quantity': 1,
        'has_options': false,
        'has_fields': false,
        'main_image': none,
        'images': [],
        'tags': [],
        'rating': none,
        'formatted_sale_price': none,
        'formatted_price': '',
        'discount_percentage': 0,
        'badge': none,
        'is_taxable': true
      } %}
      <div class="wishlist-page__card-style-seed" hidden inert aria-hidden="true">
        {% with product=wishlist_style_seed_product, wishlist_card_mode=true, show_static_cta=true, product_card_variant='pc-card--figma-products' %}
          {% include 'components/products/product-card.jinja' %}
        {% endwith %}
      </div>

      <h1 class="wishlist-page__title">
        <span>{{ _("Wishlist") }}</span>
        <small data-wishlist-count>( 0 {{ _("Products") }} )</small>
      </h1>

      <div data-wishlist-page-items>
        <div class="wishlist-page__notice">
          {{ _("Loading wishlist...") }}
        </div>
      </div>
    </div>
  </section>
{% endblock %}
