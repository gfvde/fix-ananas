<script>
document.addEventListener('DOMContentLoaded', () => {

    const shareToggle = document.querySelectorAll('.share-dropdown-toggle');
    const shareMenu = document.querySelectorAll('#share-dropdown-menu');
    const shareToast = document.querySelectorAll('#share-toast');

    const closeShareMenu = () => {

        shareMenu.forEach(menu => {
            menu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
            menu.classList.remove('opacity-100', 'scale-100');
            menu.setAttribute('aria-hidden', 'true');
        });

        shareToggle.forEach(toggle => {
            toggle.setAttribute('aria-expanded', 'false');
        });
    };

    const openShareMenu = () => {

        shareMenu.forEach(menu => {
            menu.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
            menu.classList.add('opacity-100', 'scale-100');
            menu.setAttribute('aria-hidden', 'false');
        });

        shareToggle.forEach(toggle => {
            toggle.setAttribute('aria-expanded', 'true');
        });
    };

    const toggleShareMenu = () => {

        const isOpen = [...shareToggle].some(
            toggle => toggle.getAttribute('aria-expanded') === 'true'
        );

        isOpen ? closeShareMenu() : openShareMenu();
    };

    const showShareToast = () => {

        shareToast.forEach(toast => {
            toast.classList.remove('hidden');
            toast.classList.add('opacity-100');
        });

        setTimeout(() => {
            shareToast.forEach(toast => {
                toast.classList.add('hidden');
                toast.classList.remove('opacity-100');
            });
        }, 1600);
    };

    shareToggle.forEach(toggle => {

        toggle.addEventListener('click', event => {
            event.stopPropagation();
            toggleShareMenu();
        });
    });

    shareMenu.forEach(menu => {

        menu.addEventListener('click', event => {
            event.stopPropagation();
        });

        menu.querySelectorAll('a[data-share-action="link"]').forEach(link => {
            link.addEventListener('click', closeShareMenu);
        });

        menu.querySelectorAll('button[data-share-action="copy"]').forEach(button => {

            button.addEventListener('click', async event => {

                event.preventDefault();
                event.stopPropagation();

                const toggle =
                    button.closest('[data-share-wrapper]')
                    ?.querySelector('.share-dropdown-toggle');

                const shareUrl =
                    toggle?.dataset.shareUrl || window.location.href;

                try {

                    await navigator.clipboard.writeText(shareUrl);

                    showShareToast();

                } catch (error) {

                    console.error('Copy failed', error);
                }

                closeShareMenu();
            });
        });
    });

    document.addEventListener('click', closeShareMenu);

    window.product = {{ product | tojson | safe }};

});
</script>
<script>
(function () {

  const normalize = (str) => str.toLowerCase().trim();

  const colorMap = {
    red: "#ef4444",
    green: "#22c55e",
    blue: "#3b82f6",
    black: "#111827",
    white: "#ffffff",
    yellow: "#eab308",
    orange: "#f97316",
    purple: "#a855f7",
    pink: "#ec4899",
    gray: "#6b7280",
    grey: "#6b7280",
    beige: "#D8C3A5",
    brown: "#6B4A39",
    navy: "#1F2A44",
    "أحمر": "#ef4444",
    "أخضر": "#22c55e",
    "أزرق": "#3b82f6",
    "أسود": "#111111",
    "اسود": "#111111",
    "أبيض": "#ffffff",
    "ابيض": "#ffffff",
    "أصفر": "#eab308",
    "برتقالي": "#f97316",
    "بنفسجي": "#a855f7",
    "وردي": "#ec4899",
    "رمادي": "#737373",
    "بيج": "#D8C3A5",
    "رملي": "#C8AE7D",
    "بني": "#6B4A39",
    "كحلي": "#1F2A44",
    "عنابي": "#7B1E2B",
    "زيتي": "#5B5E3A",
    "سكري": "#F3EAD7",
  };

  document.querySelectorAll('.product-options__item').forEach(el => {
    let value =
      el.getAttribute('value') ||
      el.querySelector('.product-options__item-text')?.textContent ||
      '';

    value = normalize(value);

    let color = null;

    if (/^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(value)) {
      color = value;
    }

    else if (value.startsWith('rgb')) {
      color = value;
    }

    else if (colorMap[value]) {
      color = colorMap[value];
    }
    if (color) {
      el.style.backgroundColor = color;

      // نص أبيض لو اللون غامق
      el.style.color = getContrastColor(color);

      el.classList.add('colorized');
    }
  });

  function getContrastColor(hex) {
    if (!hex.startsWith('#')) return '#fff';

    const c = hex.substring(1);
    const rgb = parseInt(c.length === 3
      ? c.split('').map(x => x + x).join('')
      : c, 16);

    const r = (rgb >> 16) & 255;
    const g = (rgb >> 8) & 255;
    const b = rgb & 255;

    const brightness = (r * 299 + g * 587 + b * 114) / 1000;

    return brightness > 150 ? '#000' : '#fff';
  }

})();
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  'use strict';

  /* ─────────────────────────────────────────────────
     Shared Iframe Modal
     Trigger: any [.open-iframe-modal] button
     URL / title come from [data-iframe-url] & [data-iframe-title]
  ───────────────────────────────────────────────── */
  var modal       = document.getElementById('coffeeIframeModal');
  var overlay     = document.getElementById('coffeeModalOverlay');
  var closeBtn    = document.getElementById('coffeeModalClose');
  var iframe      = document.getElementById('coffeeIframe');
  var iframeTitle = document.getElementById('coffeeIframeTitle');

  function openModal(url, title) {
    if (!modal || !iframe) return;
    iframe.src          = url || '';
    iframe.title        = title || '';
    if (iframeTitle) iframeTitle.textContent = title || '';
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal || !iframe) return;
    modal.classList.add('hidden');
    iframe.src = '';          // free resources
    iframe.title = '';
    document.body.style.overflow = '';
  }

  // Delegate clicks on ALL .open-iframe-modal buttons (current + future)
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.open-iframe-modal');
    if (!btn) return;
    var url   = btn.getAttribute('data-iframe-url');
    var title = btn.getAttribute('data-iframe-title') || '';
    if (!url) return;           // guard: no URL → do nothing
    openModal(url, title);
  });

  if (closeBtn)  closeBtn.addEventListener('click', closeModal);
  if (overlay)   overlay.addEventListener('click', closeModal);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
});
</script>
