{% if settings.single_product_section_bundle_products_with_selection and settings.single_product_section_bundle_products_with_selection|length > 0 %}

  {% set ns = namespace(current_bundle=none) %}

  {% for bundle in settings.single_product_section_bundle_products_with_selection %}
    {% if bundle.main_product and bundle.main_product.id|string == product.id|string %}
      {% set ns.current_bundle = bundle %}
    {% endif %}
  {% endfor %}

  {% if ns.current_bundle and ns.current_bundle.bundle_items|length > 0 %}
  <section class="bundle-section mt-6 mb-6">
    <div class="">

      <h2 class="text-base font-medium text-right mb-4">
        {{ ns.current_bundle.section_title | default('عادة ما يتم شراؤها معا') }}
      </h2>

      <div id="bundle-skeleton" class="flex flex-wrap gap-3 justify-end">
        {% for item in ns.current_bundle.bundle_items %}
        <div class="flex items-center gap-3">
          <div class="w-[130px] flex flex-col items-center gap-2">
            <div class="w-[110px] h-[110px] bg-gray-100 rounded-lg animate-pulse"></div>
            <div class="w-20 h-3 bg-gray-100 rounded animate-pulse"></div>
            <div class="w-14 h-3 bg-gray-100 rounded animate-pulse"></div>
          </div>
          {% if not loop.last %}<span class="text-gray-300 text-xl self-center mt-[-20px]">+</span>{% endif %}
        </div>
        {% endfor %}
      </div>

      <div id="bundle-content" class="hidden">
        <div id="bundle-products-row" class="flex flex-wrap items-start gap-1"></div>
        <div class="mt-4 flex md:justify-start justify-center">
          <button id="bundle-add-btn"
                  type="button"
                  class="px-6 py-3  text-sm font-medium border-2 transition-all duration-200 flex items-center gap-2"
                  style="border-color: {{ ns.current_bundle.bundle_btn_color | default('#e63b3b') }}; color: {{ ns.current_bundle.bundle_btn_color | default('#e63b3b') }};">
            <span>{{ ns.current_bundle.bundle_btn_text | default('اشتري معاً بسعر') }}</span>
            <span id="bundle-total-display" class="font-bold"></span>
            <span id="bundle-add-loader" class="hidden">
              <svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="60" stroke-dashoffset="20"/>
              </svg>
            </span>
          </button>
        </div>
      </div>

    </div>
  </section>

  <script>
  (function () {

    const MAIN_PRODUCT = {
      id: {{ (product.selected_product.id if product.selected_product else product.id) | string | tojson }},
      name: {{ product.name | tojson }},
      price: {{ (safeget(product, 'selected_product.sale_price') or safeget(product, 'selected_product.price') or product.sale_price or product.price or 0) | float | tojson }},
      image: {{ safeget(product, 'main_image.image.medium', '') | tojson }},
      formatted_price: {{ (product.formatted_sale_price or product.formatted_price or '') | tojson }}
    };

    const BUNDLE_ITEMS_RAW = [
      {% for item in ns.current_bundle.bundle_items if item.product %}
      {
        id: {{ item.product.id | string | tojson }},
        name: {{ item.product.name | tojson }},
        checked: {{ (item.checked_by_default | default(false)) | tojson }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ];

    const BTN_COLOR = {{ (ns.current_bundle.bundle_btn_color or '#e63b3b') | tojson }};
    const I18N = {
      loadError: {{ _("Could not load products") | tojson }},
      added: {{ _("Products added to cart") | tojson }},
      partiallyAdded: {{ _("Some products were added") | tojson }},
      failed: {{ _("Some products are out of stock") | tojson }},
      selectOptions: {{ _("Select options") | tojson }}
    };
    let bundleData = [];

    function showSkeletonError() {
      const skeleton = document.getElementById('bundle-skeleton');
      if (skeleton) {
        skeleton.innerHTML = '<p class="text-sm text-gray-400 text-right"></p>';
        skeleton.firstChild.textContent = I18N.loadError;
      }
    }

    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    // Reuse the store's formatted price (currency symbol/position) for the bundle total
    function formatMoney(amount) {
      const value = Number(amount || 0).toFixed(2);
      const sample = MAIN_PRODUCT.formatted_price || '';
      const numberPattern = /[\d٠-٩][\d٠-٩.,٫٬\s]*/;
      return numberPattern.test(sample) ? sample.replace(numberPattern, value + ' ').replace(/\s+/g, ' ').trim() : value;
    }

    function notify(message, type) {
      if (typeof window.showAnanasToast === 'function') {
        window.showAnanasToast(message, type || 'success');
      }
    }

    async function loadBundleProducts() {
      try {
        const fetched = await Promise.all(
          BUNDLE_ITEMS_RAW.map(async function (item) {
            const response = await window.zid.products.get(item.id);
            const p = (response && (response.product || response.data)) || response || {};
            const needsOptions = !!(p.has_options || p.has_fields || p.product_class === 'dynamic_bundle');
            return {
              id: item.id,
              name: p.name || item.name,
              price: p.sale_price || p.price || 0,
              formatted_price: p.formatted_sale_price || p.formatted_price || '',
              image: (p.main_image && p.main_image.image && p.main_image.image.medium) || '',
              url: p.html_url || (p.slug ? '/products/' + p.slug : ''),
              needsOptions: needsOptions,
              checked: needsOptions ? false : item.checked
            };
          })
        );
        bundleData = fetched;
        renderBundle();
      } catch (e) {
        console.error('Bundle fetch error:', e);
        showSkeletonError();
      }
    }

    function waitForZid(callback, retries) {
      retries = typeof retries === 'number' ? retries : 25;
      if (window.zid && window.zid.products && window.zid.cart) {
        callback();
      } else if (retries > 0) {
        setTimeout(function () { waitForZid(callback, retries - 1); }, 200);
      } else {
        console.error('zid SDK not available');
        showSkeletonError();
      }
    }

    function renderBundle() {
      const row = document.getElementById('bundle-products-row');
      if (!row) return;
      row.innerHTML = '';

      row.appendChild(createCard({
        id: MAIN_PRODUCT.id,
        name: MAIN_PRODUCT.name,
        price: MAIN_PRODUCT.price,
        formatted_price: MAIN_PRODUCT.formatted_price,
        image: MAIN_PRODUCT.image,
        checked: true
      }, false));

      bundleData.forEach(function (item) {
        const plus = document.createElement('div');
        plus.className = 'flex items-center self-center text-[#737373] text-xl font-light mt-[-20px] select-none';
        plus.textContent = '+';
        row.appendChild(plus);
        row.appendChild(createCard(item, !item.needsOptions));
      });
      updateTotal();
      document.getElementById('bundle-skeleton').classList.add('hidden');
      document.getElementById('bundle-content').classList.remove('hidden');
    }

    function createCard(item, toggleable) {
      const wrapper = document.createElement('div');
      wrapper.className = 'bundle-card flex flex-col items-start w-[106px] md:w-[120px]';
      wrapper.dataset.id = item.id;
      wrapper.dataset.price = item.price;
      wrapper.dataset.checked = item.checked ? 'true' : 'false';

      const imgOpacity = item.checked ? '1' : '0.4';
      const checkBg = item.checked ? '#1b1b1b' : '#e5e7eb';
      const cursorClass = toggleable ? 'cursor-pointer' : '';
      const optionsLink = item.needsOptions && item.url
        ? '<a href="' + escapeHtml(item.url) + '" class="text-xs underline mt-1">' + escapeHtml(I18N.selectOptions) + '</a>'
        : '';

      wrapper.innerHTML = `
        <div class="relative ${cursorClass}" data-bundle-toggle>
          <img src="${escapeHtml(item.image)}"
               alt="${escapeHtml(item.name)}"
               class="w-[106px] h-[106px] md:w-[120px] md:h-[120px] object-cover transition-opacity duration-200"
               style="opacity:${imgOpacity};">
          <div class="check-dot absolute top-1 right-1 w-5 h-5 rounded flex items-center justify-center transition-colors duration-200"
               style="background:${checkBg};">
            <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
              <path d="M1 4L3.5 6.5L9 1" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
        </div>
        <p class="font-medium text-xs leading-4 tracking-normal md:text-sm md:leading-5 line-clamp-2 w-full">${escapeHtml(item.name)}</p>
        <p class="text-xs font-medium mt-1" style="color:${escapeHtml(BTN_COLOR)};">${escapeHtml(item.formatted_price)}</p>
        ${optionsLink}
      `;
      if (toggleable) {
        wrapper.querySelector('[data-bundle-toggle]').addEventListener('click', function () {
          toggleItem(item.id);
        });
      }
      return wrapper;
    }

    function toggleItem(id) {
      const card = document.querySelector('.bundle-card[data-id="' + CSS.escape(id) + '"]');
      if (!card) return;
      const isChecked = card.dataset.checked === 'true';
      card.dataset.checked = isChecked ? 'false' : 'true';
      card.querySelector('img').style.opacity = isChecked ? '0.4' : '1';
      card.querySelector('.check-dot').style.background = isChecked ? '#e5e7eb' : '#1b1b1b';
      const item = bundleData.find(function (i) { return i.id === id; });
      if (item) item.checked = !isChecked;
      updateTotal();
    }

    function updateTotal() {
      let total = Number(MAIN_PRODUCT.price) || 0;
      bundleData.forEach(function (item) {
        if (item.checked) total += parseFloat(item.price || 0) || 0;
      });
      document.getElementById('bundle-total-display').textContent = formatMoney(total);
    }

    const addBtn = document.getElementById('bundle-add-btn');
    if (addBtn) {
      addBtn.addEventListener('click', async function (event) {
        event.preventDefault();
        const btn = this;
        const loader = document.getElementById('bundle-add-loader');
        btn.disabled = true;
        loader.classList.remove('hidden');

        let hasError = false;
        let addedCount = 0;

        // Main product goes through the product form so the selected variant,
        // quantity and custom fields are respected.
        try {
          await window.zid.cart.addProduct({ form_id: 'product-form' }, { showErrorNotification: true });
          addedCount++;
        } catch (e) {
          console.warn('Failed to add main product:', e);
          hasError = true;
        }

        const extras = bundleData.filter(function (i) { return i.checked && !i.needsOptions; });
        for (const item of extras) {
          try {
            await window.zid.cart.addProduct({ product_id: item.id, quantity: 1 }, { showErrorNotification: false });
            addedCount++;
          } catch (e) {
            console.warn('Failed to add bundle product:', item.id, e);
            hasError = true;
          }
        }

        if (addedCount > 0) {
          try {
            const cart = await window.zid.cart.get();
            const count = (cart && (cart.cart_items_quantity != null ? cart.cart_items_quantity : cart.products_count)) || 0;
            document.querySelectorAll('[data-cart-badge]').forEach(function (el) {
              el.textContent = count;
              el.hidden = count === 0;
            });
            window.dispatchEvent(new CustomEvent('cart:updated', { detail: { action: 'add', source: 'bundle', cart: cart } }));
          } catch (e) {
            console.warn('Cart refresh failed:', e);
          }
        }

        if (!hasError) {
          notify(I18N.added, 'success');
        } else if (addedCount > 0) {
          notify(I18N.partiallyAdded, 'warning');
        } else {
          notify(I18N.failed, 'error');
        }

        btn.disabled = false;
        loader.classList.add('hidden');
      });
    }

    waitForZid(loadBundleProducts);

  })();
  </script>
  {% endif %}

