{% extends "layout.jinja" %}

{% block title %}{{ product.name }} – {{ store.name }}{% endblock %}

{% block content %}
  {# Preorder state (see Zid "Add Preorder Support"): can_be_preordered drives
     availability, preorder_campaign drives display #}
  {% if product %}
    {% set selected_product = selected_product if selected_product is defined else product.selected_product %}
    {% set has_preorder = true if product.effective_preorder_campaign else false %}
    {% set can_preorder = product.can_be_preordered %}
    {% set preorder_stock_behavior = product.preorder_stock_behavior %}
    {% set is_in_stock = selected_product.in_stock if selected_product else product.in_stock %}
    {% set can_buy = is_in_stock or can_preorder %}
  {% else %}
    {% set has_preorder = false %}
    {% set can_preorder = false %}
    {% set preorder_stock_behavior = '' %}
    {% set is_in_stock = false %}
    {% set can_buy = false %}
  {% endif %}

  {# Breadcrumb Section #}
  <section class="py-[10px]"
  style="background-color: {{ settings.single_product_section_background_color_page or 'transparent' }};"
  >
    <div class="theme-container"> 
      {% if product.categories and product.categories|length > 0 %}
        {% set category = product.categories[0] %}
        {%
          with
          items=[
            {'href': url_for('home'), 'label': _("Home")},
            {'href': url_for("category_details", category_id=category.id or "a", slug=category.slug or category.id), 'label': category.name},
            {'label': product.name}
          ]
        %}
          {% include 'components/ui/breadcrumb.jinja' %}
        {% endwith %}
      {% else %}
        {%
          with
          items=[
            {'href': url_for('home'), 'label': _("Home")},
            {'label': product.name}
          ]
        %}
          {% include 'components/ui/breadcrumb.jinja' %}
        {% endwith %}
      {% endif %}
    </div>
  </section>

  {# Product Main Section #}
  {% set details_position = store.settings.product_gallery.details_thumbnail_position %}
  <section class="pb-9 md:pb-12 single-product-page"
  data-has-preorder="{{ 'true' if has_preorder else 'false' }}"
  data-can-preorder="{{ 'true' if can_preorder else 'false' }}"
  data-stock-behavior="{{ preorder_stock_behavior or '' }}"
  
  style="background-color: {{ settings.single_product_section_background_color_page or 'transparent' }};">
    <div class="theme-container overflow-x-hidden">
      {# 2-Column Layout: Gallery + Details #}
      <div
        id="product-main-section"
        class="grid grid-cols-1 gap-6 md:grid-cols-2"
      >
        {# Left Column: Product Gallery #}
        <div class="flex flex-col gap-2">
                  {% if settings.product_gallery_details_thumbnail_position == 'top' %}
                          <div
                    id="header"
                    class=" md:hidden"
                    data-show="top"
                  >
                    <div class="flex flex-wrap items-start justify-between gap-1">
                      <div class="space-y-1">
                        <h1 class="text-foreground text-lg font-semibold md:text-xl" data-show="top">{{ product.name }}</h1>
                        {% if store.settings.products.reviews_enabled %}
                          {% if product.rating %}
                            <div class="flex items-center gap-2" data-show="top">
                              {% with  rating=product.rating.average %}
                                {% include 'components/rating-stars.jinja' %}
                              {% endwith %}
                              <p class="font-medium text-sm leading-5 tracking-normal text-[#737373]">
                                {{ product.rating.average }} ({{ product.rating.total_count }} {{ _('reviews') }})
                              </p>
                            </div>
                          {% endif %}
                        {% endif %}
                      </div>

                      <div class="flex items-center gap-2 qv_actions" data-show="top">
                        {% with product_id=product.id, class="!border !border-[#E5E5E5] rounded-full" %}
                          {% include 'components/products/wishlist-button.jinja'%}
                        {% endwith %}

                        <div class="relative">
                          <button
                            type="button"
                            id="share-dropdown-toggle"
                            style="
                                  border: 1px solid #E5E5E5 !important;
                                  border-radius: 50%;
"
                            class="btn share-dropdown-toggle btn-icon btn-icon-md border border-border !border !border-[#E5E5E5] rounded-full text-foreground hover:border-foreground hover:text-foreground"
                            aria-haspopup="menu"
                            aria-expanded="false"
                            aria-controls="share-dropdown-menu"
                            data-share-title="{{ product.name }}"
                            data-share-url="{{ product.html_url }}"
                            aria-label="{{ _('Share product') }}"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="18" cy="5" r="3"></circle>
                              <circle cx="6" cy="12" r="3"></circle>
                              <circle cx="18" cy="19" r="3"></circle>
                              <path d="M8.59 13.51l6.83 3.98"></path>
                              <path d="M8.59 10.49l6.83-3.98"></path>
                            </svg>
                          </button>

                          <div
                            id="share-dropdown-menu"
                            class="absolute right-[-13px] z-50 mt-2 w-56 overflow-hidden rounded-3xl border w-fit border-border bg-white shadow-xl opacity-0 scale-95 pointer-events-none transition-all duration-200 origin-top-right"
                            aria-hidden="true"
                          >
                            <a
                              href="https://api.whatsapp.com/send?text={{ _('Check Out this Product') }}: {{ product.name }} {{ product.html_url }}"
                              target="_blank"
                              rel="noopener noreferrer"
                              class="flex items-center gap-3 px-2 py-3 text-sm text-foreground transition hover:bg-slate-50"
                              aria-label="{{ _('Share on WhatsApp') }}"
                              data-share-action="link"
                            >
                              <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#25D366]/10 text-[#25D366]">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                                </svg>
                              </span>
                            </a>
                            <a
                              href="https://twitter.com/intent/tweet?text={{ product.name }}: {{ product.html_url }}"
                              target="_blank"
                              rel="noopener noreferrer"
                              class="flex items-center gap-3 px-2 py-3 text-sm text-foreground transition hover:bg-slate-50"
                              aria-label="{{ _('Share on Twitter') }}"
                              data-share-action="link"
                            >
                              <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#1DA1F2]/10 text-[#1DA1F2]">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                </svg>
                              </span>
                            </a>
                            <a
                              href="https://www.facebook.com/sharer/sharer.php?u={{ product.html_url }}"
                              target="_blank"
                              rel="noopener noreferrer"
                              class="flex items-center gap-3 px-2 py-3 text-sm text-foreground transition hover:bg-slate-50"
                              aria-label="{{ _('Share on Facebook') }}"
                              data-share-action="link"
                            >
                              <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#1877F2]/10 text-[#1877F2]">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                </svg>
                              </span>
                            </a>
                            <button
                              type="button"
                              class="flex w-full items-center gap-3 px-2 py-3 text-sm text-foreground transition hover:bg-slate-50"
                              aria-label="{{ _('Copy link') }}"
                              data-share-action="copy"
                            >
                              <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-slate-200 text-slate-700">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                                </svg>
                              </span>
                            </button>
                          </div>
                          <div id="share-toast" class="pointer-events-none absolute right-0 top-full mt-3 hidden rounded-full bg-foreground px-3 py-2 text-xs font-medium text-white shadow-lg opacity-0 transition-opacity duration-200">
                            {{ _('Link copied') }}
                          </div>
                        </div>
                      </div>
                    </div>
                    {# Price Section #}
                    <div class="flex flex-wrap items-center justify-between gap-y-1 border-b border-[#E5E5E5] pb-2" data-show="top">
                      <div class="flex flex-wrap items-center gap-2">
                        {# Current Price (sale or regular) #}
                        <p
                          class="font-medium text-2xl leading-8 tracking-normal align-middle"
                          data-product-price
                        >
                          {{ product.formatted_sale_price if product.formatted_sale_price else product.formatted_price }}
                        </p>
                        {# Old Price (if on sale) #}
                        <span
                          class="text-[#737373] font-normal text-lg leading-7 tracking-normal align-middle {{ 'hidden' if not product.formatted_sale_price }} text-sm line-through"
                          data-product-price-old
                        >
                          {{ product.formatted_price if product.formatted_sale_price else '' }}
                        </span>
                        {# Discount Badge #}
                        <span
                          class="bg-success/20 text-success {{ 'hidden' if not (product.discount_percentage and product.discount_percentage > 0) }} rounded px-2 py-1 text-xs tracking-wide uppercase"
                          data-product-discount
                        >
                          {% if product.discount_percentage and product.discount_percentage > 0 %}
                            {{ _("Discount") }}
                            {{ product.discount_percentage }}%
                          {% endif %}
                        </span>
                      </div>
                      {# SKU #}
                    </div>
                          </div>
                  {% endif %}
                  <div class="product-gallery-column relative">
                                        {# Product Badges #}
                    <div
                      id="product-badges"
                      class="absolute top-4 right-4 z-20 flex flex-wrap items-center gap-2"
                    >
                      {# Merchant Badge (custom product badge) #}
                      {% if product.badge %}
                        {% with product=product %}
                          {% include 'components/products/merchant-badge.jinja' %}
                        {% endwith %}
                      {% endif %}

                      {# Preorder Badge #}
                      {% if has_preorder %}
                        {% include 'vitrin:products/preorder_badge.jinja' %}
                      {% endif %}

                      {# Bundle Offer Badge #}
                      {% if product.bundle_offer %}
                        <span class="badge badge-outlined text-destructive border-destructive">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 16 16"
                            fill="none"
                          >
                            <path
                              d="M8.57129 1.25488H13.6562C13.9618 1.25489 14.2228 1.36327 14.4404 1.58105C14.6581 1.79871 14.7666 2.05976 14.7666 2.36523V7.4375C14.7666 7.58599 14.7358 7.72769 14.6738 7.8623C14.6115 7.99756 14.5316 8.11495 14.4346 8.21484L8.2334 14.4287C8.12146 14.5288 7.99845 14.606 7.86426 14.6602C7.73001 14.7143 7.5927 14.7412 7.45312 14.7412C7.31346 14.7412 7.17481 14.7155 7.03711 14.6641C6.89982 14.6127 6.77477 14.5342 6.66309 14.4287L1.5918 9.34082L1.59082 9.33984L1.51367 9.26074C1.4414 9.17848 1.38421 9.08497 1.34277 8.97949C1.28714 8.83758 1.25977 8.69644 1.25977 8.55762C1.25981 8.41792 1.28642 8.27939 1.33984 8.1416C1.39308 8.00461 1.47689 7.88034 1.5918 7.76855V7.76758L7.78027 1.58691H7.78125C7.88159 1.48455 8.00131 1.40329 8.14062 1.34375C8.2797 1.28424 8.42318 1.25489 8.57129 1.25488ZM8.55859 2.35156L2.33984 8.56152L2.32227 8.5791L2.33984 8.59668L7.40723 13.6816L7.42578 13.6992L7.44336 13.6816L13.6738 7.4209L13.6816 7.41406V2.34375H8.56641L8.55859 2.35156ZM11.9102 3.26074C12.1369 3.26074 12.333 3.34394 12.499 3.51074C12.6651 3.67744 12.748 3.87218 12.748 4.09668C12.748 4.32117 12.6653 4.51613 12.499 4.68262C12.3328 4.84889 12.1368 4.93153 11.9102 4.93164C11.6835 4.93164 11.4879 4.84927 11.3232 4.68262C11.1583 4.51565 11.0762 4.31964 11.0762 4.09473C11.0763 3.87001 11.1582 3.67486 11.3232 3.50879C11.4883 3.34293 11.6837 3.26084 11.9102 3.26074Z"
                              fill="currentColor"
                              stroke="currentColor"
                              stroke-width="0.05"
                            ></path>
                          </svg>
                          {{ product.bundle_offer.name }}
                        </span>
                      {% endif %}

                      {# Sold Items Badge #}
                      {% set sold_count = product.sold_products_count or (product.selected_product and product.selected_product.sold_products_count) %}
                      <span
                        data-sold-count-badge
                        class="badge badge-outlined border-foreground {{ '!hidden' if not sold_count }}"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 16 16"
                          fill="none"
                        >
                          <path
                            d="M9.35059 1.25488C10.0392 1.25488 10.6 1.52568 11.0342 2.06934C11.4687 2.61337 11.6367 3.23657 11.5381 3.94043L11.5342 3.96875H13.8164C14.1051 3.96876 14.344 4.07663 14.5342 4.29199C14.7243 4.50715 14.8017 4.75891 14.7666 5.04883L13.7197 13.5957C13.6752 13.9276 13.5338 14.201 13.2949 14.417C13.0559 14.6331 12.7711 14.7412 12.4404 14.7412H3.5127C3.21892 14.7412 2.98865 14.6304 2.81934 14.4092C2.65316 14.1922 2.56811 13.9412 2.56348 13.6553H12.6152L12.6182 13.6338V13.6328L12.6221 13.6338L13.0283 10.3213C13.0396 10.2451 13.0499 10.1759 13.0596 10.1143V10.1133L13.1074 9.69629L13.2344 8.67188C13.2846 8.26141 13.3261 7.91589 13.3594 7.63574L13.3584 7.63477L13.6729 5.08691L13.6719 5.08594L13.6729 5.08301L13.6758 5.05469H11.3965L11.3936 5.07617L11.2383 6.37305C11.2142 6.53302 11.1441 6.66525 11.0293 6.77148V6.77246C10.9143 6.87874 10.7807 6.93432 10.6279 6.93945C10.4774 6.94455 10.3554 6.89357 10.2598 6.78809C10.164 6.6826 10.1249 6.55764 10.1436 6.41113L10.3076 5.08301L10.3105 5.05469H7.39551L7.39355 5.07617L7.23828 6.37695C7.21418 6.53699 7.1441 6.66853 7.0293 6.77344C6.9143 6.87858 6.78096 6.93431 6.62793 6.93945C6.4787 6.94497 6.35704 6.89375 6.26074 6.78711C6.1645 6.6805 6.12643 6.55631 6.14746 6.41211L6.14844 6.41113L6.31152 5.08301L6.31543 5.05469H3.61719C3.66031 4.7436 3.79943 4.48658 4.03613 4.2832C4.27999 4.07366 4.56352 3.96882 4.8877 3.96875H6.43945L6.44336 3.94922L6.47656 3.78223H6.47754V3.78027C6.5903 2.96648 6.89476 2.34327 7.38965 1.9082C7.88472 1.47312 8.53768 1.25493 9.35059 1.25488ZM1.4834 10.8027H3.8252C3.97895 10.8028 4.10614 10.8558 4.20898 10.9619C4.31202 11.0684 4.36426 11.198 4.36426 11.3525C4.36421 11.5069 4.31246 11.6346 4.20996 11.7373C4.10718 11.84 3.97921 11.8916 3.8252 11.8916H1.4834C1.32969 11.8915 1.20183 11.8391 1.09766 11.7344C0.993475 11.6296 0.941449 11.5012 0.941406 11.3467C0.941406 11.1921 0.993443 11.0633 1.09766 10.959C1.2018 10.8547 1.32973 10.8028 1.4834 10.8027ZM2.81738 8.12012H5.8252C5.97907 8.12016 6.10772 8.17262 6.21191 8.27734C6.31577 8.38194 6.36806 8.51064 6.36816 8.66504C6.36816 8.81963 6.31588 8.94799 6.21191 9.05078C6.10775 9.15367 5.9792 9.20504 5.8252 9.20508H2.81738C2.66355 9.20508 2.5349 9.15262 2.43066 9.04785C2.32656 8.943 2.27441 8.81376 2.27441 8.65918C2.27452 8.50465 2.32675 8.37711 2.43066 8.27441C2.53487 8.17159 2.6634 8.12012 2.81738 8.12012ZM9.22363 2.34375C8.76196 2.34375 8.38493 2.46741 8.09473 2.71582C7.80464 2.96414 7.63033 3.31727 7.57129 3.77246L7.53809 3.93945L7.53223 3.96875H10.4414L10.4443 3.94727C10.498 3.5318 10.4062 3.16059 10.1699 2.83496C9.93317 2.50842 9.61726 2.34378 9.22363 2.34375Z"
                            fill="currentColor"
                            stroke="currentColor"
                            stroke-width="0.05"
                          ></path>
                        </svg>
                        <span data-sold-count-text>{{ ('تم بيع أكثر من %s مرة' if session.lang == 'ar' else 'Sold more than %s times') | format(sold_count) if sold_count }}</span>
                      </span>

                      {# Remaining Stock Badge #}
                      <span
                        data-low-stock-badge
                        class="badge badge-outlined border-foreground {{ '!hidden' if not product.low_stock_quantity }}"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 16 16"
                          fill="none"
                        >
                          <path
                            d="M3.33333 2.66667V13.3333H12.6667V2.66667H3.33333ZM2.66667 1.33333H13.3333C13.687 1.33333 14 1.64638 14 2V14C14 14.3536 13.687 14.6667 13.3333 14.6667H2.66667C2.31304 14.6667 2 14.3536 2 14V2C2 1.64638 2.31304 1.33333 2.66667 1.33333ZM8 4.66667C8.36819 4.66667 8.66667 4.96514 8.66667 5.33333V9.33333C8.66667 9.70152 8.36819 10 8 10C7.63181 10 7.33333 9.70152 7.33333 9.33333V5.33333C7.33333 4.96514 7.63181 4.66667 8 4.66667ZM8 10.6667C8.36819 10.6667 8.66667 10.9651 8.66667 11.3333C8.66667 11.7015 8.36819 12 8 12C7.63181 12 7.33333 11.7015 7.33333 11.3333C7.33333 10.9651 7.63181 10.6667 8 10.6667Z"
                            fill="currentColor"
                          ></path>
                        </svg>
                        <span data-low-stock-text
                          >{{ ('متبقي %s فقط' if session.lang == 'ar' else 'Remaining %s only') | format(product.low_stock_quantity) if product.low_stock_quantity }}</span
                        >
                      </span>
                    </div>
                    {% with product=product,gallery_id="product-gallery" %}
                      {% include 'components/products/product-gallery.jinja' %}
                    {% endwith %}
                  </div>
                  {% if settings.single_product_section_list_features_with_product_selection_store and settings.single_product_section_list_features_with_product_selection_store|length > 0 %}

                  {% set matching_features_store = [] %}
                  {% for group in settings.single_product_section_list_features_with_product_selection_store %}
                    {% for item in group.product_has_features_store %}
                      {% if item.products_store_features_shown and item.products_store_features_shown.id == product.id %}
                        {% for feature in group.list_features_store %}
                          {% set _ = matching_features_store.append(feature) %}
                        {% endfor %}
                      {% endif %}
                    {% endfor %}
                  {% endfor %}

                  {% if matching_features_store|length > 0 %}
                  <section class="mt-2 Features-Grid">
                    <div class="">
                      {# Features Grid #}
                      <div class="grid grid-cols-3 gap-4 p-2 !border !border-[#E5E5E5]">
                        {% for feature in matching_features_store %}
                          <div class="feature-card rounded-lg transition-all duration-300 feature-card relative rounded-lg transition-all duration-300
                                      after:content-[''] after:absolute after:left-0
                                      after:top-1/2 after:-translate-y-1/2
                                      after:h-[34px] after:w-px after:bg-gray-200
                                      [&:nth-child(3n)]:after:hidden">

                            <div class="flex justify-center mb-2">
                              <div class="flex items-center justify-center rounded-full w-[38px] h-[38px] md:w-[56px] md:h-[56px] transition-transform duration-300 hover:scale-110">

