                          delay="800"
                          colors="primary:{{ feature.first_icon_color | default('#FF6B6B') }},secondary:{{ feature.second_icon_color | default('#4ECDC4') }}"
                          style="
                            width: {{ settings.single_product_section_features_icon_size | default(56) }}px;
                            height: {{ settings.single_product_section_features_icon_size | default(56) }}px;
                          "
                        >
                        </lord-icon>

                      {% endif %}
                    </div>
                  </div>

                  {# Text Content #}
