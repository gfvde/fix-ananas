        {# ── Dara tabs: shipping + styling & care ── #}
        {% set shipping_text = settings.single_product_section_shipping_tab_content | default(_('Orders are prepared within 1-2 business days.') ~ '\n' ~ _('Delivery takes 2-5 business days depending on your city.') ~ '\n' ~ _('You can track your order from your account once it ships.'), true) %}
        {% set show_shipping_tab = settings.single_product_section_show_shipping_tab != false and shipping_text %}
