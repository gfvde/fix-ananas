        {% if show_shipping_tab %}{% set _t = pdp_tabs.append({'id': 'shipping', 'label': settings.single_product_section_shipping_tab_title | default(_('Shipping & delivery'), true)}) %}{% endif %}
        {% if show_styling_tab %}{% set _t = pdp_tabs.append({'id': 'styling', 'label': settings.single_product_section_styling_care_tab_title | default(_('Styling & care'), true)}) %}{% endif %}
        {% if has_bundle %}{% set _t = pdp_tabs.append({'id': 'bundle', 'label': product.bundle_offer.name}) %}{% endif %}
        {% if has_options %}{% set _t = pdp_tabs.append({'id': 'options', 'label': _('Options')}) %}{% endif %}
        {% if store.settings.products.questions_enabled %}{% set _t = pdp_tabs.append({'id': 'faq', 'label': _('Questions')}) %}{% endif %}
        {% if show_coffee_cta %}{% set _t = pdp_tabs.append({'id': 'coffee-cta', 'label': settings.single_product_section_title_coffee_cta_section | default(_('Choose your brewing method'), true)}) %}{% endif %}

        <div class="pdp-tabs" data-pdp-tabs>
