      <script>
        // Accordion Functionality
        document.addEventListener('DOMContentLoaded', function() {
          const accordionButtons = document.querySelectorAll('.accordion-button');
          
          accordionButtons.forEach(button => {
            button.addEventListener('click', function() {
              const accordionId = this.getAttribute('data-accordion');
              const content = document.querySelector(`[data-accordion-content="${accordionId}"]`);
              const icon = this.querySelector('.accordion-icon');
              
              // Close all other accordions
              accordionButtons.forEach(otherButton => {
                if (otherButton !== this) {
                  const otherContent = document.querySelector(`[data-accordion-content="${otherButton.getAttribute('data-accordion')}"]`);
                  const otherIcon = otherButton.querySelector('.accordion-icon');
                  otherContent.classList.add('hidden');
                  otherContent.style.maxHeight = '0px';
                  otherIcon.style.transform = 'rotate(0deg)';
                }
              });
              
              // Toggle current accordion
              const isOpen = !content.classList.contains('hidden');
              
              if (isOpen) {
                content.classList.add('hidden');
                content.style.maxHeight = '0px';
                icon.style.transform = 'rotate(0deg)';
              } else {
                content.classList.remove('hidden');
                content.style.maxHeight = content.scrollHeight + 'px';
                icon.style.transform = 'rotate(180deg)';
              }
            });
          });

          // Tab functionality for desktop (keep existing code)
          const tabButtons = document.querySelectorAll('.tab-button');
          tabButtons.forEach(button => {
            button.addEventListener('click', function() {
              const tabName = this.getAttribute('data-tab');
              
              // Hide all tabs
              document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.add('hidden');
                tab.classList.remove('opacity-100');
                tab.classList.add('opacity-0');
              });
              
              // Remove active state from all buttons
              tabButtons.forEach(btn => {
                btn.classList.remove('text-foreground', 'border-foreground');
                btn.classList.add('text-muted-foreground', 'border-transparent');
              });
              
              // Show selected tab
              const selectedTab = document.getElementById(`${tabName}-tab`);
              if (selectedTab) {
                selectedTab.classList.remove('hidden');
                selectedTab.classList.remove('opacity-0');
                selectedTab.classList.add('opacity-100');
              }
              
              // Add active state to clicked button
              this.classList.remove('text-muted-foreground', 'border-transparent');
              this.classList.add('text-foreground', 'border-foreground');
            });
          });
        });
      </script>
  <script>
  const viewerText = document.getElementById("viewerText");

  // detect language (عدل حسب نظامك)
  const lang = document.documentElement.lang || "ar";

  function getRandomViewers(min = 5, max = 30) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function updateViewers() {
    const count = getRandomViewers();

    if (lang === "ar") {
      viewerText.textContent = `يشاهد ${count} شخصًا هذا المنتج الآن`;
    } else {
      viewerText.textContent = `${count} people are viewing this product now`;
    }
  }

  updateViewers();

  setInterval(updateViewers, 15000);
</script>
<script>
window.zidProductBuyNow = async (btn) => {

    const setLoading = (state) => {
        const spinner = btn.querySelector('.buy-now-spinner');
        const icon = btn.querySelector('.buy-now-icon');
        const text = btn.querySelector('.buy-now-text');

        btn.disabled = state;

        if (spinner) spinner.classList.toggle('hidden', !state);
        if (icon) icon.classList.toggle('hidden', state);

        // اختياري: تغيير النص
        if (text) {
            text.textContent = state ? 'Processing...' : '{{ _("Buy now") }}';
        }
    };

    const bundlePayload = window.bundleCartPayload;
    const addProductOptions = bundlePayload
        ? { ...bundlePayload, form_id: 'product-form' }
        : { form_id: 'product-form' };

    try {
        setLoading(true);

        await window.zid.cart.buyNow(
            addProductOptions,
            { showErrorNotification: true }
        );

    } catch (error) {
        console.error(error, 'Buy Now failed');
    } finally {
        setLoading(false);
    }
};

</script>
<script>
document.addEventListener('DOMContentLoaded', () => {

    const shareToggle = document.querySelectorAll('.share-dropdown-toggle');
    const shareMenu = document.querySelectorAll('#share-dropdown-menu');
    const shareToast = document.querySelectorAll('#share-toast');

    const closeShareMenu = () => {

        shareMenu.forEach(menu => {
            menu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
            menu.classList.remove('opacity-100', 'scale-100');
            menu.setAttribute('aria-hidden', 'true');
        });

        shareToggle.forEach(toggle => {
            toggle.setAttribute('aria-expanded', 'false');
        });
    };

    const openShareMenu = () => {

        shareMenu.forEach(menu => {
            menu.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
            menu.classList.add('opacity-100', 'scale-100');
            menu.setAttribute('aria-hidden', 'false');
        });

        shareToggle.forEach(toggle => {
            toggle.setAttribute('aria-expanded', 'true');
        });
    };

    const toggleShareMenu = () => {

        const isOpen = [...shareToggle].some(
            toggle => toggle.getAttribute('aria-expanded') === 'true'
        );

        isOpen ? closeShareMenu() : openShareMenu();
    };

    const showShareToast = () => {

        shareToast.forEach(toast => {
            toast.classList.remove('hidden');
            toast.classList.add('opacity-100');
        });

        setTimeout(() => {
            shareToast.forEach(toast => {
                toast.classList.add('hidden');
                toast.classList.remove('opacity-100');
            });
        }, 1600);
    };

    shareToggle.forEach(toggle => {

        toggle.addEventListener('click', event => {
            event.stopPropagation();
            toggleShareMenu();
        });
    });

    shareMenu.forEach(menu => {

        menu.addEventListener('click', event => {
            event.stopPropagation();
        });

        menu.querySelectorAll('a[data-share-action="link"]').forEach(link => {
            link.addEventListener('click', closeShareMenu);
        });

        menu.querySelectorAll('button[data-share-action="copy"]').forEach(button => {

            button.addEventListener('click', async event => {

                event.preventDefault();
                event.stopPropagation();

                const toggle =
                    button.closest('[data-share-wrapper]')
                    ?.querySelector('.share-dropdown-toggle');

                const shareUrl =
                    toggle?.dataset.shareUrl || window.location.href;

                try {

                    await navigator.clipboard.writeText(shareUrl);

                    showShareToast();

                } catch (error) {

                    console.error('Copy failed', error);
                }

                closeShareMenu();
            });
        });
    });

    document.addEventListener('click', closeShareMenu);

    window.product = {{ product | tojson | safe }};
    window.sett = {{ settings | tojson | safe }};

    console.log(window.sett, "window.settings");

});
</script>
<script>
(function () {

  const normalize = (str) => str.toLowerCase().trim();

  const colorMap = {
    red: "#ef4444",
    green: "#22c55e",
    blue: "#3b82f6",
    black: "#111827",
    white: "#ffffff",
    yellow: "#eab308",
    orange: "#f97316",
    purple: "#a855f7",
    pink: "#ec4899",
    gray: "#6b7280",
  };

  document.querySelectorAll('.product-options__item').forEach(el => {
    let value =
      el.getAttribute('value') ||
      el.querySelector('.product-options__item-text')?.textContent ||
      '';

    value = normalize(value);

    let color = null;

    if (/^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(value)) {
      color = value;
    }

    else if (value.startsWith('rgb')) {
      color = value;
    }

    else if (colorMap[value]) {
      color = colorMap[value];
    }
    if (color) {
      el.style.backgroundColor = color;

      // نص أبيض لو اللون غامق
      el.style.color = getContrastColor(color);

      el.classList.add('colorized');
    }
  });

  function getContrastColor(hex) {
    if (!hex.startsWith('#')) return '#fff';

    const c = hex.substring(1);
    const rgb = parseInt(c.length === 3
      ? c.split('').map(x => x + x).join('')
      : c, 16);

    const r = (rgb >> 16) & 255;
    const g = (rgb >> 8) & 255;
    const b = rgb & 255;

    const brightness = (r * 299 + g * 587 + b * 114) / 1000;

    return brightness > 150 ? '#000' : '#fff';
  }

})();
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  'use strict';

  /* ─────────────────────────────────────────────────
     Shared Iframe Modal
     Trigger: any [.open-iframe-modal] button
     URL / title come from [data-iframe-url] & [data-iframe-title]
  ───────────────────────────────────────────────── */
  var modal       = document.getElementById('coffeeIframeModal');
  var overlay     = document.getElementById('coffeeModalOverlay');
  var closeBtn    = document.getElementById('coffeeModalClose');
  var iframe      = document.getElementById('coffeeIframe');
  var iframeTitle = document.getElementById('coffeeIframeTitle');

  function openModal(url, title) {
    if (!modal || !iframe) return;
    iframe.src          = url || '';
    iframe.title        = title || '';
    if (iframeTitle) iframeTitle.textContent = title || '';
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal || !iframe) return;
    modal.classList.add('hidden');
    iframe.src = '';          // free resources
    iframe.title = '';
    document.body.style.overflow = '';
  }

  // Delegate clicks on ALL .open-iframe-modal buttons (current + future)
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.open-iframe-modal');
    if (!btn) return;
    var url   = btn.getAttribute('data-iframe-url');
    var title = btn.getAttribute('data-iframe-title') || '';
    if (!url) return;           // guard: no URL → do nothing
    openModal(url, title);
  });

  if (closeBtn)  closeBtn.addEventListener('click', closeModal);
  if (overlay)   overlay.addEventListener('click', closeModal);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
});
</script>
