{% extends "layout.jinja" %}

{% block title %}{{ product.name }} – {{ store.name }}{% endblock %}

{% block content %}
  {# Preorder state (see Zid "Add Preorder Support"): can_be_preordered drives
     availability, preorder_campaign drives display #}
  {% if product %}
    {% set selected_product = selected_product if selected_product is defined else product.selected_product %}
    {% set has_preorder = true if product.effective_preorder_campaign else false %}
    {% set can_preorder = product.can_be_preordered %}
    {% set preorder_stock_behavior = product.preorder_stock_behavior %}
    {% set is_in_stock = selected_product.in_stock if selected_product else product.in_stock %}
    {% set can_buy = is_in_stock or can_preorder %}
  {% else %}
    {% set has_preorder = false %}
    {% set can_preorder = false %}
    {% set preorder_stock_behavior = '' %}
    {% set is_in_stock = false %}
    {% set can_buy = false %}
  {% endif %}

  {# ── Dara PDP options (layout.schema.json → single_product_section / product_gallery) ── #}
  {% set details_on_top = settings.product_gallery_details_thumbnail_position == 'top' %}
  {% set show_viewers = settings.single_product_section_show_viewers_counter != false %}
  {% set show_fabric = settings.single_product_section_show_fabric != false %}
  {% set show_look_details = settings.single_product_section_show_look_details != false %}
  {% set show_story_texture = settings.single_product_section_show_story_texture != false %}
  {% set show_low_stock = settings.single_product_section_show_low_stock != false %}
  {% set show_buy_now = settings.single_product_section_show_buy_now != false %}
  {% set show_trust = settings.single_product_section_show_trust_badges != false %}
  {% set sticky_gallery = settings.product_gallery_sticky_gallery != false %}

  {# Breadcrumb Section #}
  <section class="dara-pdp-breadcrumb"
  style="background-color: {{ settings.single_product_section_background_color_page or 'transparent' }};"
  >
    <div class="theme-container">
      {% if product.categories and product.categories|length > 0 %}
        {% set category = product.categories[0] %}
        {%
          with
          items=[
            {'href': url_for('home'), 'label': _("Home")},
            {'href': url_for("category_details", category_id=category.id or "a", slug=category.slug or category.id), 'label': category.name},
            {'label': product.name}
          ]
        %}
          {% include 'components/ui/breadcrumb.jinja' %}
        {% endwith %}
      {% else %}
        {%
          with
          items=[
            {'href': url_for('home'), 'label': _("Home")},
            {'label': product.name}
          ]
        %}
          {% include 'components/ui/breadcrumb.jinja' %}
        {% endwith %}
      {% endif %}
    </div>
  </section>

  {# Product Main Section #}
  <section class="dara-pdp single-product-page pb-9 md:pb-12"
  style="background-color: {{ settings.single_product_section_background_color_page or 'transparent' }};">
    <div class="theme-container pdp-container">
      {# 2-Column Layout: Gallery + Details #}
      <div
        id="product-main-section"
        {# Preorder state lives on the section quick view extracts, so it travels with it #}
        data-has-preorder="{{ 'true' if has_preorder else 'false' }}"
        data-can-preorder="{{ 'true' if can_preorder else 'false' }}"
        data-stock-behavior="{{ preorder_stock_behavior or '' }}"
        data-sticky-gallery="{{ 'true' if sticky_gallery else 'false' }}"
        class="pdp-main grid grid-cols-1 gap-6 md:grid-cols-2"
      >
        {# Stylesheet sits inside the section so quick view (which injects this section) loads it too #}
        <link rel="stylesheet" href="{{ 'css/dara/pdp.css' | asset_url }}">

        {# ── Gallery column ── #}
        <div class="pdp-gallery-col flex flex-col gap-2">
          {% if details_on_top %}
            <div id="header" class="pdp-header pdp-header--top md:hidden" data-show="top">
              {% with pdp_header_where='top' %}
                {% include 'components/products/pdp-header.jinja' %}
              {% endwith %}
            </div>
          {% endif %}

          <div class="product-gallery-column relative" data-thumb-pos="{{ settings.product_gallery_thumbnail_position | default('start') }}" data-thumb-layout="{{ settings.product_gallery_thumbnail_layout | default('vertical') }}" data-thumb-layout-mobile="{{ settings.product_gallery_mobile_thumbnail_layout | default('vertical') }}">
            {# Product Badges #}
            <div id="product-badges" class="pdp-badges">
              {# Merchant Badge (custom product badge) #}
              {% if product.badge %}
                {% with product=product %}
                  {% include 'components/products/merchant-badge.jinja' %}
                {% endwith %}
              {% endif %}

              {# Preorder Badge #}
              {% if has_preorder %}
                {% include 'vitrin:products/preorder_badge.jinja' %}
              {% endif %}

              {# Bundle Offer Badge #}
              {% if product.bundle_offer %}
                <span class="badge pdp-badge">{{ product.bundle_offer.name }}</span>
              {% endif %}

              {# Sold Items Badge #}
              {% set sold_count = product.sold_products_count or (product.selected_product and product.selected_product.sold_products_count) %}
              <span
                data-sold-count-badge
                class="badge pdp-badge pdp-badge--light {{ '!hidden' if not sold_count }}"
              >
                <span data-sold-count-text>{{ _("Sold more than %s times") | format(sold_count) if sold_count }}</span>
              </span>
            </div>

            {# Out-of-stock ribbon (toggled by variants.js on variant change) #}
            <span class="pdp-soldout-ribbon {{ 'hidden' if can_buy }}" data-pdp-soldout aria-hidden="{{ 'true' if can_buy else 'false' }}">{{ _('Sold out') }}</span>

            {% with product=product,gallery_id="product-gallery" %}
              {% include 'components/products/product-gallery.jinja' %}
            {% endwith %}
          </div>

          {# ── Trust badges under the gallery: per-product list, else the general list, else defaults ── #}
          {% if show_trust %}
            {% set matching_features_store = [] %}
            {% for group in settings.single_product_section_list_features_with_product_selection_store or [] %}
              {% for item in group.product_has_features_store or [] %}
                {% if item.products_store_features_shown and item.products_store_features_shown.id == product.id %}
                  {% for feature in group.list_features_store %}
                    {% set _ = matching_features_store.append({'image': feature.feat_image_store if feature.display_type_store == 'image' else '', 'icon': feature.feat_animate_icon_store if feature.display_type_store != 'image' else '', 'c1': feature.first_icon_color_store, 'c2': feature.second_icon_color_store, 'title': feature.main_text_store, 'subtitle': feature.sub_text_store}) %}
                  {% endfor %}
                {% endif %}
              {% endfor %}
            {% endfor %}
            {% if matching_features_store | length == 0 %}
              {% for badge in settings.single_product_section_trust_badges or [] %}
                {% set _ = matching_features_store.append({'image': badge.image, 'icon': '', 'title': badge.title, 'subtitle': badge.subtitle}) %}
              {% endfor %}
            {% endif %}
            {% if matching_features_store | length == 0 %}
              {% set matching_features_store = [
                {'asset': 'images/dara/pdp-trust-quality.svg', 'title': _('Guaranteed quality'), 'subtitle': _('Carefully selected pieces')},
                {'asset': 'images/dara/pdp-trust-secure.svg', 'title': _('Secure payment'), 'subtitle': _('Flexible and safe payment options')},
                {'asset': 'images/dara/pdp-trust-shipping.svg', 'title': _('Fast shipping'), 'subtitle': _('Delivered to your door')}
              ] %}
            {% endif %}
            <section class="pdp-trust Features-Grid pdp-qv-hide" aria-label="{{ _('Why shop with us') }}">
              {% for feature in matching_features_store %}
                <div class="pdp-trust__item feature-card">
                  <div class="pdp-trust__icon">
                    {% if feature.asset %}
                      <img src="{{ feature.asset | asset_url }}" alt="" width="90" height="80" loading="lazy">
                    {% elif feature.image %}
                      <img src="{{ feature.image }}" alt="{{ feature.title | default('') }}" loading="lazy">
                    {% elif feature.icon %}
                      <lord-icon
                        src="https://cdn.lordicon.com/{{ feature.icon }}.json"
                        trigger="loop"
                        delay="800"
                        colors="primary:{{ feature.c1 | default('#6B4A39', true) }},secondary:{{ feature.c2 | default('#C8AE7D', true) }}"
                        style="width: 3.5rem; height: 3.5rem;">
                      </lord-icon>
                    {% endif %}
                  </div>
                  {% if feature.title %}<p class="pdp-trust__title">{{ feature.title }}</p>{% endif %}
                  {% if feature.subtitle %}<p class="pdp-trust__subtitle">{{ feature.subtitle }}</p>{% endif %}
                </div>
              {% endfor %}
            </section>
          {% endif %}
        </div>

        {# ── Details column ── #}
        <div class="product-details-column pdp-details flex flex-col">
          <div
            id="header"
            class="pdp-header {% if details_on_top %}hidden md:block{% endif %}"
            data-show="bottom"
          >
            {% with pdp_header_where='bottom' %}
              {% include 'components/products/pdp-header.jinja' %}
            {% endwith %}
          </div>

          <hr class="pdp-divider">

          {# Live viewers counter (optional) #}
          {% if show_viewers %}
            {% set v_min = (settings.single_product_section_viewers_min | default(8, true)) | int %}
            {% set v_max = (settings.single_product_section_viewers_max | default(25, true)) | int %}
            {% if v_max < v_min %}{% set v_max = v_min %}{% endif %}
            {% set v_start = v_min + ((product.name | default('') | length) * 7) % (v_max - v_min + 1) %}
            {% set v_tpl = settings.single_product_section_viewers_text | default(_('%s people are viewing this product now'), true) %}
            {% if '%s' not in v_tpl %}{% set v_tpl = v_tpl ~ ' %s' %}{% endif %}
            <p class="pdp-viewers pdp-qv-hide" data-pdp-viewers data-min="{{ v_min }}" data-max="{{ v_max }}">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M12.5 10a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M2.05 10C3.11 6.62 6.27 4.17 10 4.17c3.73 0 6.89 2.45 7.95 5.83-1.06 3.38-4.22 5.83-7.95 5.83-3.73 0-6.89-2.45-7.95-5.83Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{{ v_tpl | replace('%s', '<b data-pdp-viewers-count>' ~ v_start ~ '</b>') | safe }}</span>
            </p>
          {% endif %}

          {# Fabric chip (optional): per-product list, else a product attribute named like the label #}
          {% if show_fabric %}
            {% set fabric_label = settings.single_product_section_fabric_label | default(_('Fabric'), true) %}
            {% set fabric_ns = namespace(value='') %}
            {% for item in settings.single_product_section_fabric_by_product or [] %}
              {% if not fabric_ns.value and item.product and item.product.id == product.id and item.fabric %}
                {% set fabric_ns.value = item.fabric %}
              {% endif %}
            {% endfor %}
            {% if not fabric_ns.value and product.attributes %}
              {% for attr in product.attributes %}
                {% if not fabric_ns.value and attr.name and (attr.name | string | lower | trim) == (fabric_label | string | lower | trim) %}
                  {% if attr.value is string %}
                    {% set fabric_ns.value = attr.value %}
                  {% elif attr.value is iterable %}
                    {% set fabric_ns.value = attr.value | join(', ') %}
                  {% endif %}
                {% endif %}
              {% endfor %}
            {% endif %}
            {% if fabric_ns.value %}
              <div class="pdp-fabric">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M17.62 10.48V6.67h-.95V4.76h-5.72V3.81h.96v-1.9h-.96V.95H7.14v.96h-.95v1.9h.95v.95H3.33v.95h10.48v3.81h.95v2.86h.95v5.71H1.43v.96h15.24v-.96h.95v-.95h.95v-.96h.96v-2.86h-.96v-2.85h-.95ZM10 3.81H8.09v-1.9H10v1.9Z" fill="#343A40"/>
                  <path d="M10.95 12.38h.96v.95h.95v-1.9h-1.91v.95Zm-.95-2.86h1.91v.96H10v-.96Zm0 3.81h1.91v.96H10v-.96Zm-.95-2.85H10v2.85h-.95v-2.85Zm-1.91 2.85h.95v.96h-.95v-.96Zm0-3.81h.95v.96h-.95v-.96Zm-.95 2.86h.95v.95h-.95v-.95Zm0-1.91h.95v.95h-.95v-.95Zm-.96-.95h-.95v4.77h.95v-1.91h.96v-.95h-.96V9.52ZM2.38 5.71h.95v3.81h-.95V5.71Zm-.95 3.81h.95v2.86h-.95V9.52ZM.48 12.38h.95v5.71H.48v-5.71Z" fill="#343A40"/>
                </svg>
                <span>{{ fabric_label }}: {{ fabric_ns.value }}</span>
              </div>
            {% endif %}
          {% endif %}

          <span
            class="pdp-meta {{ 'hidden' if not product.sku }}"
            data-product-sku-wrapper
          >
            {{ _('SKU') }} <span data-product-sku>{{ product.sku }}</span>
          </span>
          {# Weight #}
          {% set has_weight = product.selected_product and product.selected_product.weight and product.selected_product.weight.value %}
          <div
            class="{{ 'hidden' if not has_weight }} pdp-fabric"
            data-product-weight-wrapper
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M17.62 10.48V6.67h-.95V4.76h-5.72V3.81h.96v-1.9h-.96V.95H7.14v.96h-.95v1.9h.95v.95H3.33v.95h10.48v3.81h.95v2.86h.95v5.71H1.43v.96h15.24v-.96h.95v-.95h.95v-.96h.96v-2.86h-.96v-2.85h-.95ZM10 3.81H8.09v-1.9H10v1.9Z" fill="#343A40"/>
            </svg>
            <span>{{ _("Weight") }}:</span>
            <span data-product-weight>
              {% if has_weight %}
                {{ product.selected_product.weight.value }}
                {{ product.selected_product.weight.unit }}
              {% endif %}
            </span>
          </div>

          {# ── Look details ("تفاصيل الإطلالة"): per-product features list (optional) ── #}
          {% if show_look_details and settings.single_product_section_list_features_with_product_selection and settings.single_product_section_list_features_with_product_selection|length > 0 %}
            {% set matching_features = [] %}
            {% for group in settings.single_product_section_list_features_with_product_selection %}
              {% for item in group.product_has_features or [] %}
                {% if item.war_products and item.war_products.id == product.id %}
                  {% for feature in group.list_features %}
                    {% set _ = matching_features.append(feature) %}
                  {% endfor %}
                {% endif %}
              {% endfor %}
            {% endfor %}

            {% if matching_features|length > 0 %}
              {% set f_icon = settings.single_product_section_features_icon_size | default(56, true) %}
              <section
                class="pdp-look"
                style="
                  background-color: {{ settings.single_product_section_features_section_background | default('#F9B75724', true) }};
                  border-radius: {{ settings.single_product_section_features_section_radius | default(0) }}px;
                "
              >
                <h2
                  class="pdp-look__title"
                  style="
                    color: {{ settings.single_product_section_head_title_color | default('#000000', true) }};
                    font-size: {{ settings.single_product_section_features_title_font_size | default(14, true) }}px;
                  "
                >
                  {{ settings.single_product_section_head_title_feature | default(_('Look details'), true) }}
                </h2>
                {% set visible_features = matching_features[:4] %}
                <div
                  class="pdp-look__grid {{ 'pdp-look__grid--' ~ (visible_features | length) }}"
                  style="gap: {{ settings.single_product_section_features_items_gap | default(24, true) }}px;"
                >
                  {% for feature in visible_features %}
                    <div class="pdp-look__item feature-card">
                      <div class="pdp-look__media" style="width: {{ f_icon }}px; height: {{ f_icon }}px;">
                        {% if feature.display_type == 'image' %}
                          {% if feature.feat_image %}
                            <img src="{{ feature.feat_image }}" alt="{{ feature.main_text | default('') }}" loading="lazy">
                          {% endif %}
                        {% elif feature.feat_animate_icon %}
                          <lord-icon
                            src="https://cdn.lordicon.com/{{ feature.feat_animate_icon }}.json"
                            trigger="loop"
                            delay="800"
                            colors="primary:{{ feature.first_icon_color | default('#6B4A39', true) }},secondary:{{ feature.second_icon_color | default('#C8AE7D', true) }}"
                            style="width: {{ f_icon }}px; height: {{ f_icon }}px;"
                          ></lord-icon>
                        {% endif %}
                      </div>
                      {% if feature.main_text %}
                        <p
                          class="pdp-look__label"
                          style="color: {{ feature.main_text_color | default('#404040', true) }}; font-size: {{ settings.single_product_section_features_text_font_size | default(16, true) }}px;"
                        >{{ feature.main_text }}</p>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              </section>
            {% endif %}
          {% endif %}

          {# ── Story & texture scales (optional). Titles + every label are editable settings ── #}
          {% if show_story_texture and settings.single_product_section_coffee_attributes_selection and settings.single_product_section_coffee_attributes_selection|length > 0 %}
            {% set matching_attributes = [] %}
            {% for group in settings.single_product_section_coffee_attributes_selection %}
              {% for item in group.products_with_attributes or [] %}
                {% if item.selected_products and item.selected_products.id == product.id %}
                  {% for attribute in group.coffee_attributes_list %}
                    {% set _A = matching_attributes.append(attribute) %}
                  {% endfor %}
                {% endif %}
              {% endfor %}
            {% endfor %}

            {% if matching_attributes|length > 0 %}
              {% set scales = [
                {
                  'key': 'acidity_level',
                  'title': settings.single_product_section_coffee_acidity_level | default(_('Cut width'), true),
                  'labels': [
                    settings.single_product_section_story_label_low | default(_('Fitted'), true),
                    settings.single_product_section_story_label_mid | default(_('Relaxed'), true),
                    settings.single_product_section_story_label_high | default(_('Long'), true)
                  ]
                },
                {
                  'key': 'body_level',
                  'title': settings.single_product_section_coffee_body_level | default(_('Fabric feel'), true),
                  'labels': [
                    settings.single_product_section_texture_label_low | default(_('Soft'), true),
                    settings.single_product_section_texture_label_mid | default(_('Flowing'), true),
                    settings.single_product_section_texture_label_high | default(_('Loose'), true)
                  ]
                }
              ] %}
              <section class="pdp-scales">
                {% for attribute in matching_attributes %}
                  {% for scale in scales %}
                    {% set raw = (attribute[scale.key] | default(0, true)) | float %}
                    {% set pct = (raw * 10) if raw <= 10 else raw %}
                    {% if pct > 100 %}{% set pct = 100 %}{% endif %}
                    {% if pct < 0 %}{% set pct = 0 %}{% endif %}
                    <div class="pdp-scale">
                      <p class="pdp-scale__title">{{ scale.title }}</p>
                      <div class="pdp-scale__track" role="img" aria-label="{{ scale.title }}: {{ raw | round(0) | int }}/10">
                        <span class="pdp-scale__knob" style="inset-inline-start: {{ pct }}%;">
                          <svg width="18" height="18" viewBox="0 0 16.5 16.5" fill="none" aria-hidden="true">
                            <path d="M2.29 14.22c1.21 1.2 3 1.73 4.97 1.47 1.97-.26 3.97-1.3 5.55-2.88 1.58-1.58 2.62-3.58 2.88-5.55.26-1.97-.27-3.76-1.47-4.97C13 1.08 11.22.55 9.25.82 7.28 1.08 5.28 2.12 3.7 3.7 2.12 5.28 1.08 7.28.82 9.25c-.27 1.97.26 3.76 1.47 4.97Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M14.1 2.4c.15 7.35-11.85 4.35-11.7 11.7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      </div>
                      <div class="pdp-scale__labels">
                        {% for label in scale.labels %}<span>{{ label }}</span>{% endfor %}
                      </div>
                    </div>
                  {% endfor %}
                {% endfor %}
              </section>
              <hr class="pdp-divider">
            {% endif %}
          {% endif %}

          {# Short Description #}
          {% if product.short_description %}
            <div class="prose prose-sm max-w-none pdp-short-desc">{{ product.short_description|safe }}</div>
          {% endif %}

          <form
            id="product-form"
            class="pdp-form"
          >
            <input
              type="hidden"
              name="product_id"
              id="product-id"
              value="{{ product.selected_product.id }}"
            />

            {# Custom Input Fields #}
            {% with product=product %}
              {% include 'components/products/custom-input-fields.jinja' %}
            {% endwith %}
            {# Product Options (if available) #}
            {% if product.has_options or product.has_fields %}
              {% if settings.single_product_section_size_chart_url %}
                <a href="{{ settings.single_product_section_size_chart_url }}" class="pdp-size-chart" target="_blank" rel="noopener">{{ settings.single_product_section_size_chart_text | default(_('Size chart'), true) }}</a>
              {% endif %}
              {% with options=product.options, product=product, style='list' %}
                {% include 'components/products/product-options.jinja' %}
              {% endwith %}
            {% endif %}

            {# Low stock line (optional). Text is refreshed by variants.js on variant change #}
            {% if show_low_stock %}
              <p
                data-low-stock-badge
                data-template="{{ _('Only %s pieces left in stock!') }}"
                class="pdp-low-stock {{ 'hidden' if not product.low_stock_quantity }}"
              >
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M5.56 6.36c-.09.95-.15 2.63.41 3.35 0 0-.26-1.85 2.1-4.16.95-.94 1.17-2.2.84-3.16-.19-.54-.53-.98-.83-1.29-.18-.18-.04-.48.21-.47 1.54.07 4.04.5 5.1 3.16.47 1.17.5 2.38.28 3.6-.14.79-.64 2.53.5 2.74.81.16 1.21-.49 1.38-.96.07-.19.33-.24.47-.08 1.37 1.56 1.49 3.4 1.2 4.99-.55 3.06-3.65 5.3-6.74 5.3-3.85 0-6.92-2.21-7.71-6.2-.32-1.61-.16-4.8 2.32-7.05.19-.17.49-.02.47.23Z" fill="#FF7A00"/>
                  <path d="M11.89 12.1c-1.42-1.83-.78-3.92-.43-4.75.04-.11-.08-.21-.18-.15-.61.42-1.86 1.4-2.45 2.77-.79 1.86-.73 2.77-.26 3.89.28.67-.05.81-.21.84-.16.02-.31-.08-.42-.19a2.5 2.5 0 0 1-.7-1.19c-.02-.1-.15-.12-.21-.04-.43.6-.66 1.57-.67 2.26-.04 2.12 1.72 3.84 3.84 3.84 2.67 0 4.61-2.95 3.08-5.42-.45-.72-.86-1.19-1.39-1.86Z" fill="#FFE07A"/>
                </svg>
                <span data-low-stock-text>{{ _('Only %s pieces left in stock!') | format(product.low_stock_quantity) if product.low_stock_quantity }}</span>
              </p>
            {% else %}
              <span data-low-stock-badge class="!hidden" hidden><span data-low-stock-text></span></span>
            {% endif %}

            {# Quantity Input #}
            <div
              class="{{ 'hidden' if not is_in_stock }} pdp-qty"
              data-quantity-wrapper
            >
              <label for="product-quantity" class="sr-only">{{ _('Quantity') }}</label>
              {% with id='product-quantity', quantity=1, min=1, max=product.quantity if not product.is_infinite and product.quantity and product.quantity > 0 else (1 if can_preorder else none), sync_target='sticky-qty' %}
                {% include 'components/ui/quantity-input.jinja' %}
              {% endwith %}
