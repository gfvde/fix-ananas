  {% set matching_features = [] %}
  {% for group in settings.single_product_section_list_features_with_product_selection %}
    {% for item in group.product_has_features %}
      {% if item.war_products.id == product.id %}
        {% for feature in group.list_features %}
          {% set _ = matching_features.append(feature) %}
        {% endfor %}
      {% endif %}
    {% endfor %}
  {% endfor %}

    {% if matching_features|length > 0 %}
        <section class="mt-2">
          <div
            class="py-2 px-4"
            style="
              background-color: {{ settings.single_product_section_features_section_background | default('#F9B75724') }};
              border-radius: {{ settings.single_product_section_features_section_radius | default(16) }}px;
            "
          >

            {# Section Title #}
            <div class="mb-2">
              <h2
                class="font-medium leading-5 tracking-normal"
                style="
                  color: {{ settings.single_product_section_head_title_color | default('#000000') }};
                  font-size: {{ settings.single_product_section_features_title_font_size | default(16) }}px;
                "
              >
                {{ settings.single_product_section_head_title_feature | default('مزيج نكهات فريد') }}
              </h2>
            </div>

            {# Features Grid #}
            {% set visible_features = matching_features[:4] %}
            {% set feat_count = visible_features | length %}
            {% if feat_count == 1 %}
              {% set grid_cols = "grid-cols-1" %}
            {% elif feat_count == 2 %}
              {% set grid_cols = "grid-cols-2" %}
            {% elif feat_count == 3 %}
              {% set grid_cols = "grid-cols-3" %}
            {% else %}
              {% set grid_cols = "grid-cols-2 md:grid-cols-4" %}
            {% endif %}
            <div
              class="grid {{ grid_cols }} justify-items-center"
              style="
                gap: {{ settings.single_product_section_features_items_gap | default(24) }}px;
              "
            >
              {% for feature in matching_features %}
              {% if loop.index0 >= 4 %}{% continue %}{% endif %}
                <div class="feature-card rounded-lg transition-all duration-300">

                  {# Icon Container #}
                  <div class="flex justify-center mb-4">
                    <div
                      class="flex items-center justify-center rounded-full transition-transform duration-300 hover:scale-110"
                      style="
                        width: {{ settings.single_product_section_features_icon_size | default(56) }}px;
                        height: {{ settings.single_product_section_features_icon_size | default(56) }}px;
                      "
                    >

