{% extends "layout.jinja" %}

{% set brand_name = ((brand.display_name or brand.name) if brand is defined and brand else '') | default('', true) %}

{% block title %}{{ store.name }} – {{ brand_name }}{% endblock %}

{% block content %}
  {% set product_list = products.results if products is defined and products and products.results else [] %}
  {% set product_count = products.count if products is defined and products and products.count is not none else product_list | length %}

  {# Brands index URL: Growth uses url_for('list_brands'); docs say brands are not
     supported by url_for, so fall back to the hardcoded route. #}
  {% set brands_url = url_for('list_brands') if url_for is defined else none %}
  {% set brands_url = brands_url or '/brands' %}

  {# Breadcrumb #}
  <section class="pc-breadcrumb-section px-4 py-6 md:px-16">
    <div class="theme-container">
      {%
        with
        items=[
          {'href': url_for('home'), 'label': _("Home")},
          {'href': brands_url, 'label': _("Brands")},
          {'label': brand_name | e}
        ]
      %}
        {% include 'components/ui/breadcrumb.jinja' %}
      {% endwith %}
    </div>
  </section>

  {# Brand header #}
  <section class="px-4 pb-4 md:px-16 md:pb-6">
    <div class="theme-container">
      <div class="flex flex-col items-center gap-4 text-center md:flex-row md:text-start">
        {% if brand.logo %}
          <div class="bg-secondary flex size-20 shrink-0 items-center justify-center overflow-hidden rounded md:size-24">
            <img
              src="{{ image_url(brand.logo, w=200, q=80, f='auto') }}"
              alt="{{ brand_name }}"
              class="h-full w-full object-contain p-2"
              onerror="this.style.display='none'"
            />
          </div>
        {% endif %}
        <div class="flex flex-col gap-2">
          <h1 class="text-foreground text-xl md:text-2xl font-semibold tracking-tight">
            {{ brand_name }}
            {% if product_count %}
              <span class="text-muted text-base font-normal">
                ({%- if product_count == 1 %}{{ _("1 product") }}{% else %}{{ _("%(count)s products") % {'count': product_count} }}{% endif -%})
              </span>
            {% endif %}
          </h1>
          {% if brand.description %}
            <p class="text-muted text-sm max-w-[720px]">{{ brand.description | striptags }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {# Products #}
  <section class="plp-section px-4 pb-8 md:px-16 md:pb-16">
    <div class="theme-container">
      {% with empty_state='brand' %}
        {% include 'components/products/products-listing.jinja' %}
      {% endwith %}
    </div>
  </section>

  {# Quick View Modal is included globally in layout.jinja #}

  <script>
    (function () {
      // Track grid mode separately for desktop and mobile
      let desktopGridMode = "four";
      let mobileGridMode = "{{ card_columns_mobile | default('1') }}" === "1" ? "one" : "four";

      function isMobile() {
        return window.matchMedia("(max-width: 767px)").matches;
      }

      function getCurrentMode() {
        return isMobile() ? mobileGridMode : desktopGridMode;
      }

      function initGridControls() {
        const gridRoot = document.querySelector("[data-grid-root]");

        if (!gridRoot) return;

        // Apply current mode to grid root
        gridRoot.setAttribute("data-grid", getCurrentMode());

        // Update button checked states
        const allButtons = document.querySelectorAll("[data-grid-btn]");
        allButtons.forEach((btn) => {
          const mode = btn.dataset.gridBtn;
          const isDesktopBtn = mode === "four";
          const isMobileBtn = mode === "one";
          const isListBtn = mode === "list";

          let shouldCheck = false;
          if (isDesktopBtn) {
            shouldCheck = mode === desktopGridMode;
          } else if (isMobileBtn) {
            shouldCheck = mobileGridMode === "one";
          } else if (isListBtn) {
            // List button appears on both - check based on current context
            shouldCheck = (isMobile() && mobileGridMode === "list") || (!isMobile() && desktopGridMode === "list");
          }

          btn.checked = shouldCheck;
        });
      }

      function setGrid(mode) {
        const gridRoot = document.querySelector("[data-grid-root]");

        // Update the appropriate mode based on button type
        if (mode === "one") {
          mobileGridMode = mode;
        } else if (mode === "four") {
          desktopGridMode = mode;
        } else if (mode === "list") {
          // List mode updates based on current viewport
          if (isMobile()) {
            mobileGridMode = mode;
          } else {
            desktopGridMode = mode;
          }
        }

        if (gridRoot) {
          gridRoot.setAttribute("data-grid", mode);
        }

        // Update all button states
        initGridControls();
      }

      // Event delegation for grid buttons (works after AJAX swap)
      document.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-grid-btn]");
        if (btn) {
          setGrid(btn.dataset.gridBtn);
        }
      });

      // Handle viewport changes
      const mediaQuery = window.matchMedia("(max-width: 767px)");
      mediaQuery.addEventListener("change", () => {
        const gridRoot = document.querySelector("[data-grid-root]");
        if (gridRoot) {
          gridRoot.setAttribute("data-grid", getCurrentMode());
        }
        initGridControls();
      });

      // Re-initialize after AJAX swap
      window.addEventListener("products-updated", initGridControls);

      // Initial setup
      initGridControls();
    })();
  </script>
{% endblock %}
